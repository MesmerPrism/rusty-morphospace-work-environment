  "non_scope": [
    "Application visual changes.",
    "Platform, packaging, permission, and device work.",
    "Unrelated modules."
  ],
  "acceptance": [
    {
      "acceptance_id": "contract-fixtures",
      "proof": "Valid and damaged fixtures produce the documented outcomes.",
      "command": "<contract-fixture-command>"
    },
    {
      "acceptance_id": "inactive-baseline",
      "proof": "Removing the feature-lock entry leaves the module inert.",
      "command": "<inactive-baseline-command>"
