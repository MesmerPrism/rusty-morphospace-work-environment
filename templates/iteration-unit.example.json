    },
    {
      "resource_kind": "build-output",
      "resource_id": "<content-addressed-output-path>",
      "mode": "exclusive",
      "claim_timing": "before-write"
    }
  ],
  "claim_requirements": {
    "minimum_free_disk_mib": 1024,
    "required_tools": [
      {
        "tool_id": "git",
        "executable": "git",
        "purpose": "Observe and bind exact source commits and trees."
      },
      {
        "tool_id": "pwsh",
        "executable": "pwsh",
        "purpose": "Run portable workflow and validation entrypoints."
      }
    ],
    "product_inputs": [],
    "execution_preflight": {
      "observation": {
        "repo_id": "project-shell",
        "path": "morphospace/receipts/unit-example-001-execution-preflight.json",
        "expected_sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "assertions": [
        {
          "assertion_id": "source-lock-match",
