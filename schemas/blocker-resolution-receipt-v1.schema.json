{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/blocker-resolution-receipt-v1.schema.json",
  "title": "Generic blocker resolution evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","receipt_id","project_id","unit_id","blocker","result","evidence","repository_heads","repository_sources","preserve_blocker_ids"],
  "properties": {
    "schema": {"const":"rusty.morphospace.workflow.blocker_resolution_receipt.v1"},
    "receipt_id": {"$ref":"#/$defs/id"},
    "project_id": {"$ref":"#/$defs/id"},
    "unit_id": {"$ref":"#/$defs/id"},
    "blocker": {
      "type":"object","additionalProperties":false,
      "required":["blocker_id","condition","resume_when"],
      "properties":{
        "blocker_id":{"$ref":"#/$defs/id"},
        "condition":{"type":"string","minLength":1},
        "resume_when":{"type":"string","minLength":1}
      }
    },
    "result": {"const":"pass"},
    "evidence": {
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["path","sha256"],
        "properties":{"path":{"$ref":"#/$defs/path"},"sha256":{"$ref":"#/$defs/hash"}}
      }
    },
    "repository_heads": {
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["repo_id","branch","revision"],
        "properties":{"repo_id":{"$ref":"#/$defs/id"},"branch":{"type":"string","minLength":1},"revision":{"$ref":"#/$defs/revision"}}
      }
    },
    "repository_sources": {
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["repo_id","sources"],
        "properties":{
          "repo_id":{"$ref":"#/$defs/id"},
          "sources":{
            "type":"array","minItems":1,
            "items":{
              "type":"object","additionalProperties":false,
              "required":["path","sha256"],
              "properties":{"path":{"$ref":"#/$defs/repoPath"},"sha256":{"$ref":"#/$defs/hash"}}
            }
          }
        }
      }
    },
    "preserve_blocker_ids": {
      "type":"array","uniqueItems":true,
      "items":{"$ref":"#/$defs/id"}
    }
  },
  "$defs": {
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{1,127}$"},
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "path":{"type":"string","pattern":"^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "repoPath":{"type":"string","pattern":"^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.{1,2}|)(?:/|$))(?!.*//)(?!.*[/]$)[A-Za-z0-9._/-]+$"}
  }
}
