{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/resource-claim.schema.json",
  "title": "Cross-project local resource claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "claim_id", "project_id", "unit_id", "resource_kind", "resource_id", "mode", "acquired_at", "expires_at", "released_at", "status"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.resource_claim.v1" },
    "claim_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "resource_kind": { "enum": ["repo-path", "build-output", "android-package", "headset", "property-namespace", "staging-namespace", "bridge-port"] },
    "resource_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["exclusive", "shared-read"] },
    "acquired_at": { "$ref": "#/$defs/utc" },
    "expires_at": { "$ref": "#/$defs/utc" },
    "released_at": { "oneOf": [{ "$ref": "#/$defs/utc" }, { "type": "null" }] },
    "status": { "enum": ["active", "released"] }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,191}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" }
  }
}
