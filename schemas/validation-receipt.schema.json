{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/validation-receipt.schema.json",
  "title": "Rusty Morphospace validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "project_id",
    "unit_id",
    "created_at",
    "tier",
    "result",
    "repository_revisions",
    "changed_paths",
    "artifacts",
    "criteria",
    "gates",
    "device_validation"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "rusty.morphospace.workflow.validation_receipt.v1" },
    "receipt_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time" },
    "tier": { "enum": ["quick", "standard", "deep"] },
    "result": { "enum": ["pass", "partial", "fail", "blocked"] },
    "historical_validation_debt": { "$ref": "#/$defs/historicalValidationDebtBinding" },
    "history_archive_validation": { "$ref": "#/$defs/historyArchiveValidationBinding" },
    "repository_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo_id", "base_revision", "head_revision", "branch"],
        "properties": {
          "repo_id": { "$ref": "#/$defs/id" },
          "base_revision": { "$ref": "#/$defs/sha" },
          "head_revision": { "$ref": "#/$defs/sha" },
          "branch": { "type": ["string", "null"] }
        }
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo_id", "path"],
        "properties": {
          "repo_id": { "$ref": "#/$defs/id" },
          "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "path", "sha256"],
        "properties": {
          "artifact_id": { "$ref": "#/$defs/id" },
          "kind": { "$ref": "#/$defs/id" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptance_id", "status", "command", "evidence_refs"],
        "properties": {
          "acceptance_id": { "$ref": "#/$defs/id" },
          "status": { "enum": ["pass", "fail", "blocked"] },
          "command": { "type": "string", "minLength": 1 },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "command", "evidence_refs"],
        "properties": {
          "gate_id": { "$ref": "#/$defs/id" },
          "status": { "enum": ["pass", "fail", "blocked"] },
          "command": { "type": "string", "minLength": 1 },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "device_validation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["serials", "cleanup_complete", "package_fatal_count", "system_fatal_count", "evidence_refs"],
          "properties": {
            "serials": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "cleanup_complete": { "type": "boolean" },
            "package_fatal_count": { "type": "integer", "minimum": 0 },
            "system_fatal_count": { "type": "integer", "minimum": 0 },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "historicalDebtReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": {
        "role": {
          "enum": [
            "historical-validation-debt-baseline",
            "historical-validation-debt-authorization",
            "historical-validation-debt-result"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^receipts/historical-validation-debt/[a-z0-9][a-z0-9-]{7,127}/(?:baseline|authorization)\\.json$|^receipts/historical-validation-debt/[a-z0-9][a-z0-9-]{7,127}/results/[0-9a-f]{64}\\.json$"
        },
        "schema": { "type": "string", "pattern": "^rusty\\.morphospace\\.workflow\\.historical_validation_debt_[a-z0-9_]+\\.v1$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "historicalValidationDebtBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "authorization", "result"],
      "properties": {
        "baseline": {
          "allOf": [
            { "$ref": "#/$defs/historicalDebtReference" },
            { "properties": { "role": { "const": "historical-validation-debt-baseline" }, "schema": { "const": "rusty.morphospace.workflow.historical_validation_debt_baseline.v1" } } }
          ]
        },
        "authorization": {
          "allOf": [
            { "$ref": "#/$defs/historicalDebtReference" },
            { "properties": { "role": { "const": "historical-validation-debt-authorization" }, "schema": { "const": "rusty.morphospace.workflow.historical_validation_debt_baseline_authorization.v1" } } }
          ]
        },
        "result": {
          "allOf": [
            { "$ref": "#/$defs/historicalDebtReference" },
            { "properties": { "role": { "const": "historical-validation-debt-result" }, "schema": { "const": "rusty.morphospace.workflow.historical_validation_debt_result.v1" } } }
          ]
        }
      }
    },
    "historyArchiveValidationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "result"],
      "properties": {
        "root": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256", "schema"],
          "properties": {
            "path": { "type": "string", "pattern": "^history-archive/roots/[0-9a-f]{64}\\.json$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "schema": { "const": "rusty.morphospace.workflow.history_archive_root.v1" }
          }
        },
        "result": {
          "type": "object", "additionalProperties": false,
          "required": ["schema", "validation_id", "project_id", "tier", "mode", "status", "checkpoint", "source_prefix", "carry_forward", "reason_codes", "does_not_prove"],
          "properties": {
            "schema": { "const": "rusty.morphospace.workflow.history_archive_validation_result.v1" },
            "validation_id": { "$ref": "#/$defs/id" }, "project_id": { "$ref": "#/$defs/id" },
            "tier": { "enum": ["quick", "deep", "audit", "migration"] },
            "mode": { "enum": ["tail-only", "archive-replay-required", "archive-replay"] },
            "status": { "enum": ["pass", "replay-required", "fail"] },
            "checkpoint": { "type": "object", "additionalProperties": false, "required": ["checkpoint_id", "root_path", "root_sha256"], "properties": { "checkpoint_id": { "$ref": "#/$defs/id" }, "root_path": { "type": "string", "pattern": "^history-archive/roots/[0-9a-f]{64}\\.json$" }, "root_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
            "source_prefix": { "type": "object", "additionalProperties": false, "required": ["matches", "byte_length", "sha256"], "properties": { "matches": { "type": "boolean" }, "byte_length": { "type": "integer", "minimum": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
            "carry_forward": { "type": "object", "additionalProperties": false, "required": ["complete", "checked_paths"], "properties": { "complete": { "type": "boolean" }, "checked_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } },
            "reason_codes": { "type": "array", "uniqueItems": true, "items": { "enum": ["none", "missing-checkpoint", "incomplete-transaction", "unregistered-checkpoint", "root-tamper", "object-tamper", "source-prefix-drift", "unknown-precheckpoint-reference", "carry-forward-drift", "archive-event-missing", "archive-event-tamper", "archive-receipt-tamper", "archive-receipt-document-tamper", "archive-event-reference-tamper", "archive-tail-drift", "state-tail-drift", "archive-replay-selected"] } },
            "does_not_prove": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
