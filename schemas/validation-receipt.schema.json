{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/validation-receipt.schema.json",
  "title": "Rusty Morphospace validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "project_id",
    "unit_id",
    "created_at",
    "tier",
    "result",
    "repository_revisions",
    "changed_paths",
    "artifacts",
    "criteria",
    "gates",
    "device_validation"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "rusty.morphospace.workflow.validation_receipt.v1" },
    "receipt_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time" },
    "tier": { "enum": ["quick", "standard", "deep"] },
    "result": { "enum": ["pass", "partial", "fail", "blocked"] },
    "historical_validation_debt": { "$ref": "#/$defs/historicalValidationDebtBinding" },
    "repository_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo_id", "base_revision", "head_revision", "branch"],
        "properties": {
          "repo_id": { "$ref": "#/$defs/id" },
          "base_revision": { "$ref": "#/$defs/sha" },
          "head_revision": { "$ref": "#/$defs/sha" },
          "branch": { "type": ["string", "null"] }
        }
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo_id", "path"],
        "properties": {
          "repo_id": { "$ref": "#/$defs/id" },
          "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "path", "sha256"],
        "properties": {
          "artifact_id": { "$ref": "#/$defs/id" },
          "kind": { "$ref": "#/$defs/id" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptance_id", "status", "command", "evidence_refs"],
        "properties": {
          "acceptance_id": { "$ref": "#/$defs/id" },
          "status": { "enum": ["pass", "fail", "blocked"] },
          "command": { "type": "string", "minLength": 1 },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "command", "evidence_refs"],
        "properties": {
          "gate_id": { "$ref": "#/$defs/id" },
          "status": { "enum": ["pass", "fail", "blocked"] },
          "command": { "type": "string", "minLength": 1 },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "device_validation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["serials", "cleanup_complete", "package_fatal_count", "system_fatal_count", "evidence_refs"],
          "properties": {
            "serials": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "cleanup_complete": { "type": "boolean" },
            "package_fatal_count": { "type": "integer", "minimum": 0 },
            "system_fatal_count": { "type": "integer", "minimum": 0 },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "historicalDebtReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": {
        "role": {
          "enum": [
            "historical-validation-debt-baseline",
            "historical-validation-debt-authorization",
            "historical-validation-debt-result"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^receipts/historical-validation-debt/[a-z0-9][a-z0-9-]{7,127}/(?:baseline|authorization)\\.json$|^receipts/historical-validation-debt/[a-z0-9][a-z0-9-]{7,127}/results/[0-9a-f]{64}\\.json$"
        },
        "schema": { "type": "string", "pattern": "^rusty\\.morphospace\\.workflow\\.historical_validation_debt_[a-z0-9_]+\\.v1$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "historicalValidationDebtBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "authorization", "result"],
      "properties": {
        "baseline": {
          "allOf": [
            { "$ref": "#/$defs/historicalDebtReference" },
            { "properties": { "role": { "const": "historical-validation-debt-baseline" }, "schema": { "const": "rusty.morphospace.workflow.historical_validation_debt_baseline.v1" } } }
          ]
        },
        "authorization": {
          "allOf": [
            { "$ref": "#/$defs/historicalDebtReference" },
            { "properties": { "role": { "const": "historical-validation-debt-authorization" }, "schema": { "const": "rusty.morphospace.workflow.historical_validation_debt_baseline_authorization.v1" } } }
          ]
        },
        "result": {
          "allOf": [
            { "$ref": "#/$defs/historicalDebtReference" },
            { "properties": { "role": { "const": "historical-validation-debt-result" }, "schema": { "const": "rusty.morphospace.workflow.historical_validation_debt_result.v1" } } }
          ]
        }
      }
    }
  }
}
