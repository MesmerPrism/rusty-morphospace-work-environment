{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/validation-receipt-v2.schema.json",
  "title": "Automation-derived current-unit validation receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "receipt_id", "created_at", "project_id", "unit_id", "attempt_id",
    "action", "evidence", "execution", "current_protocol", "ownership", "registry", "profile_id",
    "result", "criteria", "validators", "observations", "device_validation", "status"
  ],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.validation_receipt.v2" },
    "receipt_id": { "$ref": "#/$defs/id" },
    "created_at": { "$ref": "#/$defs/utc" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "attempt_id": { "$ref": "#/$defs/id" },
    "action": { "$ref": "#/$defs/actionReference" },
    "evidence": { "$ref": "#/$defs/evidenceReference" },
    "execution": { "$ref": "#/$defs/executionReference" },
    "current_protocol": { "$ref": "#/$defs/currentProtocolReference" },
    "ownership": { "$ref": "#/$defs/ownershipReference" },
    "registry": { "$ref": "#/$defs/registryReference" },
    "profile_id": { "$ref": "#/$defs/id" },
    "result": { "enum": ["pass", "fail", "blocked"] },
    "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } },
    "validators": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "observations": { "$ref": "#/$defs/observations" },
    "device_validation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/deviceValidation" }
      ]
    },
    "status": { "const": "accepted-evidence" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,191}$" },
    "dottedId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,191}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "typedReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 1 }, "schema": { "$ref": "#/$defs/dottedId" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "actionReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "const": "validation-action" }, "path": { "type": "string", "minLength": 1 }, "schema": { "const": "rusty.morphospace.workflow.validation_action.v2" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "evidenceReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "const": "validation-evidence" }, "path": { "type": "string", "minLength": 1 }, "schema": { "const": "rusty.morphospace.workflow.validation_evidence.v2" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "executionReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "const": "validation-execution" }, "path": { "type": "string", "minLength": 1 }, "schema": { "const": "rusty.morphospace.workflow.validation_execution.v1" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "currentProtocolReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "const": "current-unit-protocol" }, "path": { "type": "string", "minLength": 1 }, "schema": { "const": "rusty.morphospace.workflow.current_unit_protocol.v1" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "ownershipReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "const": "unit-ownership" }, "path": { "type": "string", "minLength": 1 }, "schema": { "const": "rusty.morphospace.workflow.unit_ownership.v1" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "registryReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "const": "owner-validator-registry" }, "path": { "type": "string", "minLength": 1 }, "schema": { "const": "rusty.morphospace.workflow.owner_validator_registry.v1" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["acceptance_id", "status", "validator_id", "evidence_ref"],
      "properties": {
        "acceptance_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["pass", "fail", "blocked"] },
        "validator_id": { "$ref": "#/$defs/id" },
        "evidence_ref": { "$ref": "#/$defs/typedReference" }
      }
    },
    "deviceCriterion": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "status", "evidence_ref"],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["pass", "fail", "blocked"] },
        "evidence_ref": { "$ref": "#/$defs/typedReference" }
      }
    },
    "deviceValidation": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "result", "evidence", "criteria"],
      "properties": {
        "policy_id": { "$ref": "#/$defs/id" },
        "result": { "enum": ["pass", "fail", "blocked"] },
        "evidence": { "$ref": "#/$defs/typedReference" },
        "criteria": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/deviceCriterion" }
        }
      }
    },
    "observations": {
      "type": "object", "additionalProperties": false,
      "required": ["before_sha256", "after_sha256", "allowed_delta_sha256"],
      "properties": { "before_sha256": { "$ref": "#/$defs/hash" }, "after_sha256": { "$ref": "#/$defs/hash" }, "allowed_delta_sha256": { "$ref": "#/$defs/hash" } }
    }
  }
}
