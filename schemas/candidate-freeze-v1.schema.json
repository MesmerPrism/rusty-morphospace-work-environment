{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/candidate-freeze-v1.schema.json",
  "title": "Immutable development candidate closure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "freeze_id", "project_id", "unit_id", "expected", "final_repositories", "changed_paths", "cleanliness_policy", "instruction_surfaces", "feature_lock", "effects", "permissions", "device_use", "test_matrix", "cleanup_evidence", "source_composition", "does_not_prove"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.candidate_freeze.v1" }, "freeze_id": { "$ref": "#/$defs/id" }, "project_id": { "$ref": "#/$defs/id" }, "unit_id": { "$ref": "#/$defs/id" },
    "expected": { "type": "object", "additionalProperties": false, "required": ["project_sha256", "state_sha256", "unit_sha256", "feature_lock_sha256", "source_composition_path", "source_composition_sha256", "repository_map_path", "repository_map_sha256", "events_sha256", "events_length", "event_tail_id"], "properties": { "project_sha256": { "$ref": "#/$defs/hash" }, "state_sha256": { "$ref": "#/$defs/hash" }, "unit_sha256": { "$ref": "#/$defs/hash" }, "feature_lock_sha256": { "$ref": "#/$defs/hash" }, "source_composition_path": { "$ref": "#/$defs/path" }, "source_composition_sha256": { "$ref": "#/$defs/hash" }, "repository_map_path": { "$ref": "#/$defs/path" }, "repository_map_sha256": { "$ref": "#/$defs/hash" }, "events_sha256": { "$ref": "#/$defs/hash" }, "events_length": { "type": "integer", "minimum": 1 }, "event_tail_id": { "$ref": "#/$defs/id" } } },
    "final_repositories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["repo_id", "commit", "tree"], "properties": { "repo_id": { "$ref": "#/$defs/id" }, "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" } } } },
    "changed_paths": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["repo_id", "paths"], "properties": { "repo_id": { "$ref": "#/$defs/id" }, "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } } } } },
    "cleanliness_policy": { "enum": ["clean-only", "declared-dirty-paths"] }, "instruction_surfaces": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "disposition"], "properties": { "path": { "type": "string", "minLength": 1 }, "disposition": { "enum": ["updated", "reviewed-no-change", "not-applicable"] } } } }, "feature_lock": { "type": "object", "additionalProperties": false, "required": ["revision", "sha256"], "properties": { "revision": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/hash" } } },
    "effects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "permissions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "device_use": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "test_matrix": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["test_id", "command"], "properties": { "test_id": { "$ref": "#/$defs/id" }, "command": { "type": "string", "minLength": 1 } } } }, "cleanup_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "source_composition": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/hash" } } }, "does_not_prove": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" }, "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*/?$" } }
}
