{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/historical-unit-adoption-receipt.schema.json",
  "title": "Hash-bound adoption of immutable historical iteration units",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "project_id", "source_workflow", "units"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "rusty.morphospace.workflow.historical_unit_adoption_receipt.v1" },
    "receipt_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "source_workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["release", "commit"],
      "properties": { "release": { "type": "string", "minLength": 1 }, "commit": { "$ref": "#/$defs/sha" } }
    },
    "units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["unit_id", "unit_path", "unit_sha256", "terminal_status", "terminal_evidence", "normalization"],
        "properties": {
          "unit_id": { "$ref": "#/$defs/id" },
          "unit_path": { "type": "string", "pattern": "^iteration-units/[a-z0-9][a-z0-9-]{1,127}\\.json$" },
          "unit_sha256": { "$ref": "#/$defs/hash" },
          "terminal_status": { "enum": ["accepted", "blocked"] },
          "terminal_evidence": {
            "type": "object", "additionalProperties": false,
            "required": ["event_id", "receipt_path"],
            "properties": {
              "event_id": { "$ref": "#/$defs/id" },
              "event_sha256": { "$ref": "#/$defs/hash" },
              "receipt_path": { "type": ["string", "null"] },
              "receipt_sha256": { "$ref": "#/$defs/hash" }
            }
          },
          "normalization": {
            "type": "object", "additionalProperties": false,
            "required": ["change_categories", "validation_profiles", "resource_kinds"],
            "properties": {
              "change_categories": { "$ref": "#/$defs/mappings" },
              "work_modes": { "$ref": "#/$defs/historicalWorkModeMappings" },
              "validation_profiles": { "$ref": "#/$defs/mappings" },
              "resource_kinds": { "$ref": "#/$defs/resourceMappings" },
              "instruction_impact": { "$ref": "#/$defs/mappings" },
              "instruction_surfaces": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["path", "legacy_action", "current_action", "retained_as"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "legacy_action": { "enum": ["update", "review-no-change"] },
                    "current_action": { "const": "update" },
                    "retained_as": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "missing_required_skill_surfaces": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["skill_id", "path", "current_action", "retained_status", "retained_as"],
                  "properties": {
                    "skill_id": { "$ref": "#/$defs/id" },
                    "path": { "type": "string", "pattern": "^<skills-root>/[a-z0-9][a-z0-9-]{1,127}/SKILL\\.md$" },
                    "current_action": { "const": "update" },
                    "retained_status": { "const": "planned" },
                    "retained_as": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "read_only_dependency_scope": {
                "type": "object", "additionalProperties": false,
                "required": ["closure", "mappings", "retained_as"],
                "properties": {
                  "closure": {
                    "type": "object", "additionalProperties": false,
                    "required": ["path", "sha256"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 },
                      "sha256": { "$ref": "#/$defs/hash" }
                    }
                  },
                  "mappings": {
                    "type": "array", "minItems": 1,
                    "items": {
                      "type": "object", "additionalProperties": false,
                      "required": ["repo_id", "legacy_path", "current_paths", "retained_as"],
                      "properties": {
                        "repo_id": { "$ref": "#/$defs/id" },
                        "legacy_path": { "type": "string", "minLength": 1 },
                        "current_paths": {
                          "type": "array", "minItems": 1,
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "retained_as": { "type": "string", "minLength": 1 }
                      }
                    }
                  },
                  "retained_as": { "type": "string", "minLength": 1 }
                }
              },
              "completed_project_scope": {
                "type": "object", "additionalProperties": false,
                "required": ["work_mode", "change_categories", "allowed_repositories", "blocker_evidence", "project_snapshot", "corrections", "mutation_performed", "retained_as"],
                "properties": {
                  "work_mode": { "const": "validation-only" },
                  "change_categories": {
                    "type": "array", "prefixItems": [{ "const": "validation" }], "items": false,
                    "minItems": 1, "maxItems": 1
                  },
                  "allowed_repositories": {
                    "type": "array", "minItems": 1,
                    "items": {
                      "type": "object", "additionalProperties": false,
                      "required": ["repo_id", "allowed_paths"],
                      "properties": {
                        "repo_id": { "$ref": "#/$defs/id" },
                        "allowed_paths": {
                          "type": "array", "minItems": 1,
                          "items": { "type": "string", "minLength": 1 }
                        }
                      }
                    }
                  },
                  "blocker_evidence": {
                    "type": "object", "additionalProperties": false,
                    "required": ["path", "sha256"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 },
                      "sha256": { "$ref": "#/$defs/hash" }
                    }
                  },
                  "project_snapshot": {
                    "type": "object", "additionalProperties": false,
                    "required": ["project_revision", "project_sha256", "feature_lock_revision", "feature_lock_sha256", "plan_revision"],
                    "properties": {
                      "project_revision": { "type": "integer", "minimum": 1 },
                      "project_sha256": { "$ref": "#/$defs/hash" },
                      "feature_lock_revision": { "type": "integer", "minimum": 1 },
                      "feature_lock_sha256": { "$ref": "#/$defs/hash" },
                      "plan_revision": { "type": "integer", "minimum": 1 }
                    }
                  },
                  "corrections": {
                    "type": "array", "minItems": 1,
                    "items": {
                      "type": "object", "additionalProperties": false,
                      "required": ["repository_id", "receipt_path", "receipt_sha256", "event_id", "event_sha256", "intent_path", "intent_sha256", "completion_path", "completion_sha256"],
                      "properties": {
                        "repository_id": { "$ref": "#/$defs/id" },
                        "receipt_path": { "type": "string", "minLength": 1 },
                        "receipt_sha256": { "$ref": "#/$defs/hash" },
                        "event_id": { "$ref": "#/$defs/id" },
                        "event_sha256": { "$ref": "#/$defs/hash" },
                        "intent_path": { "type": "string", "minLength": 1 },
                        "intent_sha256": { "$ref": "#/$defs/hash" },
                        "completion_path": { "type": "string", "minLength": 1 },
                        "completion_sha256": { "$ref": "#/$defs/hash" }
                      }
                    }
                  },
                  "mutation_performed": {
                    "type": "object", "additionalProperties": false,
                    "required": ["git", "device", "remote"],
                    "properties": {
                      "git": { "const": false },
                      "device": { "const": false },
                      "remote": { "const": false }
                    }
                  },
                  "retained_as": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "normalization": {
                    "required": ["work_modes"],
                    "properties": { "work_modes": { "minItems": 1 } }
                  }
                }
              },
              "then": {
                "properties": {
                  "terminal_status": { "const": "blocked" },
                  "terminal_evidence": {
                    "required": ["event_id", "event_sha256", "receipt_path", "receipt_sha256"],
                    "properties": { "receipt_path": { "type": "string", "minLength": 1 } }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "normalization": {
                    "required": ["missing_required_skill_surfaces"],
                    "properties": { "missing_required_skill_surfaces": { "minItems": 1 } }
                  }
                }
              },
              "then": {
                "properties": {
                  "terminal_status": { "const": "blocked" },
                  "terminal_evidence": {
                    "required": ["event_id", "event_sha256", "receipt_path", "receipt_sha256"],
                    "properties": { "receipt_path": { "type": "string", "minLength": 1 } }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "normalization": {
                    "anyOf": [
                      { "required": ["read_only_dependency_scope"] },
                      { "required": ["completed_project_scope"] }
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "terminal_status": { "const": "blocked" },
                  "terminal_evidence": {
                    "required": ["event_id", "event_sha256", "receipt_path", "receipt_sha256"],
                    "properties": { "receipt_path": { "type": "string", "minLength": 1 } }
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mappings": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["legacy", "current", "retained_as"],
        "properties": { "legacy": { "$ref": "#/$defs/id" }, "current": { "$ref": "#/$defs/id" }, "retained_as": { "type": "string", "minLength": 1 } }
      }
    },
    "historicalWorkModeMappings": {
      "type": "array", "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["legacy", "current", "retained_as"],
        "properties": {
          "legacy": { "const": "publication" },
          "current": { "const": "feature" },
          "retained_as": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resourceMappings": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["legacy", "current", "retained_as"],
        "properties": { "legacy": { "$ref": "#/$defs/id" }, "current": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "retained_as": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
