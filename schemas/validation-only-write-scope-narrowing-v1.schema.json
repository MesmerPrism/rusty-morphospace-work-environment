{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/validation-only-write-scope-narrowing-v1.schema.json",
  "title": "Narrow the write scope of a current validation-only unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "narrowing_id", "project_id", "unit_id", "expected", "before_allowed_repositories", "after_allowed_repositories", "does_not_prove"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.validation_only_write_scope_narrowing.v1" },
    "narrowing_id": { "$ref": "#/$defs/shortId" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "current_unit", "project_sha256", "project_raw_sha256", "state_sha256", "state_raw_sha256", "unit_sha256", "unit_raw_sha256", "source_composition_path", "source_composition_sha256", "repository_map_sha256", "events_sha256", "events_length", "event_tail_id"],
      "properties": {
        "status": { "enum": ["active", "validating"] },
        "current_unit": { "$ref": "#/$defs/id" },
        "project_sha256": { "$ref": "#/$defs/hash" },
        "project_raw_sha256": { "$ref": "#/$defs/hash" },
        "state_sha256": { "$ref": "#/$defs/hash" },
        "state_raw_sha256": { "$ref": "#/$defs/hash" },
        "unit_sha256": { "$ref": "#/$defs/hash" },
        "unit_raw_sha256": { "$ref": "#/$defs/hash" },
        "source_composition_path": { "$ref": "#/$defs/path" },
        "source_composition_sha256": { "$ref": "#/$defs/hash" },
        "repository_map_sha256": { "$ref": "#/$defs/hash" },
        "events_sha256": { "$ref": "#/$defs/hash" },
        "events_length": { "type": "integer", "minimum": 1 },
        "event_tail_id": { "$ref": "#/$defs/id" }
      }
    },
    "before_allowed_repositories": { "$ref": "#/$defs/scopes" },
    "after_allowed_repositories": { "$ref": "#/$defs/scopes" },
    "does_not_prove": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "shortId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "allowed_paths"],
      "properties": {
        "repo_id": { "$ref": "#/$defs/id" },
        "allowed_paths": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/scope" }
    }
  }
}
