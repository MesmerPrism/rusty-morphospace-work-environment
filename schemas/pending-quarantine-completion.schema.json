{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/pending-quarantine-completion.schema.json",
  "title": "Pending artifact quarantine completion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authorization", "completed_at", "project_id", "unit_id", "target_path", "pending", "quarantine_path", "status"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.pending_quarantine_completion.v1" },
    "authorization": {
      "allOf": [
        { "$ref": "#/$defs/reference" },
        { "properties": { "role": { "const": "pending-quarantine-authorization" }, "schema": { "const": "rusty.morphospace.workflow.pending_quarantine_authorization.v1" } } }
      ]
    },
    "completed_at": { "$ref": "#/$defs/utc" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/unit_id" },
    "target_path": { "$ref": "#/$defs/path" },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "length"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/hash" },
        "length": { "type": "integer", "minimum": 0, "maximum": 16777216 }
      }
    },
    "quarantine_path": { "$ref": "#/$defs/path" },
    "status": { "const": "quarantined-preserved" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,191}$" },
    "unit_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": {
        "role": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/path" },
        "schema": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,191}$" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
