{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/repository-lifecycle-advisory-v1.schema.json",
  "title": "Rusty Morphospace repository lifecycle advisory registry and result",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/registry" },
    { "$ref": "#/$defs/result" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "fullBranchRef": {
      "type": "string",
      "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"
    },
    "evidenceString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_refs", "consumer_ids", "reevaluation_gate"],
      "properties": {
        "status": {
          "enum": ["yes", "no", "unknown"]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceString" }
        },
        "consumer_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceString" }
        },
        "reevaluation_gate": { "$ref": "#/$defs/evidenceString" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "yes" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "consumer_ids": { "minItems": 1 } }
          }
        }
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_pr_use",
        "protected_ref",
        "pages_use",
        "workflow_use",
        "release_use",
        "deployment_use",
        "active_task_or_writer",
        "registered_worktree_consumer",
        "dirty_unique_local_consumer",
        "evidence_or_hold_consumer"
      ],
      "properties": {
        "open_pr_use": { "$ref": "#/$defs/check" },
        "protected_ref": { "$ref": "#/$defs/check" },
        "pages_use": { "$ref": "#/$defs/check" },
        "workflow_use": { "$ref": "#/$defs/check" },
        "release_use": { "$ref": "#/$defs/check" },
        "deployment_use": { "$ref": "#/$defs/check" },
        "active_task_or_writer": { "$ref": "#/$defs/check" },
        "registered_worktree_consumer": { "$ref": "#/$defs/check" },
        "dirty_unique_local_consumer": { "$ref": "#/$defs/check" },
        "evidence_or_hold_consumer": { "$ref": "#/$defs/check" }
      }
    },
    "registryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "expected_tip", "checks"],
      "properties": {
        "ref": { "$ref": "#/$defs/fullBranchRef" },
        "expected_tip": { "$ref": "#/$defs/revision" },
        "checks": { "$ref": "#/$defs/checks" }
      }
    },
    "registryRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "repository_root", "remote", "default_branch", "refs"],
      "properties": {
        "repo_id": { "$ref": "#/$defs/identifier" },
        "repository_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "remote": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "default_branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]{1,256}$"
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/registryRef" }
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "observed_at_utc", "repositories"],
      "properties": {
        "schema": {
          "const": "rusty.morphospace.workflow.repository_lifecycle_registry.v1"
        },
        "observed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/registryRepository" }
        }
      }
    },
    "resultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "expected_tip",
        "observed_tip",
        "tip_unchanged",
        "main_relation",
        "registered_worktree_paths",
        "checks",
        "disposition",
        "reason_codes",
        "confidence",
        "reevaluation_gates"
      ],
      "properties": {
        "ref": { "$ref": "#/$defs/fullBranchRef" },
        "expected_tip": { "$ref": "#/$defs/revision" },
        "observed_tip": {
          "oneOf": [
            { "$ref": "#/$defs/revision" },
            { "type": "null" }
          ]
        },
        "tip_unchanged": { "type": "boolean" },
        "main_relation": {
          "enum": ["equal", "ancestor", "divergent", "unknown"]
        },
        "registered_worktree_paths": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "checks": { "$ref": "#/$defs/checks" },
        "disposition": {
          "enum": ["candidate-retire", "hold", "incomplete"]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"
          }
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        },
        "reevaluation_gates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceString" }
        }
      }
    },
    "resultRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_id",
        "repository_root",
        "remote",
        "default_branch",
        "main_tip",
        "main_tree",
        "worktree_count",
        "dirty_worktree_count",
        "unreadable_worktree_count",
        "refs"
      ],
      "properties": {
        "repo_id": { "$ref": "#/$defs/identifier" },
        "repository_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "remote": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
        "default_branch": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,256}$" },
        "main_tip": { "$ref": "#/$defs/revision" },
        "main_tree": { "$ref": "#/$defs/revision" },
        "worktree_count": { "type": "integer", "minimum": 1 },
        "dirty_worktree_count": { "type": "integer", "minimum": 0 },
        "unreadable_worktree_count": { "type": "integer", "minimum": 0 },
        "refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/resultRef" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_count",
        "ref_count",
        "candidate_retire_count",
        "hold_count",
        "incomplete_count"
      ],
      "properties": {
        "repository_count": { "type": "integer", "minimum": 1 },
        "ref_count": { "type": "integer", "minimum": 1 },
        "candidate_retire_count": { "type": "integer", "minimum": 0 },
        "hold_count": { "type": "integer", "minimum": 0 },
        "incomplete_count": { "type": "integer", "minimum": 0 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "observed_at_utc",
        "execution",
        "git_mutation_performed",
        "remote_mutation_performed",
        "deletion_authority",
        "repositories",
        "summary"
      ],
      "properties": {
        "schema": {
          "const": "rusty.morphospace.workflow.repository_lifecycle_advisory.v1"
        },
        "observed_at_utc": { "type": "string", "format": "date-time" },
        "execution": { "const": "not-performed" },
        "git_mutation_performed": { "const": false },
        "remote_mutation_performed": { "const": false },
        "deletion_authority": { "const": "repository-owner-only" },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/resultRepository" }
        },
        "summary": { "$ref": "#/$defs/summary" }
      }
    }
  }
}
