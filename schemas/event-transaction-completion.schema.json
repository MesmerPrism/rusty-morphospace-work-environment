{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/event-transaction-completion.schema.json",
  "title": "Durable event append completion",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "transaction_id", "completed_at", "project_id", "unit_id", "run_id", "intent", "tail", "event_log_sha256", "event_log_length", "status"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.event_transaction_completion.v1" }, "transaction_id": { "$ref": "#/$defs/id" }, "completed_at": { "$ref": "#/$defs/utc" },
    "project_id": { "$ref": "#/$defs/id" }, "unit_id": { "$ref": "#/$defs/id" }, "run_id": { "$ref": "#/$defs/id" }, "intent": { "allOf": [{ "$ref": "#/$defs/reference" }, { "properties": { "role": { "const": "event-transaction-intent" }, "schema": { "const": "rusty.morphospace.workflow.event_transaction_intent.v1" } } }] },
    "tail": { "type": "object", "additionalProperties": false, "required": ["event_id", "sequence", "sha256"], "properties": { "event_id": { "$ref": "#/$defs/id" }, "sequence": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/hash" } } },
    "event_log_sha256": { "$ref": "#/$defs/hash" }, "event_log_length": { "type": "integer", "minimum": 1 }, "status": { "const": "committed" }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,191}$" }, "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" }, "reference": { "type": "object", "additionalProperties": false, "required": ["role", "path", "schema", "sha256"], "properties": { "role": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 1 }, "schema": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,191}$" }, "sha256": { "$ref": "#/$defs/hash" } } } }
}
