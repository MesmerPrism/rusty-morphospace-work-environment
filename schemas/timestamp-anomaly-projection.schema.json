{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/timestamp-anomaly-projection.schema.json",
  "title": "Legacy timestamp high-water anomaly projection",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "projection_id", "project_id", "unit_id", "created_at", "legacy_prefix_sha256", "anomalies", "safe_to_anchor"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.timestamp_anomaly_projection.v1" }, "projection_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" }, "unit_id": { "$ref": "#/$defs/id" }, "created_at": { "$ref": "#/$defs/utc" },
    "legacy_prefix_sha256": { "$ref": "#/$defs/hash" }, "safe_to_anchor": { "const": true },
    "anomalies": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["high_water_event_id", "high_water_timestamp", "below_high_water_event_id", "below_high_water_timestamp"], "properties": { "high_water_event_id": { "$ref": "#/$defs/id" }, "high_water_timestamp": { "type": "string", "minLength": 1 }, "below_high_water_event_id": { "$ref": "#/$defs/id" }, "below_high_water_timestamp": { "type": "string", "minLength": 1 } } } }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" }, "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" } }
}
