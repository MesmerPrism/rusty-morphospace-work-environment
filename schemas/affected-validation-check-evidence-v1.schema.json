{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/affected-validation-check-evidence-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "plan_sha256", "binding", "binding_sha256", "mode", "started_at", "ended_at", "elapsed_ms", "result", "blocked_by", "child", "environment", "artifacts", "reused_from", "claims"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.affected_validation_check_evidence.v1" },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["base", "head"],
      "properties": { "base": { "$ref": "#/$defs/gitIdentity" }, "head": { "$ref": "#/$defs/gitIdentity" } }
    },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "platform", "check_id", "command_path", "command_blob_sha1", "arguments", "check_definition_sha256", "cache_policy", "external_state", "runner", "runner_source_manifest", "dependency_manifest", "dependency_resolution", "prerequisite_bindings"],
      "properties": {
        "repository": { "const": "MesmerPrism/rusty-morphospace-work-environment" },
        "platform": { "enum": ["windows", "linux"] },
        "check_id": { "$ref": "#/$defs/id" },
        "command_path": { "$ref": "#/$defs/path" },
        "command_blob_sha1": { "$ref": "#/$defs/sha1" },
        "arguments": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 512 } },
        "check_definition_sha256": { "$ref": "#/$defs/sha256" },
        "cache_policy": { "enum": ["disabled", "exact-host", "portable"] },
        "external_state": { "const": "none" },
        "runner": { "$ref": "#/$defs/runner" },
        "runner_source_manifest": {
          "type": "array", "minItems": 8, "maxItems": 32,
          "items": { "$ref": "#/$defs/manifestRecord" }
        },
        "dependency_manifest": {
          "type": "array", "minItems": 1, "maxItems": 2048,
          "items": { "$ref": "#/$defs/manifestRecord" }
        },
        "dependency_resolution": { "$ref": "#/$defs/dependencyResolution" },
        "prerequisite_bindings": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["check_id", "binding_sha256"],
            "properties": { "check_id": { "$ref": "#/$defs/id" }, "binding_sha256": { "$ref": "#/$defs/sha256" } }
          }
        }
      }
    },
    "binding_sha256": { "$ref": "#/$defs/sha256" },
    "mode": { "enum": ["executed", "reused", "blocked"] },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "ended_at": { "$ref": "#/$defs/timestamp" },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "result": { "enum": ["pass", "code-fail", "infra-fail", "blocked"] },
    "blocked_by": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "child": {
      "type": "object", "additionalProperties": false,
      "required": ["started", "exit_code", "failure_kind", "timed_out", "output_truncated", "post_kill_drain_timed_out", "stdout", "stderr"],
      "properties": {
        "started": { "type": "boolean" },
        "exit_code": { "type": ["integer", "null"] },
        "failure_kind": { "enum": [null, "blocked", "launch", "timeout", "output-limit", "drain-timeout", "infrastructure", "exit-code"] },
        "timed_out": { "type": "boolean" },
        "output_truncated": { "type": "boolean" },
        "post_kill_drain_timed_out": { "type": "boolean" },
        "stdout": { "$ref": "#/$defs/stream" },
        "stderr": { "$ref": "#/$defs/stream" }
      }
    },
    "environment": { "$ref": "#/$defs/environmentProjection" },
    "artifacts": {
      "type": "array", "maxItems": 32,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "reused_from": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false, "required": ["receipt_sha256", "source_head"],
          "properties": { "receipt_sha256": { "$ref": "#/$defs/sha256" }, "source_head": { "$ref": "#/$defs/gitIdentity" } }
        }
      ]
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["check_only", "candidate_admission", "acceptance_authority", "publication_authority", "device_used"],
      "properties": {
        "check_only": { "const": true }, "candidate_admission": { "const": false }, "acceptance_authority": { "const": false }, "publication_authority": { "const": false }, "device_used": { "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "executed" } }, "required": ["mode"] },
      "then": { "properties": { "result": { "enum": ["pass", "code-fail", "infra-fail"] }, "blocked_by": { "maxItems": 0 }, "reused_from": { "type": "null" }, "environment": { "properties": { "projected": { "const": true } } } } }
    },
    {
      "if": { "properties": { "mode": { "const": "reused" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "result": { "const": "pass" },
          "blocked_by": { "maxItems": 0 },
          "elapsed_ms": { "const": 0 },
          "reused_from": { "type": "object" },
          "environment": { "properties": { "projected": { "const": true }, "leaf_variable_count": { "minimum": 1 }, "leaf_sha256": { "$ref": "#/$defs/sha256" }, "leaf_variables": { "minItems": 1 } } },
          "child": { "properties": { "started": { "const": false }, "exit_code": { "const": 0 }, "failure_kind": { "type": "null" }, "timed_out": { "const": false }, "output_truncated": { "const": false }, "post_kill_drain_timed_out": { "const": false } } }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "blocked" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "result": { "const": "blocked" },
          "blocked_by": { "minItems": 1 },
          "elapsed_ms": { "const": 0 },
          "reused_from": { "type": "null" },
          "child": {
            "properties": {
              "started": { "const": false },
              "exit_code": { "type": "null" },
              "failure_kind": { "const": "blocked" },
              "timed_out": { "const": false },
              "output_truncated": { "const": false },
              "post_kill_drain_timed_out": { "const": false },
              "stdout": { "properties": { "bytes": { "const": 0 }, "sha256": { "const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" } } },
              "stderr": { "properties": { "bytes": { "const": 0 }, "sha256": { "const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" } } }
            }
          },
          "environment": { "properties": { "projected": { "const": false }, "parent_variable_count_before": { "const": 0 }, "parent_sha256_before": { "type": "null" }, "parent_variable_count_after": { "const": 0 }, "parent_sha256_after": { "type": "null" }, "supervisor_variable_count": { "const": 0 }, "supervisor_sha256": { "type": "null" }, "supervisor_variables": { "maxItems": 0 }, "leaf_variable_count": { "const": 0 }, "leaf_sha256": { "type": "null" }, "leaf_variables": { "maxItems": 0 } } }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "executed" }, "result": { "const": "pass" } }, "required": ["mode", "result"] },
      "then": { "properties": { "child": { "properties": { "started": { "const": true } } }, "environment": { "properties": { "leaf_variable_count": { "minimum": 1 }, "leaf_sha256": { "$ref": "#/$defs/sha256" }, "leaf_variables": { "minItems": 1 } } } } }
    },
    {
      "if": { "properties": { "result": { "const": "pass" } }, "required": ["result"] },
      "then": { "properties": { "mode": { "enum": ["executed", "reused"] }, "child": { "properties": { "exit_code": { "const": 0 }, "failure_kind": { "type": "null" }, "timed_out": { "const": false }, "output_truncated": { "const": false }, "post_kill_drain_timed_out": { "const": false } } } } }
    },
    {
      "if": { "properties": { "result": { "const": "code-fail" } }, "required": ["result"] },
      "then": { "properties": { "mode": { "const": "executed" }, "child": { "properties": { "failure_kind": { "enum": ["timeout", "output-limit", "drain-timeout", "exit-code"] } } } } }
    },
    {
      "if": { "properties": { "result": { "const": "infra-fail" } }, "required": ["result"] },
      "then": { "properties": { "mode": { "const": "executed" }, "child": { "properties": { "failure_kind": { "enum": ["launch", "infrastructure"] } } } } }
    },
    {
      "if": { "properties": { "result": { "const": "blocked" } }, "required": ["result"] },
      "then": { "properties": { "mode": { "const": "blocked" } } }
    },
    {
      "if": { "properties": { "child": { "properties": { "failure_kind": { "const": "launch" } }, "required": ["failure_kind"] } }, "required": ["child"] },
      "then": { "properties": { "result": { "const": "infra-fail" }, "child": { "properties": { "started": { "const": false }, "exit_code": { "type": "null" }, "timed_out": { "const": false }, "output_truncated": { "const": false }, "post_kill_drain_timed_out": { "const": false } } } } }
    },
    {
      "if": { "properties": { "child": { "properties": { "failure_kind": { "const": "timeout" } }, "required": ["failure_kind"] } }, "required": ["child"] },
      "then": { "properties": { "result": { "const": "code-fail" }, "child": { "properties": { "started": { "const": true }, "timed_out": { "const": true } } } } }
    },
    {
      "if": { "properties": { "child": { "properties": { "failure_kind": { "const": "output-limit" } }, "required": ["failure_kind"] } }, "required": ["child"] },
      "then": { "properties": { "result": { "const": "code-fail" }, "child": { "properties": { "started": { "const": true }, "timed_out": { "const": false }, "output_truncated": { "const": true } } } } }
    },
    {
      "if": { "properties": { "child": { "properties": { "failure_kind": { "const": "drain-timeout" } }, "required": ["failure_kind"] } }, "required": ["child"] },
      "then": { "properties": { "result": { "const": "code-fail" }, "child": { "properties": { "started": { "const": true }, "timed_out": { "const": false }, "output_truncated": { "const": false }, "post_kill_drain_timed_out": { "const": true } } } } }
    },
    {
      "if": { "properties": { "child": { "properties": { "failure_kind": { "const": "exit-code" } }, "required": ["failure_kind"] } }, "required": ["child"] },
      "then": { "properties": { "result": { "const": "code-fail" }, "child": { "properties": { "started": { "const": true }, "exit_code": { "type": "integer", "not": { "const": 0 } }, "timed_out": { "const": false }, "output_truncated": { "const": false }, "post_kill_drain_timed_out": { "const": false } } } } }
    },
    {
      "if": { "properties": { "child": { "properties": { "failure_kind": { "const": "infrastructure" } }, "required": ["failure_kind"] } }, "required": ["child"] },
      "then": { "properties": { "result": { "const": "infra-fail" }, "child": { "properties": { "timed_out": { "const": false }, "output_truncated": { "const": false }, "post_kill_drain_timed_out": { "const": false } } } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*\\\\)(?!.*:)[^\\\\\u0000-\u001f\u007f]+$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "gitIdentity": { "type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": { "commit": { "$ref": "#/$defs/sha1" }, "tree": { "$ref": "#/$defs/sha1" } } },
    "manifestRecord": {
      "type": "object", "additionalProperties": false, "required": ["path", "mode", "blob"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "mode": { "enum": ["100644", "100755"] }, "blob": { "$ref": "#/$defs/sha1" } }
    },
    "environmentVariable": {
      "type": "object", "additionalProperties": false, "required": ["name", "source", "value_sha256"],
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^=\\u0000-\\u001f\\u007f]+$" }, "source": { "enum": ["host-runtime", "launcher-owned", "hosted-producer"] }, "value_sha256": { "$ref": "#/$defs/sha256" } }
    },
    "environmentProjection": {
      "type": "object", "additionalProperties": false,
      "required": ["projected", "parent_variable_count_before", "parent_sha256_before", "parent_variable_count_after", "parent_sha256_after", "parent_environment_unchanged", "supervisor_variable_count", "supervisor_sha256", "supervisor_variables", "leaf_variable_count", "leaf_sha256", "leaf_variables"],
      "properties": {
        "projected": { "type": "boolean" }, "parent_variable_count_before": { "type": "integer", "minimum": 0, "maximum": 4096 }, "parent_sha256_before": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "parent_variable_count_after": { "type": "integer", "minimum": 0, "maximum": 4096 }, "parent_sha256_after": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "parent_environment_unchanged": { "const": true },
        "supervisor_variable_count": { "type": "integer", "minimum": 0, "maximum": 64 }, "supervisor_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "supervisor_variables": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/environmentVariable" } },
        "leaf_variable_count": { "type": "integer", "minimum": 0, "maximum": 64 }, "leaf_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "leaf_variables": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/environmentVariable" } }
      },
      "allOf": [
        {
          "if": { "properties": { "projected": { "const": false } }, "required": ["projected"] },
          "then": { "properties": { "parent_variable_count_before": { "const": 0 }, "parent_sha256_before": { "type": "null" }, "parent_variable_count_after": { "const": 0 }, "parent_sha256_after": { "type": "null" }, "supervisor_variable_count": { "const": 0 }, "supervisor_sha256": { "type": "null" }, "supervisor_variables": { "maxItems": 0 }, "leaf_variable_count": { "const": 0 }, "leaf_sha256": { "type": "null" }, "leaf_variables": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "projected": { "const": true } }, "required": ["projected"] },
          "then": { "properties": { "parent_sha256_before": { "$ref": "#/$defs/sha256" }, "parent_sha256_after": { "$ref": "#/$defs/sha256" }, "supervisor_variable_count": { "minimum": 1 }, "supervisor_sha256": { "$ref": "#/$defs/sha256" }, "supervisor_variables": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "leaf_variable_count": { "const": 0 } }, "required": ["leaf_variable_count"] },
          "then": { "properties": { "leaf_sha256": { "type": "null" }, "leaf_variables": { "maxItems": 0 } } },
          "else": { "properties": { "leaf_sha256": { "$ref": "#/$defs/sha256" }, "leaf_variables": { "minItems": 1 } } }
        }
      ]
    },
    "dependencyDeclaration": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["importer", "variable", "count", "target_paths"],
          "properties": {
            "importer": { "$ref": "#/$defs/scriptPath" }, "variable": { "$ref": "#/$defs/variable" }, "count": { "type": "integer", "minimum": 1, "maximum": 256 },
            "target_paths": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/scriptPath" } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["importer", "variable", "count", "classification"],
          "properties": {
            "importer": { "$ref": "#/$defs/scriptPath" }, "variable": { "$ref": "#/$defs/variable" }, "count": { "type": "integer", "minimum": 1, "maximum": 256 },
            "classification": { "const": "authenticated-external-command" }
          }
        }
      ]
    },
    "dependencyResolution": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "algorithm", "mode", "entrypoint", "used_declarations", "fallback_reasons"],
      "properties": {
        "schema": { "const": "rusty.morphospace.workflow.affected_validation_dependency_resolution.v1" },
        "algorithm": { "const": "indexed-static-closure-v1" },
        "mode": { "enum": ["exact", "all-tracked-scripts-fallback"] },
        "entrypoint": { "$ref": "#/$defs/trackedPowerShellPath" },
        "used_declarations": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/dependencyDeclaration" } },
        "fallback_reasons": {
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["importer", "variable", "kind"],
            "properties": {
              "importer": { "$ref": "#/$defs/trackedPowerShellPath" }, "variable": { "type": "string", "minLength": 1, "maxLength": 512 },
              "kind": { "enum": ["unresolved-import", "unresolved-invocation", "ambiguous-static-binding"] }
            }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "exact" } } }, "then": { "properties": { "fallback_reasons": { "maxItems": 0 } } } },
        { "if": { "properties": { "mode": { "const": "all-tracked-scripts-fallback" } } }, "then": { "properties": { "fallback_reasons": { "minItems": 1 } } } }
      ]
    },
    "trackedPowerShellPath": { "type": "string", "minLength": 12, "maxLength": 4096, "pattern": "^(?:scripts|tools)/[^\\\\:\u0000-\u001f\u007f]+\\.ps(?:m)?1$" },
    "scriptPath": { "type": "string", "minLength": 12, "maxLength": 4096, "pattern": "^scripts/[^\\\\:\u0000-\u001f\u007f]+\\.ps(?:m)?1$" },
    "variable": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z_][A-Za-z0-9_:.-]*$" },
    "runner": {
      "type": "object", "additionalProperties": false,
      "required": ["os_description", "process_architecture", "powershell_version", "powershell_executable_sha256", "git_version", "git_executable_sha256"],
      "properties": {
        "os_description": { "type": "string", "minLength": 1, "maxLength": 512 },
        "process_architecture": { "enum": ["x64", "x86", "arm64", "arm"] },
        "powershell_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
        "powershell_executable_sha256": { "$ref": "#/$defs/sha256" },
        "git_version": { "type": "string", "pattern": "^git version [0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:\\.[A-Za-z0-9.-]+)?$" },
        "git_executable_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "stream": {
      "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"],
      "properties": { "path": { "enum": ["stdout.bin", "stderr.bin"] }, "bytes": { "type": "integer", "minimum": 0, "maximum": 10485760 }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "bytes": { "type": "integer", "minimum": 0, "maximum": 134217728 }, "sha256": { "$ref": "#/$defs/sha256" } },
      "allOf": [
        {
          "if": { "properties": { "path": { "pattern": "^[a-z0-9][a-z0-9-]{1,95}\\.(?:start|terminal)\\.json$" } }, "required": ["path"] },
          "else": { "properties": { "bytes": { "maximum": 10485760 } } }
        }
      ]
    }
  }
}
