{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/affected-validation-check-evidence-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "binding", "binding_sha256", "mode", "started_at", "ended_at", "elapsed_ms", "result", "blocked_by", "child", "artifacts", "reused_from", "claims"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.affected_validation_check_evidence.v1" },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["base", "head"],
      "properties": { "base": { "$ref": "#/$defs/gitIdentity" }, "head": { "$ref": "#/$defs/gitIdentity" } }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "platform", "check_id", "command_path", "command_blob_sha1", "arguments", "check_definition_sha256", "cache_policy", "external_state", "runner", "runner_source_manifest", "dependency_manifest", "prerequisite_bindings"],
      "properties": {
        "repository": { "const": "MesmerPrism/rusty-morphospace-work-environment" },
        "platform": { "enum": ["windows", "linux"] },
        "check_id": { "$ref": "#/$defs/id" },
        "command_path": { "$ref": "#/$defs/path" },
        "command_blob_sha1": { "$ref": "#/$defs/sha1" },
        "arguments": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 512 } },
        "check_definition_sha256": { "$ref": "#/$defs/sha256" },
        "cache_policy": { "enum": ["disabled", "exact-host", "portable"] },
        "external_state": { "const": "none" },
        "runner": { "$ref": "#/$defs/runner" },
        "runner_source_manifest": {
          "type": "array", "minItems": 8, "maxItems": 32,
          "items": { "$ref": "#/$defs/manifestRecord" }
        },
        "dependency_manifest": {
          "type": "array", "minItems": 1, "maxItems": 2048,
          "items": { "$ref": "#/$defs/manifestRecord" }
        },
        "prerequisite_bindings": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["check_id", "binding_sha256"],
            "properties": { "check_id": { "$ref": "#/$defs/id" }, "binding_sha256": { "$ref": "#/$defs/sha256" } }
          }
        }
      }
    },
    "binding_sha256": { "$ref": "#/$defs/sha256" },
    "mode": { "enum": ["executed", "reused", "blocked"] },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "ended_at": { "$ref": "#/$defs/timestamp" },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "result": { "enum": ["pass", "code-fail", "infra-fail", "blocked"] },
    "blocked_by": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "child": {
      "type": "object", "additionalProperties": false,
      "required": ["started", "exit_code", "timed_out", "output_truncated", "post_kill_drain_timed_out", "stdout", "stderr"],
      "properties": {
        "started": { "type": "boolean" },
        "exit_code": { "type": ["integer", "null"] },
        "timed_out": { "type": "boolean" },
        "output_truncated": { "type": "boolean" },
        "post_kill_drain_timed_out": { "type": "boolean" },
        "stdout": { "$ref": "#/$defs/stream" },
        "stderr": { "$ref": "#/$defs/stream" }
      }
    },
    "artifacts": {
      "type": "array", "maxItems": 32,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "reused_from": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false, "required": ["receipt_sha256", "source_head"],
          "properties": { "receipt_sha256": { "$ref": "#/$defs/sha256" }, "source_head": { "$ref": "#/$defs/gitIdentity" } }
        }
      ]
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["check_only", "candidate_admission", "acceptance_authority", "publication_authority", "device_used"],
      "properties": {
        "check_only": { "const": true }, "candidate_admission": { "const": false }, "acceptance_authority": { "const": false }, "publication_authority": { "const": false }, "device_used": { "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "executed" } }, "required": ["mode"] },
      "then": { "properties": { "blocked_by": { "maxItems": 0 }, "reused_from": { "type": "null" } } }
    },
    {
      "if": { "properties": { "mode": { "const": "reused" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "result": { "const": "pass" },
          "blocked_by": { "maxItems": 0 },
          "elapsed_ms": { "const": 0 },
          "reused_from": { "type": "object" },
          "child": { "properties": { "started": { "const": false }, "exit_code": { "const": 0 }, "timed_out": { "const": false }, "output_truncated": { "const": false }, "post_kill_drain_timed_out": { "const": false } } }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "blocked" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "result": { "const": "blocked" },
          "blocked_by": { "minItems": 1 },
          "elapsed_ms": { "const": 0 },
          "reused_from": { "type": "null" },
          "child": {
            "properties": {
              "started": { "const": false },
              "exit_code": { "type": "null" },
              "timed_out": { "const": false },
              "output_truncated": { "const": false },
              "post_kill_drain_timed_out": { "const": false },
              "stdout": { "properties": { "bytes": { "const": 0 }, "sha256": { "const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" } } },
              "stderr": { "properties": { "bytes": { "const": 0 }, "sha256": { "const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "result": { "const": "pass" } }, "required": ["result"] },
      "then": { "properties": { "child": { "properties": { "exit_code": { "const": 0 }, "timed_out": { "const": false }, "output_truncated": { "const": false }, "post_kill_drain_timed_out": { "const": false } } } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*\\\\)(?!.*:)[^\\\\\u0000-\u001f\u007f]+$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "gitIdentity": { "type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": { "commit": { "$ref": "#/$defs/sha1" }, "tree": { "$ref": "#/$defs/sha1" } } },
    "manifestRecord": {
      "type": "object", "additionalProperties": false, "required": ["path", "mode", "blob"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "mode": { "enum": ["100644", "100755"] }, "blob": { "$ref": "#/$defs/sha1" } }
    },
    "runner": {
      "type": "object", "additionalProperties": false,
      "required": ["os_description", "process_architecture", "powershell_version", "powershell_executable_sha256", "git_version", "git_executable_sha256"],
      "properties": {
        "os_description": { "type": "string", "minLength": 1, "maxLength": 512 },
        "process_architecture": { "enum": ["x64", "x86", "arm64", "arm"] },
        "powershell_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
        "powershell_executable_sha256": { "$ref": "#/$defs/sha256" },
        "git_version": { "type": "string", "pattern": "^git version [0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:\\.[A-Za-z0-9.-]+)?$" },
        "git_executable_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "stream": {
      "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"],
      "properties": { "path": { "enum": ["stdout.bin", "stderr.bin"] }, "bytes": { "type": "integer", "minimum": 0, "maximum": 10485760 }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "bytes": { "type": "integer", "minimum": 0, "maximum": 10485760 }, "sha256": { "$ref": "#/$defs/sha256" } }
    }
  }
}
