{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/native-nonpass-repair-qualification-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "payload",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "rusty.morphospace.workflow.native_nonpass_repair_qualification.v1"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "issuer_id",
        "authorization_id",
        "issued_at",
        "expires_at",
        "decision",
        "authority",
        "executor",
        "qualification_base_commit",
        "changed_artifacts",
        "landing",
        "evidence",
        "limitations"
      ],
      "properties": {
        "schema": {
          "const": "rusty.morphospace.workflow.native_nonpass_repair_qualification_payload.v1"
        },
        "issuer_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
        },
        "authorization_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{15,127}$"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "const": "qualify-native-nonpass-repair-source"
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit",
            "tree",
            "closure_sha256",
            "policy_sha256"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "commit": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "tree": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "closure_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "policy_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "executor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit",
            "tree",
            "closure_sha256",
            "artifacts"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "commit": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "tree": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "closure_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "state",
                      "mode",
                      "size_bytes",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:\\u0000-\\u001f\\u007f]+$"
                      },
                      "state": {
                        "const": "present"
                      },
                      "mode": {
                        "enum": [
                          "100644",
                          "100755"
                        ]
                      },
                      "size_bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 16777216
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "state"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:\\u0000-\\u001f\\u007f]+$"
                      },
                      "state": {
                        "const": "absent"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "qualification_base_commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "changed_artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "state",
                  "mode",
                  "size_bytes",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:\\u0000-\\u001f\\u007f]+$"
                  },
                  "state": {
                    "const": "present"
                  },
                  "mode": {
                    "enum": [
                      "100644",
                      "100755"
                    ]
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16777216
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "state"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:\\u0000-\\u001f\\u007f]+$"
                  },
                  "state": {
                    "const": "absent"
                  }
                }
              }
            ]
          }
        },
        "landing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "tree",
            "parents"
          ],
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "tree": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "parents": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path",
              "size_bytes",
              "sha256"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "source-review",
                  "focused-conformance",
                  "static-admission",
                  "quick-linux",
                  "quick-windows",
                  "standard-windows",
                  "policy-landing",
                  "implementation-landing"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:\\u0000-\\u001f\\u007f]+$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16777216
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "limitations": {
          "const": [
            "source-qualification-only",
            "no-native-state-change",
            "no-unit-acceptance"
          ]
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "public_key_spki_sha256",
        "value_base64"
      ],
      "properties": {
        "algorithm": {
          "const": "RSA-PSS-SHA256"
        },
        "public_key_spki_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "value_base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "minLength": 128,
          "maxLength": 2048
        }
      }
    }
  }
}
