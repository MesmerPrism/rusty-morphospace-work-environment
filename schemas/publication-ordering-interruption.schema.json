{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/publication-ordering-interruption.schema.json","title":"Preserved early-planning publication ordering interruption","type":"object","additionalProperties":false,"required":["schema","project_id","unit_id","kind","observed_at","planning","sources","does_not_claim"],"properties":{"schema":{"const":"rusty.morphospace.workflow.publication_ordering_interruption.v1"},"project_id":{"$ref":"#/$defs/id"},"unit_id":{"$ref":"#/$defs/id"},"kind":{"const":"planning-published-before-source"},"observed_at":{"type":"string","format":"date-time"},"planning":{"type":"object","additionalProperties":false,"required":["repo_id","early_remote_revision","local_prepared_revision"],"properties":{"repo_id":{"$ref":"#/$defs/id"},"early_remote_revision":{"$ref":"#/$defs/revision"},"local_prepared_revision":{"$ref":"#/$defs/revision"}}},"sources":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["repo_id","unpublished_remote_revision","local_revision"],"properties":{"repo_id":{"$ref":"#/$defs/id"},"unpublished_remote_revision":{"$ref":"#/$defs/revision"},"local_revision":{"$ref":"#/$defs/revision"}}}},"does_not_claim":{"type":"array","minItems":3,"uniqueItems":true,"items":{"enum":["planning-last chronology","source publication","executed push","publication accounting","recorded publication"]},"allOf":[{"contains":{"const":"planning-last chronology"}},{"contains":{"const":"source publication"}},{"contains":{"const":"executed push"}}]}},"$defs":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{1,127}$"},"revision":{"type":"string","pattern":"^[0-9a-fA-F]{40}$"}}}
