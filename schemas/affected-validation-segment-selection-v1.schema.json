{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/affected-validation-segment-selection-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "run", "source", "selected", "claims"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.affected_validation_segment_selection.v1" },
    "repository": { "type": "string", "minLength": 1, "maxLength": 256 },
    "run": {
      "type": "object", "additionalProperties": false, "required": ["id", "current_attempt"],
      "properties": { "id": { "$ref": "#/$defs/positiveIntegerString" }, "current_attempt": { "type": "integer", "minimum": 1, "maximum": 2147483647 } }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["base", "head", "plan_sha256", "platform"],
      "properties": { "base": { "$ref": "#/$defs/gitIdentity" }, "head": { "$ref": "#/$defs/gitIdentity" }, "plan_sha256": { "$ref": "#/$defs/hash" }, "platform": { "enum": ["linux", "windows"] } }
    },
    "selected": {
      "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["segment_id", "artifact_name", "attempt", "payload_sha256"],
        "properties": {
          "segment_id": { "type": "string", "pattern": "^(linux|windows)-[0-9]{3}$" },
          "artifact_name": { "type": "string", "pattern": "^affected-segment-(linux|windows)-[0-9]{3}-[0-9a-f]{64}-[1-9][0-9]*-[1-9][0-9]*$" },
          "attempt": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "payload_sha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false, "required": ["segment_evidence_staged", "aggregate_authority", "acceptance_authority", "publication_authority"],
      "properties": { "segment_evidence_staged": { "const": true }, "aggregate_authority": { "const": false }, "acceptance_authority": { "const": false }, "publication_authority": { "const": false } }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "positiveIntegerString": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "gitIdentity": {
      "type": "object", "additionalProperties": false, "required": ["commit", "tree"],
      "properties": { "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
    }
  }
}
