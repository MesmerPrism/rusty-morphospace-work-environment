{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/feature-descriptor.schema.json",
  "title": "Rusty Morphospace feature descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "feature_id",
    "module_id",
    "version",
    "owner_lane",
    "source",
    "dependencies",
    "conflicts",
    "exclusive_group",
    "effects",
    "parameter_authorities",
    "activation",
    "validation_profile",
    "rollback_profile"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "rusty.morphospace.workflow.feature_descriptor.v1" },
    "feature_id": { "$ref": "#/$defs/id" },
    "module_id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "owner_lane": { "$ref": "#/$defs/id" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "revision", "path", "sha256"],
      "properties": {
        "repo_id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/sha" },
        "path": { "$ref": "#/$defs/portablePath" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "dependencies": { "$ref": "#/$defs/ids" },
    "conflicts": { "$ref": "#/$defs/ids" },
    "exclusive_group": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permissions", "services", "activities", "queries", "tools", "assets",
        "shaders", "native_libraries", "commands", "routes", "streams", "inputs",
        "scenes", "markers"
      ],
      "properties": {
        "permissions": { "$ref": "#/$defs/strings" },
        "services": { "$ref": "#/$defs/strings" },
        "activities": { "$ref": "#/$defs/strings" },
        "queries": { "$ref": "#/$defs/strings" },
        "tools": { "$ref": "#/$defs/strings" },
        "assets": { "$ref": "#/$defs/strings" },
        "shaders": { "$ref": "#/$defs/strings" },
        "native_libraries": { "$ref": "#/$defs/strings" },
        "commands": { "$ref": "#/$defs/strings" },
        "routes": { "$ref": "#/$defs/strings" },
        "streams": { "$ref": "#/$defs/strings" },
        "inputs": { "$ref": "#/$defs/strings" },
        "scenes": { "$ref": "#/$defs/strings" },
        "markers": { "$ref": "#/$defs/strings" }
      }
    },
    "parameter_authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameter", "owner"],
        "properties": {
          "parameter": { "$ref": "#/$defs/dottedId" },
          "owner": { "$ref": "#/$defs/id" }
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "runtime_inputs", "receipt_schema", "effective_marker"],
      "properties": {
        "rule": { "const": "selected-lock-and-runtime-input" },
        "runtime_inputs": { "$ref": "#/$defs/strings" },
        "receipt_schema": { "$ref": "#/$defs/dottedId" },
        "effective_marker": { "$ref": "#/$defs/dottedId" }
      }
    },
    "validation_profile": { "$ref": "#/$defs/id" },
    "rollback_profile": { "$ref": "#/$defs/id" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "dottedId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,127}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "portablePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?($|/)).+$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
