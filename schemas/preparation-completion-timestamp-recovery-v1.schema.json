{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/preparation-completion-timestamp-recovery-v1.schema.json",
  "title": "Exact preparation completion chronology recovery after ordinary admission, Ready and Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "recovery_id",
    "project_id",
    "unit_id",
    "preparation_id",
    "prepared_sequence",
    "fault_kind",
    "chronology",
    "evidence",
    "snapshots",
    "ledger"
  ],
  "properties": {
    "schema": {
      "const": "rusty.morphospace.workflow.preparation_completion_timestamp_recovery.v1"
    },
    "recovery_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "unit_id": {
      "$ref": "#/$defs/id"
    },
    "preparation_id": {
      "$ref": "#/$defs/id"
    },
    "prepared_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "fault_kind": {
      "const": "preparation-completion-precedes-intent"
    },
    "chronology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_created_at",
        "malformed_completed_at",
        "recovery_timestamp"
      ],
      "properties": {
        "intent_created_at": {
          "$ref": "#/$defs/time"
        },
        "malformed_completed_at": {
          "$ref": "#/$defs/time"
        },
        "recovery_timestamp": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 13,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "unit",
        "project",
        "feature_lock"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/snapshot"
        },
        "unit": {
          "$ref": "#/$defs/snapshot"
        },
        "project": {
          "$ref": "#/$defs/snapshot"
        },
        "feature_lock": {
          "$ref": "#/$defs/snapshot"
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_sha256",
        "length",
        "tail_event_id"
      ],
      "properties": {
        "raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "tail_event_id": {
          "$ref": "#/$defs/id"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "raw_sha256",
        "canonical_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "raw_sha256",
        "canonical_sha256",
        "document"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/hash"
        },
        "document": {
          "type": "object"
        }
      }
    }
  }
}
