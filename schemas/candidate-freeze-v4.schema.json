{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/candidate-freeze-v4.schema.json",
  "title": "Exact nonpass mutable-evidence custody correction of an immutable development candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "freeze_id",
    "project_id",
    "unit_id",
    "expected",
    "final_repositories",
    "changed_paths",
    "cleanliness_policy",
    "instruction_surfaces",
    "feature_lock",
    "effects",
    "permissions",
    "device_use",
    "test_matrix",
    "cleanup_evidence",
    "source_composition",
    "does_not_prove",
    "predecessor",
    "nonpass_custody_defect",
    "recovery_authorization"
  ],
  "properties": {
    "schema": {
      "const": "rusty.morphospace.workflow.candidate_freeze.v4"
    },
    "freeze_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "unit_id": {
      "$ref": "#/$defs/id"
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_sha256",
        "state_sha256",
        "unit_sha256",
        "feature_lock_sha256",
        "source_composition_path",
        "source_composition_sha256",
        "repository_map_path",
        "repository_map_sha256",
        "events_sha256",
        "events_length",
        "event_tail_id",
        "project_raw_sha256",
        "state_raw_sha256",
        "unit_raw_sha256",
        "feature_lock_raw_sha256"
      ],
      "properties": {
        "project_sha256": {
          "$ref": "#/$defs/hash"
        },
        "state_sha256": {
          "$ref": "#/$defs/hash"
        },
        "unit_sha256": {
          "$ref": "#/$defs/hash"
        },
        "feature_lock_sha256": {
          "$ref": "#/$defs/hash"
        },
        "source_composition_path": {
          "$ref": "#/$defs/path"
        },
        "source_composition_sha256": {
          "$ref": "#/$defs/hash"
        },
        "repository_map_path": {
          "$ref": "#/$defs/path"
        },
        "repository_map_sha256": {
          "$ref": "#/$defs/hash"
        },
        "events_sha256": {
          "$ref": "#/$defs/hash"
        },
        "events_length": {
          "type": "integer",
          "minimum": 1
        },
        "event_tail_id": {
          "$ref": "#/$defs/id"
        },
        "project_raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "state_raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "unit_raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "feature_lock_raw_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "final_repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo_id",
          "commit",
          "tree"
        ],
        "properties": {
          "repo_id": {
            "$ref": "#/$defs/id"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "tree": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo_id",
          "paths"
        ],
        "properties": {
          "repo_id": {
            "$ref": "#/$defs/id"
          },
          "paths": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/path"
            }
          }
        }
      }
    },
    "cleanliness_policy": {
      "enum": [
        "clean-only",
        "declared-dirty-paths"
      ]
    },
    "instruction_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "disposition"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "updated",
              "reviewed-no-change",
              "not-applicable"
            ]
          }
        }
      }
    },
    "feature_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "sha256"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "device_use": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "command"
        ],
        "properties": {
          "test_id": {
            "$ref": "#/$defs/id"
          },
          "command": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cleanup_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "does_not_prove": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freeze",
        "return_event_id",
        "validation_receipt"
      ],
      "properties": {
        "freeze": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "freeze_id",
            "receipt_path",
            "receipt_sha256"
          ],
          "properties": {
            "freeze_id": {
              "$ref": "#/$defs/id"
            },
            "receipt_path": {
              "$ref": "#/$defs/path"
            },
            "receipt_sha256": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        "return_event_id": {
          "$ref": "#/$defs/id"
        },
        "validation_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "sha256": {
              "$ref": "#/$defs/hash"
            }
          }
        }
      }
    },
    "nonpass_custody_defect": {
      "$ref": "#/$defs/nonpass_custody_defect"
    },
    "recovery_authorization": {
      "properties": {
        "authorization_path": {
          "type": "string",
          "minLength": 1
        },
        "trusted_authority_root": {
          "type": "string",
          "minLength": 1
        },
        "source_qualification_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "trusted_authority_root",
        "authorization_path",
        "source_qualification_path"
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*/?$"
    },
    "nonpass_custody_defect": {
      "additionalProperties": false,
      "required": [
        "schema",
        "defect_id",
        "freeze",
        "begin",
        "return",
        "original_receipt",
        "retained_receipt",
        "artifacts",
        "audit_inert",
        "accepted",
        "historical_payload_preserved",
        "disposition",
        "project_id",
        "unit_id",
        "result",
        "tier",
        "receipt_schema",
        "frozen_repositories",
        "validation_credit",
        "acceptance_credit",
        "proof_reuse"
      ],
      "properties": {
        "accepted": {
          "const": false
        },
        "freeze": {
          "$ref": "#/$defs/transition"
        },
        "disposition": {
          "const": "audit-inert-unavailable"
        },
        "schema": {
          "const": "rusty.morphospace.workflow.nonpass_custody_defect.v1"
        },
        "retained_receipt": {
          "$ref": "#/$defs/receipt_binding"
        },
        "artifacts": {
          "uniqueItems": true,
          "type": "array",
          "minItems": 1,
          "items": {
            "properties": {
              "observation": {
                "properties": {
                  "state": {
                    "enum": [
                      "missing",
                      "different"
                    ]
                  },
                  "sha256": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/hash"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "state": {
                          "const": "missing"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "sha256": {
                          "$ref": "#/$defs/hash"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "sha256": {
                          "type": "null"
                        }
                      }
                    }
                  }
                ],
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "state",
                  "sha256"
                ]
              },
              "artifact_id": {
                "$ref": "#/$defs/id"
              },
              "repo_id": {
                "$ref": "#/$defs/id"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "artifact_class": {
                "enum": [
                  "mutable-source",
                  "git-index"
                ]
              },
              "expected_sha256": {
                "$ref": "#/$defs/hash"
              },
              "observed_at": {
                "format": "date-time",
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "artifact_id",
              "path",
              "expected_sha256",
              "artifact_class",
              "repo_id",
              "observation",
              "observed_at",
              "reason"
            ]
          },
          "maxItems": 16
        },
        "original_receipt": {
          "$ref": "#/$defs/receipt_binding"
        },
        "return": {
          "$ref": "#/$defs/transition"
        },
        "historical_payload_preserved": {
          "const": false
        },
        "begin": {
          "$ref": "#/$defs/transition"
        },
        "audit_inert": {
          "const": true
        },
        "defect_id": {
          "$ref": "#/$defs/id"
        },
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "unit_id": {
          "$ref": "#/$defs/id"
        },
        "result": {
          "enum": [
            "fail",
            "blocked",
            "partial"
          ]
        },
        "tier": {
          "enum": [
            "quick",
            "standard",
            "deep"
          ]
        },
        "receipt_schema": {
          "const": "rusty.morphospace.workflow.validation_receipt.v1"
        },
        "frozen_repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo_id",
              "commit",
              "tree"
            ],
            "properties": {
              "repo_id": {
                "$ref": "#/$defs/id"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "tree": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        "validation_credit": {
          "const": false
        },
        "acceptance_credit": {
          "const": false
        },
        "proof_reuse": {
          "const": false
        }
      },
      "type": "object",
      "title": "Immutable audit-only nonpassing mutable-evidence custody defect"
    },
    "binding": {
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "path",
        "sha256"
      ]
    },
    "transition": {
      "properties": {
        "intent": {
          "$ref": "#/$defs/binding"
        },
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "completion": {
          "$ref": "#/$defs/binding"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "event_id",
        "intent",
        "completion"
      ]
    },
    "receipt_binding": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "canonical_sha256"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/hash"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      },
      "additionalProperties": false
    }
  }
}
