{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/workspace-state-v2.schema.json",
  "title": "Rusty Morphospace compact workspace state v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "project_id", "plan_revision", "current_unit", "next_ready_unit",
    "last_event_id", "last_accepted_receipt", "repository_heads", "module_registry",
    "capability_registry", "dirty_repositories", "blockers", "validation_checkpoint",
    "pending_push_bundle"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "rusty.morphospace.workflow.workspace_state.v2" },
    "project_id": { "$ref": "#/$defs/id" },
    "plan_revision": { "type": "integer", "minimum": 1 },
    "current_unit": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "next_ready_unit": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "last_event_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "last_accepted_receipt": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "repository_heads": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repo_id", "head", "branch", "dirty_fingerprint"],
        "properties": {
          "repo_id": { "$ref": "#/$defs/id" }, "head": { "$ref": "#/$defs/sha" },
          "branch": { "type": ["string", "null"] }, "dirty_fingerprint": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "module_registry": {
      "type": "object", "additionalProperties": false,
      "required": ["lock_revision", "lock_fingerprint", "modules"],
      "properties": {
        "lock_revision": { "type": ["integer", "null"], "minimum": 1 },
        "lock_fingerprint": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
        "modules": { "type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["module_id", "owner_repo", "maturity", "contract", "contract_revision"],
          "properties": {
            "module_id": { "$ref": "#/$defs/id" }, "owner_repo": { "$ref": "#/$defs/id" },
            "maturity": { "$ref": "#/$defs/id" }, "contract": { "$ref": "#/$defs/dottedId" },
            "contract_revision": { "type": "string", "minLength": 1 }
          }
        } }
      }
    },
    "capability_registry": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "owner", "state", "revision"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/dottedId" }, "owner": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/id" }, "revision": { "type": "string", "minLength": 1 }
      }
    } },
    "dirty_repositories": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "blockers": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["blocker_id", "condition", "resume_when"],
      "properties": { "blocker_id": { "$ref": "#/$defs/id" }, "condition": { "type": "string", "minLength": 1 }, "resume_when": { "type": "string", "minLength": 1 } }
    } },
    "validation_checkpoint": { "oneOf": [{ "type": "null" }, {
      "type": "object", "additionalProperties": false, "required": ["tier", "receipt", "result"],
      "properties": { "tier": { "enum": ["quick", "standard", "deep"] }, "receipt": { "type": "string", "minLength": 1 }, "result": { "enum": ["pass", "partial", "fail", "blocked"] } }
    }] },
    "pending_push_bundle": { "oneOf": [{ "type": "null" }, {
      "type": "object", "additionalProperties": false, "required": ["bundle_id", "unit_ids", "repo_ids", "ready"],
      "properties": {
        "bundle_id": { "$ref": "#/$defs/id" }, "unit_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "repo_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "ready": { "type": "boolean" }
      }
    }] }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "dottedId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,127}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
  }
}
