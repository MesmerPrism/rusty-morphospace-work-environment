{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/active-read-only-dependency-correction-v1.schema.json",
  "title": "Exact correction of active-unit read-only dependencies",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "correction_id",
    "project_id",
    "unit_id",
    "reason",
    "expected",
    "before",
    "after",
    "repository_identities",
    "does_not_prove"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema": { "const": "rusty.morphospace.workflow.active_read_only_dependency_correction.v1" },
    "correction_id": { "$ref": "#/$defs/shortId" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "reason": { "type": "string", "minLength": 1 },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "current_unit", "state_sha256", "unit_sha256", "events_sha256", "events_length", "event_tail_id"],
      "properties": {
        "status": { "const": "active" },
        "current_unit": { "$ref": "#/$defs/id" },
        "state_sha256": { "$ref": "#/$defs/hash" },
        "unit_sha256": { "$ref": "#/$defs/hash" },
        "events_sha256": { "$ref": "#/$defs/hash" },
        "events_length": { "type": "integer", "minimum": 1 },
        "event_tail_id": { "$ref": "#/$defs/id" }
      }
    },
    "before": { "$ref": "#/$defs/dependencies" },
    "after": { "$ref": "#/$defs/nonEmptyDependencies" },
    "repository_identities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/repositoryIdentity" }
    },
    "does_not_prove": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "shortId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitObject": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "paths", "purpose", "verification"],
      "properties": {
        "repo_id": { "$ref": "#/$defs/id" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "purpose": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "nonEmptyDependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "repositoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "revision", "tree", "role"],
      "properties": {
        "repo_id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/gitObject" },
        "tree": { "$ref": "#/$defs/gitObject" },
        "role": { "enum": ["exact-build-pin", "workspace-parse-only"] }
      }
    }
  }
}
