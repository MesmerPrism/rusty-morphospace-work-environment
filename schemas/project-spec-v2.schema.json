{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/project-spec-v2.schema.json",
  "title": "Rusty Morphospace project specification v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "project_id", "revision", "owner", "purpose", "activation_model",
    "composition", "authority_map", "repositories", "modules", "non_scope",
    "validation_profiles", "acceptance_profiles", "release_policy", "public_boundary"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "rusty.morphospace.workflow.project_spec.v2" },
    "project_id": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "activation_model": {
      "type": "object", "additionalProperties": false,
      "required": ["default", "unlisted_modules", "runtime_rule"],
      "properties": {
        "default": { "const": "disabled" },
        "unlisted_modules": { "const": "inert" },
        "runtime_rule": { "const": "selected-lock-and-runtime-input" }
      }
    },
    "composition": {
      "type": "object", "additionalProperties": false,
      "required": ["selected_features", "denied_features", "selected_modules", "denied_modules", "allowed_permissions", "denied_permissions", "data_classes"],
      "properties": {
        "selected_features": { "$ref": "#/$defs/ids" },
        "denied_features": { "$ref": "#/$defs/ids" },
        "selected_modules": { "$ref": "#/$defs/ids" },
        "denied_modules": { "$ref": "#/$defs/ids" },
        "allowed_permissions": { "$ref": "#/$defs/strings" },
        "denied_permissions": { "$ref": "#/$defs/strings" },
        "data_classes": { "$ref": "#/$defs/strings" }
      }
    },
    "authority_map": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["parameter", "owner", "adapters"],
        "properties": {
          "parameter": { "$ref": "#/$defs/dottedId" }, "owner": { "$ref": "#/$defs/id" },
          "adapters": { "$ref": "#/$defs/ids" }
        }
      }
    },
    "repositories": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["repo_id", "role", "path", "allowed_paths"],
        "properties": {
          "repo_id": { "$ref": "#/$defs/id" },
          "role": { "enum": ["application", "core", "adapter", "tool", "lab", "planning", "compatibility", "platform-test-harness"] },
          "path": { "type": "string", "minLength": 1 },
          "allowed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["module_id", "feature_id", "lane", "maturity", "contract", "contract_revision", "source_repo", "dependencies", "selected"],
        "properties": {
          "module_id": { "$ref": "#/$defs/id" }, "feature_id": { "$ref": "#/$defs/id" },
          "lane": { "$ref": "#/$defs/id" }, "maturity": { "$ref": "#/$defs/id" },
          "contract": { "$ref": "#/$defs/dottedId" }, "contract_revision": { "type": "string", "minLength": 1 },
          "source_repo": { "$ref": "#/$defs/id" }, "dependencies": { "$ref": "#/$defs/ids" },
          "selected": { "type": "boolean" }
        }
      }
    },
    "non_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "validation_profiles": { "$ref": "#/$defs/profiles" },
    "acceptance_profiles": { "$ref": "#/$defs/profiles" },
    "release_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["versioning", "commit_policy", "push_checkpoint", "source_first", "planning_last", "force_push_allowed"],
      "properties": {
        "versioning": { "enum": ["semver", "calendar", "private-revision"] },
        "commit_policy": { "type": "string", "minLength": 1 },
        "push_checkpoint": { "enum": ["none", "local-only", "integration-batch", "release"] },
        "source_first": { "const": true }, "planning_last": { "const": true }, "force_push_allowed": { "const": false }
      }
    },
    "public_boundary": {
      "type": "object", "additionalProperties": false, "required": ["mode", "private_overlay", "prohibited_evidence"],
      "properties": {
        "mode": { "enum": ["public", "private", "mixed"] }, "private_overlay": { "type": "string", "minLength": 1 },
        "prohibited_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "dottedId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,127}$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "profiles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["profile_id", "commands"],
        "properties": { "profile_id": { "$ref": "#/$defs/id" }, "commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
      }
    }
  }
}
