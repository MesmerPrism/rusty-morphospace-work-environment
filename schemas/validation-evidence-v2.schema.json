{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/validation-evidence-v2.schema.json",
  "title": "Owner-derived current-unit validation evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "evidence_id", "created_at", "project_id", "unit_id", "attempt_id",
    "action", "profile_id", "result", "validator_results", "device_validation",
    "does_not_prove"
  ],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.validation_evidence.v2" },
    "evidence_id": { "$ref": "#/$defs/id" },
    "created_at": { "$ref": "#/$defs/utc" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "attempt_id": { "$ref": "#/$defs/id" },
    "action": { "$ref": "#/$defs/actionReference" },
    "profile_id": { "$ref": "#/$defs/id" },
    "result": { "enum": ["pass", "fail", "blocked"] },
    "validator_results": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/validatorResult" }
    },
    "device_validation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/deviceValidation" }
      ]
    },
    "does_not_prove": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,191}$" },
    "dottedId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,191}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "typedReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 1 }, "schema": { "$ref": "#/$defs/dottedId" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "actionReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "const": "validation-action" }, "path": { "type": "string", "minLength": 1 }, "schema": { "const": "rusty.morphospace.workflow.validation_action.v2" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "validatorResult": {
      "type": "object", "additionalProperties": false,
      "required": [
        "validator_id", "owner_repo_id", "acceptance_ids", "status",
        "command_identity_sha256", "exit_code", "stdout_sha256", "stderr_sha256",
        "owner_evidence", "cleanroom_fingerprint_sha256", "input_closure_sha256"
      ],
      "properties": {
        "validator_id": { "$ref": "#/$defs/id" },
        "owner_repo_id": { "$ref": "#/$defs/id" },
        "acceptance_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "status": { "enum": ["pass", "fail", "blocked"] },
        "command_identity_sha256": { "$ref": "#/$defs/hash" },
        "exit_code": { "type": "integer" },
        "stdout_sha256": { "$ref": "#/$defs/hash" },
        "stderr_sha256": { "$ref": "#/$defs/hash" },
        "owner_evidence": { "$ref": "#/$defs/typedReference" },
        "cleanroom_fingerprint_sha256": { "$ref": "#/$defs/hash" },
        "input_closure_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "deviceCriterion": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "status", "evidence_ref"],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["pass", "fail", "blocked"] },
        "evidence_ref": { "$ref": "#/$defs/typedReference" }
      }
    },
    "deviceValidation": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "validator_id", "result", "owner_evidence", "device_count", "criteria"],
      "properties": {
        "policy_id": { "$ref": "#/$defs/id" },
        "validator_id": { "$ref": "#/$defs/id" },
        "result": { "enum": ["pass", "fail", "blocked"] },
        "owner_evidence": { "$ref": "#/$defs/typedReference" },
        "device_count": { "type": "integer", "minimum": 0 },
        "criteria": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/deviceCriterion" }
        }
      }
    }
  }
}
