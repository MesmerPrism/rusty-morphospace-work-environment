{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/affected-validation-registry-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry_id", "repository_id", "revision", "historical_aggregate", "dependency_declarations", "path_sets", "checks", "always_run_check_ids", "deep_escalation_path_sets", "claims"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.affected_validation_registry.v1" },
    "registry_id": { "$ref": "#/$defs/id" },
    "repository_id": { "type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
    "revision": { "type": "integer", "minimum": 1 },
    "historical_aggregate": { "type": "object", "additionalProperties": false, "required": ["tier", "reusable_evidence", "full_history_required"], "properties": { "tier": { "const": "deep" }, "reusable_evidence": { "const": false }, "full_history_required": { "const": true } } },
    "dependency_declarations": {
      "type": "array", "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["importer", "variable", "count", "target_paths"],
            "properties": {
              "importer": { "$ref": "#/$defs/scriptPath" },
              "variable": { "$ref": "#/$defs/variable" },
              "count": { "type": "integer", "minimum": 1, "maximum": 256 },
              "target_paths": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/scriptPath" } }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["importer", "variable", "count", "classification"],
            "properties": {
              "importer": { "$ref": "#/$defs/scriptPath" },
              "variable": { "$ref": "#/$defs/variable" },
              "count": { "type": "integer", "minimum": 1, "maximum": 256 },
              "classification": { "const": "authenticated-external-command" }
            }
          }
        ]
      }
    },
    "path_sets": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path_set_id", "patterns"],
        "properties": {
          "path_set_id": { "$ref": "#/$defs/id" },
          "patterns": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/pattern" } }
        }
      }
    },
    "checks": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["check_id", "command_path", "arguments", "platforms", "minimum_tier", "trigger_path_sets", "consume_path_sets", "prerequisite_checks", "provides_contracts", "consumes_contracts", "always_run", "authority_class", "cache_policy", "budget_seconds", "external_state"],
        "properties": {
          "check_id": { "$ref": "#/$defs/id" },
          "command_path": { "$ref": "#/$defs/path" },
          "arguments": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 512 } },
          "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["windows", "linux"] } },
          "minimum_tier": { "enum": ["quick", "standard", "deep"] },
          "trigger_path_sets": { "$ref": "#/$defs/idArray" },
          "consume_path_sets": { "$ref": "#/$defs/idArray" },
          "prerequisite_checks": { "$ref": "#/$defs/idArray" },
          "execution_after_checks": { "$ref": "#/$defs/idArray" },
          "provides_contracts": { "$ref": "#/$defs/idArray" },
          "consumes_contracts": { "$ref": "#/$defs/idArray" },
          "always_run": { "type": "boolean" },
          "authority_class": { "enum": ["ordinary", "integration", "trust-root"] },
          "cache_policy": { "enum": ["disabled", "exact-host", "portable"] },
          "budget_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
          "external_state": { "enum": ["none", "remote", "device", "attended"] },
          "aggregate_role": { "const": "work-environment-deep-v1" }
        }
      }
    },
    "always_run_check_ids": { "$ref": "#/$defs/idArray" },
    "deep_escalation_path_sets": { "$ref": "#/$defs/idArray" },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["selection_only", "executes_checks", "acceptance_authority", "publication_authority"],
      "properties": {
        "selection_only": { "const": true },
        "executes_checks": { "const": false },
        "acceptance_authority": { "const": false },
        "publication_authority": { "const": false }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$" },
    "idArray": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/id" } },
    "path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\\\:]+$" },
    "scriptPath": { "type": "string", "minLength": 12, "maxLength": 512, "pattern": "^scripts/[^\\\\:]+\\.ps(?:m)?1$" },
    "variable": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z_][A-Za-z0-9_:.-]*$" },
    "pattern": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\\\:]+$" }
  }
}
