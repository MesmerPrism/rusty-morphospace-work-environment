{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/prepared-push-retirement-v1.schema.json",
  "title": "Prepared push retirement receipt",
  "description": "Additive evidence for retiring one exact unexecuted prepared push bundle. The receipt makes no historical non-publication claim and authorizes no Git or remote mutation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "retirement_id", "project_id", "bundle_id", "unit_ids", "reason", "repository_map_sha256",
    "prepared_plan", "prepared_event", "pending_bundle", "stale_blocker", "observed_at", "repositories",
    "evidence_search", "claims", "mutation"
  ],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.prepared_push_retirement.v1" },
    "retirement_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "bundle_id": { "$ref": "#/$defs/id" },
    "unit_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "reason": { "enum": ["superseded", "obsolete-composition", "reprepared"] },
    "repository_map_sha256": { "$ref": "#/$defs/hash" },
    "prepared_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["container", "member"],
      "properties": {
        "container": { "$ref": "#/$defs/file" },
        "member": { "const": "push_plan" }
      }
    },
    "prepared_event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "intent", "completion", "member"],
      "properties": {
        "event_id": { "$ref": "#/$defs/id" },
        "intent": { "$ref": "#/$defs/file" },
        "completion": { "$ref": "#/$defs/file" },
        "member": { "const": "event" }
      }
    },
    "pending_bundle": { "$ref": "#/$defs/canonicalObject" },
    "stale_blocker": { "$ref": "#/$defs/canonicalObject" },
    "observed_at": { "type": "string", "format": "date-time" },
    "repositories": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "repo_id", "role", "branch", "upstream", "prepared_revision",
          "local_head", "remote_readback_revision", "worktree_clean",
          "detached", "ahead", "behind", "diverged", "remote_fetch_identity", "remote_push_identity"
        ],
        "properties": {
          "repo_id": { "$ref": "#/$defs/id" },
          "role": { "enum": ["application", "adapter", "source", "planning"] },
          "branch": { "type": "string", "minLength": 1 },
          "upstream": { "type": "string", "minLength": 1 },
          "prepared_revision": { "$ref": "#/$defs/revision" },
          "local_head": { "$ref": "#/$defs/revision" },
          "remote_readback_revision": { "$ref": "#/$defs/revision" },
          "worktree_clean": { "const": true },
          "detached": { "const": false },
          "ahead": { "type": "integer", "minimum": 0 },
          "behind": { "const": 0 },
          "diverged": { "const": false },
          "remote_fetch_identity": { "$ref": "#/$defs/hash" },
          "remote_push_identity": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "evidence_search": {
      "type": "object", "additionalProperties": false,
      "required": ["workspace_relative_roots", "recognized_binding_count", "complete"],
      "properties": {
        "workspace_relative_roots": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": { "enum": ["receipts", "iteration-events.jsonl"] },
          "allOf": [{ "contains": { "const": "receipts" } }, { "contains": { "const": "iteration-events.jsonl" } }]
        },
        "recognized_binding_count": { "const": 0 },
        "complete": { "const": true }
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": [
        "workflow_recognized_execution_or_publication_asserted",
        "historical_publication_impossible",
        "remote_mutation_performed"
      ],
      "properties": {
        "workflow_recognized_execution_or_publication_asserted": { "const": false },
        "historical_publication_impossible": { "const": false },
        "remote_mutation_performed": { "const": false }
      }
    },
    "mutation": {
      "type": "object", "additionalProperties": false,
      "required": ["pending_bundle_consumed", "blocker_id"],
      "properties": {
        "pending_bundle_consumed": { "const": true },
        "blocker_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "canonicalObject": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "sha256"],
      "properties": { "value": { "type": "object" }, "sha256": { "$ref": "#/$defs/hash" } }
    }
  }
}
