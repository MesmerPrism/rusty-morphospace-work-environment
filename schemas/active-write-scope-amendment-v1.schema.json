{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/active-write-scope-amendment-v1.schema.json",
  "title": "Additive active feature-unit write-scope amendment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "amendment_id",
    "project_id",
    "unit_id",
    "repository_id",
    "reason",
    "expected",
    "before_allowed_paths",
    "after_allowed_paths",
    "does_not_prove"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema": { "const": "rusty.morphospace.workflow.active_write_scope_amendment.v1" },
    "amendment_id": { "$ref": "#/$defs/shortId" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "repository_id": { "$ref": "#/$defs/id" },
    "reason": { "type": "string", "minLength": 1 },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "current_unit",
        "project_revision",
        "project_sha256",
        "state_sha256",
        "unit_sha256",
        "events_sha256",
        "events_length",
        "event_tail_id"
      ],
      "properties": {
        "status": { "const": "active" },
        "current_unit": { "$ref": "#/$defs/id" },
        "project_revision": { "type": "integer", "minimum": 1 },
        "project_sha256": { "$ref": "#/$defs/hash" },
        "state_sha256": { "$ref": "#/$defs/hash" },
        "unit_sha256": { "$ref": "#/$defs/hash" },
        "events_sha256": { "$ref": "#/$defs/hash" },
        "events_length": { "type": "integer", "minimum": 1 },
        "event_tail_id": { "$ref": "#/$defs/id" }
      }
    },
    "before_allowed_paths": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "after_allowed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "does_not_prove": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "shortId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1 }
  }
}
