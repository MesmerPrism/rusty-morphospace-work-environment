{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/source-materialization-receipt.schema.json",
  "title": "Exact source composition materialization receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "materialization_id", "created_at", "lock", "root", "repositories", "status"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.source_materialization_receipt.v1" },
    "materialization_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "lock": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "fingerprint"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/hash" }, "fingerprint": { "$ref": "#/$defs/hash" } }
    },
    "root": { "type": "string", "minLength": 1 },
    "repositories": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["repo_id", "path", "commit", "tree", "detached", "clean"],
      "properties": { "repo_id": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "commit": { "$ref": "#/$defs/oid" }, "tree": { "$ref": "#/$defs/oid" }, "detached": { "const": true }, "clean": { "const": true } }
    } },
    "status": { "const": "materialized" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
}
