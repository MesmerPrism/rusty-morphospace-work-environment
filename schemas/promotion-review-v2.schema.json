{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/promotion-review-v2.schema.json",
  "title": "Rusty Morphospace module promotion review v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "review_id", "candidate_id", "module_id", "from_maturity", "target_maturity", "decision", "extraction_receipt", "gates", "review_summary", "rollback_verified"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "rusty.morphospace.workflow.promotion_review.v2" },
    "review_id": { "$ref": "#/$defs/id" },
    "candidate_id": { "$ref": "#/$defs/id" },
    "module_id": { "$ref": "#/$defs/id" },
    "from_maturity": { "$ref": "#/$defs/id" },
    "target_maturity": { "$ref": "#/$defs/id" },
    "decision": { "enum": ["accepted", "rework", "rejected"] },
    "extraction_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "source_composition_fingerprint"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "source_composition_fingerprint": { "$ref": "#/$defs/hash" }
      }
    },
    "gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gate_id", "result", "evidence"],
        "properties": {
          "gate_id": { "$ref": "#/$defs/id" },
          "result": { "enum": ["pass", "partial", "fail", "blocked"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "review_summary": { "type": "string", "minLength": 1 },
    "rollback_verified": { "type": "boolean" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
