{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/active-unit-retirement-receipt-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "retirement_id",
    "project_id",
    "unit_id",
    "replacement_unit_id",
    "reason",
    "timestamp",
    "transaction_id",
    "request",
    "old_unit",
    "source_composition",
    "ownership",
    "repositories",
    "accepted_receipt",
    "accepted",
    "source_mutation_performed"
  ],
  "properties": {
    "schema": {
      "const": "rusty.morphospace.workflow.active_unit_retirement_receipt.v2"
    },
    "retirement_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"
    },
    "replacement_unit_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"
    },
    "reason": {
      "const": "scope-replanned"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+-active-retired-transition$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./-]+\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "old_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "path",
        "status",
        "raw_sha256",
        "canonical_sha256"
      ],
      "properties": {
        "unit_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"
        },
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./-]+\\.json$"
        },
        "status": {
          "const": "active"
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "canonical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "raw_sha256",
        "canonical_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./-]+\\.json$"
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "canonical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo_id",
          "head",
          "tree",
          "branch",
          "clean"
        ],
        "properties": {
          "repo_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"
          },
          "head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "tree": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "clean": {
            "const": true
          }
        }
      }
    },
    "accepted_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./-]+\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "accepted": {
      "const": false
    },
    "source_mutation_performed": {
      "const": false
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "root_unit_id",
        "root_admission",
        "root_claim",
        "agent_scope_assessment_sha256",
        "repository_map",
        "repository_maps",
        "validation_attempts",
        "supersessions"
      ],
      "properties": {
        "kind": {
          "const": "supersession"
        },
        "root_unit_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
        },
        "root_admission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "raw_sha256",
            "canonical_sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9./-]+\\.json$"
            },
            "raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "canonical_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "root_claim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_id",
            "transaction_id",
            "intent_sha256",
            "completion_sha256"
          ],
          "properties": {
            "event_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]+-claimed-[0-9]{4,}$"
            },
            "transaction_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]+-transition$"
            },
            "intent_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "completion_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "agent_scope_assessment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "repository_map": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "raw_sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9./-]+\\.json$"
            },
            "raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "repository_maps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "raw_sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9./-]+\\.json$"
              },
              "raw_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "validation_attempts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "path",
              "raw_sha256",
              "canonical_sha256"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]+-validation-(fail|partial|blocked)-return-[0-9]{4,}$"
              },
              "path": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9./-]+\\.json$"
              },
              "raw_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "canonical_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "supersessions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "old_unit_id",
              "replacement_unit_id",
              "event_id",
              "transaction_id",
              "intent_sha256",
              "completion_sha256",
              "request",
              "receipt"
            ],
            "properties": {
              "old_unit_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
              },
              "replacement_unit_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
              },
              "event_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,191}$"
              },
              "transaction_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]+-transition$"
              },
              "intent_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "completion_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9./-]+\\.json$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "receipt": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9./-]+\\.json$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
