{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/unpublished-planning-authority-receipt-v1.schema.json",
  "title": "Unpublished planning authority materialization receipt",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "materialization_id", "project_id", "recorded_at", "status", "input", "source", "planning", "destination_inventory", "route_eligibility", "authority", "limitations"],
  "properties": {
    "$schema": { "type": "string" }, "schema": { "const": "rusty.morphospace.workflow.unpublished_planning_authority_receipt.v1" },
    "materialization_id": { "$ref": "#/$defs/id" }, "project_id": { "$ref": "#/$defs/id" }, "recorded_at": { "type": "string", "format": "date-time" }, "status": { "const": "materialized-and-read-back" },
    "input": { "type": "object", "additionalProperties": false, "required": ["schema", "sha256"], "properties": { "schema": { "const": "rusty.morphospace.workflow.unpublished_workspace_materialization.v1" }, "sha256": { "$ref": "#/$defs/hash" } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["repo_id", "head", "tree", "branch", "workspace_path", "inventory_sha256", "state_anchor"], "properties": { "repo_id": { "$ref": "#/$defs/id" }, "head": { "$ref": "#/$defs/oid" }, "tree": { "$ref": "#/$defs/oid" }, "branch": { "$ref": "#/$defs/branch" }, "workspace_path": { "const": "morphospace" }, "inventory_sha256": { "$ref": "#/$defs/hash" }, "state_anchor": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "const": "workspace.state.json" }, "sha256": { "$ref": "#/$defs/hash" } } } } },
    "planning": { "type": "object", "additionalProperties": false, "required": ["repo_id", "base_commit", "base_tree", "branch", "destination_workspace_path", "receipt_path"], "properties": { "repo_id": { "$ref": "#/$defs/id" }, "base_commit": { "$ref": "#/$defs/oid" }, "base_tree": { "$ref": "#/$defs/oid" }, "branch": { "$ref": "#/$defs/branch" }, "destination_workspace_path": { "$ref": "#/$defs/path" }, "receipt_path": { "$ref": "#/$defs/path" } } },
    "destination_inventory": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "type": "object", "additionalProperties": false, "required": ["ordinal", "path", "type", "size", "sha256"], "properties": { "ordinal": { "type": "integer", "minimum": 0, "maximum": 511 }, "path": { "type": "string", "minLength": 1, "maxLength": 512 }, "type": { "const": "file" }, "size": { "type": "integer", "minimum": 0, "maximum": 4194304 }, "sha256": { "$ref": "#/$defs/hash" } } } },
    "route_eligibility": { "type": "object", "additionalProperties": false, "required": ["workspace_scope", "state_anchor", "source_path_dirty", "pinned_tree_inventory_equal", "planning_workspace_projection_applicable"], "properties": { "workspace_scope": { "const": "repository-root-morphospace" }, "state_anchor": { "const": "workspace.state.json" }, "source_path_dirty": { "const": true }, "pinned_tree_inventory_equal": { "const": false }, "planning_workspace_projection_applicable": { "const": false } } },
    "authority": { "type": "object", "additionalProperties": false, "required": ["destination_workspace", "source_workspace", "source_bytes_preserved", "git_mutation_performed"], "properties": { "destination_workspace": { "const": "sole-workspace-authority" }, "source_workspace": { "const": "preserved-historical-non-authoritative" }, "source_bytes_preserved": { "const": true }, "git_mutation_performed": { "const": false } } },
    "limitations": { "type": "object", "additionalProperties": false, "required": ["ordinary_admission_required", "publication_projection", "does_not_claim"], "properties": { "ordinary_admission_required": { "const": true }, "publication_projection": { "const": "not-applicable" }, "does_not_claim": { "type": "array", "minItems": 6, "items": { "type": "string" } } } }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" }, "oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "branch": { "type": "string", "pattern": "^(?!HEAD$)[^\\s~^:?*\\[\\]\\\\]+(?:/[^\\s~^:?*\\[\\]\\\\]+)*$" }, "path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))[^:]+$" } }
}
