{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/historical-validation-debt-baseline-authorization-v1.schema.json",
  "title": "External-owner historical validation-debt baseline authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "payload", "signature"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.historical_validation_debt_baseline_authorization.v1" },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema", "issuer_id", "authorization_id", "audit_id", "project_id", "baseline_id",
        "baseline_sha256", "validator_identity_sha256", "workspace_anchor_sha256",
        "source_composition_sha256", "current_unit_sha256", "failure_set_sha256", "failure_count",
        "issued_at", "expires_at", "decision", "limitations"
      ],
      "properties": {
        "schema": { "const": "rusty.morphospace.workflow.historical_validation_debt_baseline_authorization_payload.v1" },
        "issuer_id": { "$ref": "#/$defs/id" },
        "authorization_id": { "$ref": "#/$defs/longId" },
        "audit_id": { "$ref": "#/$defs/longId" },
        "project_id": { "$ref": "#/$defs/id" },
        "baseline_id": { "$ref": "#/$defs/longId" },
        "baseline_sha256": { "$ref": "#/$defs/hash" },
        "validator_identity_sha256": { "$ref": "#/$defs/hash" },
        "workspace_anchor_sha256": { "$ref": "#/$defs/hash" },
        "source_composition_sha256": { "$ref": "#/$defs/hash" },
        "current_unit_sha256": { "$ref": "#/$defs/hash" },
        "failure_set_sha256": { "$ref": "#/$defs/hash" },
        "failure_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "issued_at": { "$ref": "#/$defs/secondsUtc" },
        "expires_at": { "$ref": "#/$defs/secondsUtc" },
        "decision": { "const": "authorize-historical-validation-debt-baseline" },
        "limitations": {
          "const": [
            "historical_debt_remains_unresolved=true",
            "current_unit_validation_authority=false",
            "acceptance_authority=false",
            "source_or_workspace_mutation_authority=false"
          ]
        }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "public_key_spki_sha256", "value_base64"],
      "properties": {
        "algorithm": { "const": "RSA-PSS-SHA256" },
        "public_key_spki_sha256": { "$ref": "#/$defs/hash" },
        "value_base64": { "type": "string", "minLength": 128, "maxLength": 2048, "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "longId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,127}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "secondsUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  }
}
