{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/external-validation-authority-policy-v1.schema.json",
  "title": "External validation authority policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "repository",
    "mandatory_protected_paths",
    "protected_rules",
    "approved_change_sets",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "rusty.morphospace.workflow.external_validation_authority_policy.v1"
    },
    "policy_id": {
      "$ref": "#/$defs/id"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
    },
    "mandatory_protected_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "protected_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/protectedRule"
      }
    },
    "approved_change_sets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/approvedChangeSet"
      }
    },
    "status": {
      "const": "active"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "objectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\\\\\u0000-\\u001f\\u007f]+$"
    },
    "protectedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "match",
        "path"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/id"
        },
        "match": {
          "enum": [
            "exact",
            "prefix"
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "artifact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "state",
            "mode",
            "size_bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "state": {
              "const": "present"
            },
            "mode": {
              "enum": [
                "100644",
                "100755"
              ]
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777216
            },
            "sha256": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "state"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "state": {
              "const": "absent"
            }
          }
        }
      ]
    },
    "approvedChangeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "required_ancestor",
        "changed_paths",
        "artifacts",
        "status"
      ],
      "properties": {
        "approval_id": {
          "$ref": "#/$defs/id"
        },
        "required_ancestor": {
          "$ref": "#/$defs/objectId"
        },
        "changed_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "status": {
          "const": "approved"
        }
      }
    }
  }
}
