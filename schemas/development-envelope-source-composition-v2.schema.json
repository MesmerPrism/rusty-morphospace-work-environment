{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/development-envelope-source-composition-v2.schema.json",
  "title":"Recovery preparation source composition lock",
  "type":"object","additionalProperties":false,
  "required":["schema","lock_id","preparation_id","project_id","fingerprint","repositories","status","does_not_prove"],
  "properties":{
    "schema":{"const":"rusty.morphospace.workflow.development_envelope_source_composition.v2"},
    "lock_id":{"$ref":"#/$defs/id"},"preparation_id":{"$ref":"#/$defs/id"},"project_id":{"$ref":"#/$defs/id"},"fingerprint":{"$ref":"#/$defs/hash"},
    "repositories":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["repo_id","role","commit","tree","branch","materialization_path","workspace_prefix","worktree_state","workflow_owned_dirt"],"properties":{"repo_id":{"$ref":"#/$defs/id"},"role":{"enum":["source","planning"]},"commit":{"$ref":"#/$defs/revision"},"tree":{"$ref":"#/$defs/revision"},"branch":{"type":["string","null"]},"materialization_path":{"type":"string","pattern":"^[A-Za-z0-9._-]+$"},"workspace_prefix":{"oneOf":[{"type":"string","pattern":"^(?:[A-Za-z0-9._-]+/)+$"},{"type":"string","maxLength":0},{"type":"null"}]},"worktree_state":{"enum":["clean","workflow-owned-dirt"]},"workflow_owned_dirt":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/dirt"}}}}},
    "status":{"const":"locked"},"does_not_prove":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  },
  "$defs":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{1,127}$"},"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},"dirt":{"type":"object","additionalProperties":false,"required":["path","status","sha256"],"properties":{"path":{"$ref":"#/$defs/path"},"status":{"pattern":"^[ MARC?][ MD?]$"},"sha256":{"$ref":"#/$defs/hash"}}}}
}
