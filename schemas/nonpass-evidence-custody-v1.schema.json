{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/nonpass-evidence-custody-v1.schema.json",
  "title": "Immutable NONPASS raw evidence custody",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "unit_id", "receipt_id", "receipt_path", "artifacts"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.nonpass_evidence_custody.v1" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "receipt_id": { "$ref": "#/$defs/id" },
    "receipt_path": { "type": "string", "pattern": "^receipts/[a-zA-Z0-9][a-zA-Z0-9._-]*\\.json$" },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "kind", "original_path", "snapshot_path", "sha256", "byte_length"],
        "properties": {
          "artifact_id": { "$ref": "#/$defs/id" },
          "kind": { "$ref": "#/$defs/id" },
          "original_path": { "type": "string", "minLength": 1 },
          "snapshot_path": { "type": "string", "pattern": "^receipts/[a-z0-9][a-z0-9-]{1,127}-evidence/[0-9]{4,}-[a-z0-9][a-z0-9-]{1,127}\\.bin$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "byte_length": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" } }
}
