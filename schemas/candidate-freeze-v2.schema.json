{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/candidate-freeze-v2.schema.json",
  "title": "Rematerialized immutable development candidate closure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "freeze_id", "project_id", "unit_id", "expected", "final_repositories", "changed_paths", "cleanliness_policy", "instruction_surfaces", "feature_lock", "effects", "permissions", "device_use", "test_matrix", "cleanup_evidence", "source_composition", "lineage", "does_not_prove"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.candidate_freeze.v2" },
    "freeze_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_sha256", "project_raw_sha256", "state_sha256", "state_raw_sha256", "unit_sha256", "unit_raw_sha256", "feature_lock_sha256", "feature_lock_raw_sha256", "source_composition_path", "source_composition_sha256", "repository_map_path", "repository_map_sha256", "repository_map_canonical_sha256", "events_sha256", "events_length", "event_tail_id"],
      "properties": {
        "project_sha256": { "$ref": "#/$defs/hash" },
        "project_raw_sha256": { "$ref": "#/$defs/hash" },
        "state_sha256": { "$ref": "#/$defs/hash" },
        "state_raw_sha256": { "$ref": "#/$defs/hash" },
        "unit_sha256": { "$ref": "#/$defs/hash" },
        "unit_raw_sha256": { "$ref": "#/$defs/hash" },
        "feature_lock_sha256": { "$ref": "#/$defs/hash" },
        "feature_lock_raw_sha256": { "$ref": "#/$defs/hash" },
        "source_composition_path": { "$ref": "#/$defs/path" },
        "source_composition_sha256": { "$ref": "#/$defs/hash" },
        "repository_map_path": { "$ref": "#/$defs/path" },
        "repository_map_sha256": { "$ref": "#/$defs/hash" },
        "repository_map_canonical_sha256": { "$ref": "#/$defs/hash" },
        "events_sha256": { "$ref": "#/$defs/hash" },
        "events_length": { "type": "integer", "minimum": 1 },
        "event_tail_id": { "$ref": "#/$defs/id" }
      }
    },
    "final_repositories": { "$ref": "#/$defs/repositorySet" },
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo_id", "paths"],
        "properties": {
          "repo_id": { "$ref": "#/$defs/id" },
          "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }
        }
      }
    },
    "cleanliness_policy": { "const": "clean-only" },
    "instruction_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "disposition"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["updated", "reviewed-no-change", "not-applicable"] }
        }
      }
    },
    "feature_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "sha256"],
      "properties": { "revision": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "effects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "permissions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "device_use": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "test_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "command"],
        "properties": { "test_id": { "$ref": "#/$defs/id" }, "command": { "type": "string", "minLength": 1 } }
      }
    },
    "cleanup_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "source_composition": { "$ref": "#/$defs/pathHash" },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rematerialization_id", "predecessor_freeze", "predecessor_source_composition", "predecessor_final_repositories", "invalidated_normal_validation_selection", "repositories", "repository_head_projections", "target_source_composition"],
      "properties": {
        "rematerialization_id": { "type": "string", "minLength": 2, "maxLength": 119, "pattern": "^[a-z0-9][a-z0-9-]{1,118}$" },
        "predecessor_freeze": {
          "type": "object",
          "additionalProperties": false,
          "required": ["freeze_id", "receipt_path", "receipt_sha256"],
          "properties": {
            "freeze_id": { "$ref": "#/$defs/id" },
            "receipt_path": { "$ref": "#/$defs/receiptPath" },
            "receipt_sha256": { "$ref": "#/$defs/hash" }
          }
        },
        "predecessor_source_composition": { "$ref": "#/$defs/pathHash" },
        "predecessor_final_repositories": { "$ref": "#/$defs/repositorySet" },
        "invalidated_normal_validation_selection": { "$ref": "#/$defs/normalValidationSelection" },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo_id", "role", "source_baseline_commit", "source_baseline_tree", "predecessor_commit", "predecessor_tree", "target_commit", "target_tree", "carried_paths"],
            "properties": {
              "repo_id": { "$ref": "#/$defs/id" },
              "role": { "enum": ["source", "planning"] },
              "source_baseline_commit": { "$ref": "#/$defs/oid" },
              "source_baseline_tree": { "$ref": "#/$defs/oid" },
              "predecessor_commit": { "$ref": "#/$defs/oid" },
              "predecessor_tree": { "$ref": "#/$defs/oid" },
              "target_commit": { "$ref": "#/$defs/oid" },
              "target_tree": { "$ref": "#/$defs/oid" },
              "carried_paths": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "predecessor_blob", "target_blob"],
                  "properties": {
                    "path": { "$ref": "#/$defs/path" },
                    "predecessor_blob": { "$ref": "#/$defs/oid" },
                    "target_blob": { "$ref": "#/$defs/oid" }
                  }
                }
              }
            }
          }
        },
        "repository_head_projections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo_id", "predecessor", "target"],
            "properties": {
              "repo_id": { "$ref": "#/$defs/id" },
              "predecessor": { "$ref": "#/$defs/repositoryHead" },
              "target": { "$ref": "#/$defs/repositoryHead" }
            }
          }
        },
        "target_source_composition": { "$ref": "#/$defs/pathHash" }
      }
    },
    "does_not_prove": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*/?$" },
    "receiptPath": { "type": "string", "pattern": "^receipts/[a-z0-9][a-z0-9-]{1,127}\\.json$" },
    "pathHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "repositorySet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo_id", "commit", "tree"],
        "properties": { "repo_id": { "$ref": "#/$defs/id" }, "commit": { "$ref": "#/$defs/oid" }, "tree": { "$ref": "#/$defs/oid" } }
      }
    },
    "repositoryHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "branch", "dirty_fingerprint"],
      "properties": {
        "head": { "$ref": "#/$defs/oid" },
        "branch": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "dirty_fingerprint": { "$ref": "#/$defs/hash" }
      }
    },
    "normalValidationSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "unit_raw_sha256", "unit_contract_sha256", "tier", "selector_id", "selector_path", "selector_sha256", "evidence_path_sha256"],
      "properties": {
        "unit_id": { "$ref": "#/$defs/id" },
        "unit_raw_sha256": { "$ref": "#/$defs/hash" },
        "unit_contract_sha256": { "$ref": "#/$defs/hash" },
        "tier": { "const": "quick" },
        "selector_id": { "$ref": "#/$defs/id" },
        "selector_path": { "type": "string", "pattern": "^validation-authority/selectors/[a-z0-9][a-z0-9-]{1,127}\\.json$" },
        "selector_sha256": { "$ref": "#/$defs/hash" },
        "evidence_path_sha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
