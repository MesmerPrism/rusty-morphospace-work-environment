{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact current-work declared-tier evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_id",
    "unit_id",
    "tier",
    "workspace_root",
    "selection",
    "project_raw_sha256",
    "declared_command_sha256",
    "freeze_receipt_sha256",
    "frozen_repositories",
    "tooling_context",
    "executor_commit",
    "executor_tree",
    "executed_command",
    "terminal",
    "result",
    "does_not_authorize"
  ],
  "properties": {
    "schema": {
      "const": "rusty.morphospace.workflow.current_validation_evidence.v1"
    },
    "project_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "tier": {
      "enum": [
        "quick",
        "standard",
        "deep"
      ]
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "unit_raw_sha256",
        "unit_contract_sha256",
        "tier",
        "selector_id",
        "selector_path",
        "selector_sha256",
        "evidence_path_sha256"
      ],
      "properties": {
        "unit_id": {
          "$ref": "#/$defs/id"
        },
        "unit_raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "unit_contract_sha256": {
          "$ref": "#/$defs/hash"
        },
        "tier": {
          "enum": [
            "quick",
            "standard",
            "deep"
          ]
        },
        "selector_id": {
          "$ref": "#/$defs/id"
        },
        "selector_path": {
          "type": "string",
          "pattern": "^validation-authority/selectors/[a-z0-9][a-z0-9-]{1,127}\\.json$"
        },
        "selector_sha256": {
          "$ref": "#/$defs/hash"
        },
        "evidence_path_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "project_raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "declared_command_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "freeze_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frozen_repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo_id",
          "commit",
          "tree"
        ],
        "properties": {
          "repo_id": {
            "$ref": "#/$defs/id"
          },
          "commit": {
            "$ref": "#/$defs/git_sha1"
          },
          "tree": {
            "$ref": "#/$defs/git_sha1"
          }
        }
      }
    },
    "tooling_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "canonical_sha256",
        "protocol_id"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^tooling-contexts/[a-z0-9][a-z0-9-]{1,127}\\.json$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "protocol_id": {
          "const": "tooling-context-v1"
        }
      }
    },
    "executor_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "executor_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "executed_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "arguments"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 13,
          "maxItems": 13
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "capture"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Status",
            "ExitCode",
            "Streams",
            "ChildProcess"
          ],
          "properties": {
            "Status": {
              "enum": [
                "passed",
                "failed",
                "cancelled"
              ]
            },
            "ExitCode": {
              "type": "integer"
            },
            "Streams": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "captured",
                "stdout",
                "stderr"
              ],
              "properties": {
                "captured": {
                  "type": "boolean"
                },
                "stdout": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256",
                    "size_bytes",
                    "drained_bytes",
                    "stored_bytes",
                    "eof",
                    "storage_error",
                    "read_error"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "drained_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "stored_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "eof": {
                      "type": "boolean"
                    },
                    "storage_error": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "read_error": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "stderr": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256",
                    "size_bytes",
                    "drained_bytes",
                    "stored_bytes",
                    "eof",
                    "storage_error",
                    "read_error"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "drained_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "stored_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "eof": {
                      "type": "boolean"
                    },
                    "storage_error": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "read_error": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            },
            "ChildProcess": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "started",
                "termination_requested",
                "automatic_retry",
                "process_reaped",
                "stdout_eof",
                "stderr_eof",
                "raw_capture_complete",
                "outcome",
                "estimated_warning_seconds",
                "elapsed_milliseconds",
                "cancellation",
                "warning_count",
                "warning_publication_failures",
                "observer_errors",
                "exit_code"
              ],
              "properties": {
                "started": {
                  "type": "boolean"
                },
                "termination_requested": {
                  "type": "boolean"
                },
                "automatic_retry": {
                  "type": "boolean"
                },
                "process_reaped": {
                  "type": "boolean"
                },
                "stdout_eof": {
                  "type": "boolean"
                },
                "stderr_eof": {
                  "type": "boolean"
                },
                "raw_capture_complete": {
                  "type": "boolean"
                },
                "outcome": {
                  "enum": [
                    "passed",
                    "failed",
                    "cancelled"
                  ]
                },
                "estimated_warning_seconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "elapsed_milliseconds": {
                  "type": "integer",
                  "minimum": 0
                },
                "cancellation": {
                  "enum": [
                    "not-requested",
                    "console-cancel",
                    "test-cancel"
                  ]
                },
                "warning_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "warning_publication_failures": {
                  "type": "integer",
                  "minimum": 0
                },
                "observer_errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "exit_code": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "does_not_authorize": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
