{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/terminal-validation-selection-release-v2.schema.json",
  "title": "Release of a stale selector for an admitted blocked-unit successor",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "release_id", "created_at", "project_id", "successor", "terminal", "selector_evidence_verified", "selector_evidence_reused", "does_not_authorize"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.terminal_validation_selection_release.v2" },
    "release_id": { "$ref": "#/$defs/id" }, "created_at": { "type": "string", "format": "date-time" }, "project_id": { "$ref": "#/$defs/id" },
    "successor": { "type": "object", "additionalProperties": false, "required": ["unit_id", "path", "raw_sha256", "canonical_sha256", "admission_id", "admission_receipt_path", "admission_receipt_sha256", "terminal_binding_sha256"], "properties": { "unit_id": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/path" }, "raw_sha256": { "$ref": "#/$defs/hash" }, "canonical_sha256": { "$ref": "#/$defs/hash" }, "admission_id": { "$ref": "#/$defs/id" }, "admission_receipt_path": { "$ref": "#/$defs/path" }, "admission_receipt_sha256": { "$ref": "#/$defs/hash" }, "terminal_binding_sha256": { "$ref": "#/$defs/hash" } } },
    "terminal": {
      "type": "object", "additionalProperties": false, "required": ["binding", "preparation", "admission"],
      "properties": {
        "binding": {
          "type": "object", "additionalProperties": false,
          "required": ["unit_id", "unit_path", "unit_raw_sha256", "unit_canonical_sha256", "candidate_freeze", "selector_binding_sha256", "checkpoint", "blocker_sha256", "event_id", "event_sha256", "transaction"],
          "properties": {
            "unit_id": { "$ref": "#/$defs/id" }, "unit_path": { "$ref": "#/$defs/path" }, "unit_raw_sha256": { "$ref": "#/$defs/hash" }, "unit_canonical_sha256": { "$ref": "#/$defs/hash" },
            "candidate_freeze": { "type": "object", "additionalProperties": false, "required": ["freeze_id", "receipt_path", "receipt_sha256"], "properties": { "freeze_id": { "$ref": "#/$defs/id" }, "receipt_path": { "$ref": "#/$defs/path" }, "receipt_sha256": { "$ref": "#/$defs/hash" } } },
            "selector_binding_sha256": { "$ref": "#/$defs/hash" },
            "checkpoint": { "type": "object", "additionalProperties": false, "required": ["tier", "result", "receipt_path", "receipt_sha256"], "properties": { "tier": { "const": "standard" }, "result": { "enum": ["partial", "fail", "blocked"] }, "receipt_path": { "$ref": "#/$defs/path" }, "receipt_sha256": { "$ref": "#/$defs/hash" } } },
            "blocker_sha256": { "$ref": "#/$defs/hash" }, "event_id": { "$ref": "#/$defs/id" }, "event_sha256": { "$ref": "#/$defs/hash" },
            "transaction": { "type": "object", "additionalProperties": false, "required": ["transaction_id", "intent_path", "intent_sha256", "completion_path", "completion_sha256"], "properties": { "transaction_id": { "$ref": "#/$defs/id" }, "intent_path": { "$ref": "#/$defs/path" }, "intent_sha256": { "$ref": "#/$defs/hash" }, "completion_path": { "$ref": "#/$defs/path" }, "completion_sha256": { "$ref": "#/$defs/hash" } } }
          }
        },
        "preparation": { "type": "object", "additionalProperties": false, "required": ["preparation_id", "receipt_path", "receipt_sha256", "event_id", "transaction_id"], "properties": { "preparation_id": { "$ref": "#/$defs/id" }, "receipt_path": { "$ref": "#/$defs/path" }, "receipt_sha256": { "$ref": "#/$defs/hash" }, "event_id": { "$ref": "#/$defs/id" }, "transaction_id": { "$ref": "#/$defs/id" } } },
        "admission": { "type": "object", "additionalProperties": false, "required": ["event_id", "transaction_id"], "properties": { "event_id": { "$ref": "#/$defs/id" }, "transaction_id": { "$ref": "#/$defs/id" } } }
      }
    },
    "selector_evidence_verified": { "const": false }, "selector_evidence_reused": { "const": false },
    "does_not_authorize": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" }, "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" } }
}
