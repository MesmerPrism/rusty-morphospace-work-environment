{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/apk-run-phase-receipt-v1.schema.json",
  "title": "Advisory APK run phase receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "transaction_id",
    "transaction_sha256",
    "phase",
    "attempt_ordinal",
    "completed_at",
    "result",
    "predecessor",
    "cleanup_required",
    "cleanup_complete",
    "artifacts",
    "summary",
    "does_not_prove"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "rusty.morphospace.quest.apk_run_phase_receipt.v1" },
    "receipt_id": { "$ref": "#/$defs/id" },
    "transaction_id": { "$ref": "#/$defs/id" },
    "transaction_sha256": { "$ref": "#/$defs/sha256" },
    "phase": {
      "enum": [
        "host-validation",
        "snapshot",
        "build",
        "inspect",
        "install",
        "launch",
        "app-ready",
        "wearer-acceptance",
        "cleanup"
      ]
    },
    "attempt_ordinal": { "type": "integer", "minimum": 1, "maximum": 9 },
    "completed_at": { "type": "string", "format": "date-time" },
    "result": { "enum": ["pass", "fail", "blocked"] },
    "predecessor": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["receipt_id", "sha256"],
          "properties": {
            "receipt_id": { "$ref": "#/$defs/id" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "cleanup_required": { "type": "boolean" },
    "cleanup_complete": { "type": ["boolean", "null"] },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "path", "sha256"],
        "properties": {
          "artifact_id": { "$ref": "#/$defs/id" },
          "kind": { "$ref": "#/$defs/id" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "does_not_prove": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
