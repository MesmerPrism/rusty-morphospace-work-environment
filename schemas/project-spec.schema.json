{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/project-spec.schema.json",
  "title": "Rusty Morphospace project specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_id",
    "revision",
    "purpose",
    "activation_model",
    "authority_map",
    "repositories",
    "modules",
    "non_scope",
    "validation_profiles",
    "public_boundary"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "rusty.morphospace.workflow.project_spec.v1" },
    "project_id": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "activation_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "unlisted_modules"],
      "properties": {
        "default": { "const": "disabled" },
        "unlisted_modules": { "const": "inert" }
      }
    },
    "authority_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameter", "owner", "adapters"],
        "properties": {
          "parameter": { "$ref": "#/$defs/dottedId" },
          "owner": { "$ref": "#/$defs/id" },
          "adapters": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo_id", "role", "path", "allowed_paths"],
        "properties": {
          "repo_id": { "$ref": "#/$defs/id" },
          "role": {
            "enum": ["application", "core", "adapter", "tool", "lab", "planning", "compatibility"]
          },
          "path": { "type": "string", "minLength": 1 },
          "allowed_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module_id",
          "feature_id",
          "lane",
          "maturity",
          "contract",
          "source_repo",
          "dependencies"
        ],
        "properties": {
          "module_id": { "$ref": "#/$defs/id" },
          "feature_id": { "$ref": "#/$defs/id" },
          "lane": { "$ref": "#/$defs/id" },
          "maturity": { "$ref": "#/$defs/id" },
          "contract": { "$ref": "#/$defs/dottedId" },
          "source_repo": { "$ref": "#/$defs/id" },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "non_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "validation_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "commands"],
        "properties": {
          "profile_id": { "$ref": "#/$defs/id" },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "public_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "private_overlay", "prohibited_evidence"],
      "properties": {
        "mode": { "enum": ["public", "private", "mixed"] },
        "private_overlay": { "type": "string", "minLength": 1 },
        "prohibited_evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "dottedId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{2,127}$"
    }
  }
}
