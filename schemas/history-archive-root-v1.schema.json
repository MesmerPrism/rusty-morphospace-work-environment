{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/history-archive-root-v1.schema.json",
  "title": "Immutable raw-byte history archive root v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "root_id", "checkpoint_id", "project_id", "created_at", "source_prefix", "objects", "carry_forward", "does_not_prove"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.history_archive_root.v1" },
    "root_id": { "$ref": "#/$defs/id" },
    "checkpoint_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_prefix": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "byte_length", "line_count", "tail_event_id", "tail_sequence"],
      "properties": {
        "path": { "const": "iteration-events.jsonl" },
        "sha256": { "$ref": "#/$defs/hash" },
        "byte_length": { "type": "integer", "minimum": 1 },
        "line_count": { "type": "integer", "minimum": 1 },
        "tail_event_id": { "$ref": "#/$defs/id" },
        "tail_sequence": { "type": "integer", "minimum": 1 }
      }
    },
    "objects": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_path", "object_path", "kind", "sha256", "byte_length"],
        "properties": {
          "source_path": { "$ref": "#/$defs/sourcePath" },
          "object_path": { "type": "string", "pattern": "^history-archive/objects/sha256/[0-9a-f]{64}\\.blob$" },
          "kind": { "enum": ["event-ledger-prefix", "terminal-unit", "receipt", "transaction"] },
          "sha256": { "$ref": "#/$defs/hash" },
          "byte_length": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "carry_forward": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_path", "sha256", "reason"],
        "properties": {
          "source_path": { "$ref": "#/$defs/sourcePath" },
          "sha256": { "$ref": "#/$defs/hash" },
          "reason": { "enum": ["compact-state-reference", "post-checkpoint-tail-reference"] }
        }
      }
    },
    "does_not_prove": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourcePath": { "type": "string", "pattern": "^(?:iteration-events\\.jsonl|iteration-units/[a-z0-9][a-z0-9-]{1,127}\\.json|receipts/(?:transactions/[a-z0-9][a-z0-9-]{1,127}\\.(?:intent|completion)\\.json|(?:[a-z0-9][a-z0-9-]{1,127}/)*[a-z0-9][a-z0-9-]{1,127}\\.json))$" }
  }
}
