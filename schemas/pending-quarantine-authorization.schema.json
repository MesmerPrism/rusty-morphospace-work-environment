{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/pending-quarantine-authorization.schema.json",
  "title": "Pending artifact quarantine authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authorization_id", "created_at", "project_id", "unit_id", "action", "target_path", "pending_path", "pending_sha256", "pending_length", "quarantine_path", "status"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.pending_quarantine_authorization.v1" },
    "authorization_id": { "$ref": "#/$defs/authorization_id" },
    "created_at": { "$ref": "#/$defs/utc" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/unit_id" },
    "action": { "const": "quarantine-preserve" },
    "target_path": { "$ref": "#/$defs/path" },
    "pending_path": { "$ref": "#/$defs/path" },
    "pending_sha256": { "$ref": "#/$defs/hash" },
    "pending_length": { "type": "integer", "minimum": 0, "maximum": 16777216 },
    "quarantine_path": { "$ref": "#/$defs/path" },
    "status": { "const": "authorized" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,191}$" },
    "unit_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "authorization_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,95}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 1024 }
  }
}
