{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/quest-signer-observation-v1.schema.json",
  "title": "Rusty Morphospace Quest signer observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "application_id", "current_signer_sha256"],
  "properties": {
    "schema": { "const": "rusty.morphospace.quest_signer_observation.v1" },
    "application_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "current_signer_sha256": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "pattern": "^[a-f0-9]{64}$" }
    }
  }
}
