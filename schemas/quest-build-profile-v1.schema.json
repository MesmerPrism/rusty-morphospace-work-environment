{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/quest-build-profile-v1.schema.json",
  "title": "Rusty Morphospace reviewed Quest build profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile_id", "working_directory", "executable", "arguments", "environment", "artifact"],
  "properties": {
    "schema": { "const": "rusty.morphospace.quest_build_profile.v1" },
    "profile_id": { "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
    "working_directory": { "type": "string", "minLength": 1 },
    "executable": { "type": "string", "minLength": 1, "description": "Repository-relative executable or the portable external tool id 'gradle'." },
    "arguments": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 1024 } },
    "environment": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
      "additionalProperties": { "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "kind"],
      "properties": {
        "relative_path": { "type": "string", "minLength": 5 },
        "kind": { "const": "single-base-apk" }
      }
    },
    "preflight": {
      "description": "Optional owner-local host-only admission observations. These fields neither authorize a build nor define a WorkUnit candidate fingerprint.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest_relative_dependencies": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "lockfiles": {
          "description": "Repository-relative immutable lock inputs; each byte identity is included in the advisory binding.",
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository_files": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            },
            "required_targets": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" }
            }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "package_id": { "type": "string", "minLength": 1, "maxLength": 255 },
            "application_id": { "type": "string", "minLength": 1, "maxLength": 255 },
            "expected_current_signer_sha256": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "environment_projection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "passthrough": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
            },
            "prohibited_parent_variables": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lane": { "enum": ["warm", "candidate"] },
            "collision_policy": { "enum": ["new-only", "content-addressed"] },
            "allow_source_root": { "type": "boolean" }
          }
        }
      }
    }
  }
}
