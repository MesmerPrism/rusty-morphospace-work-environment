{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/state-transition-completion.schema.json",
  "title": "Committed current-unit state transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "transaction_id", "completed_at", "project_id", "unit_id", "intent",
    "event_completion", "state_projection", "unit_projection", "event_tail", "status"
  ],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.state_transition_completion.v1" },
    "transaction_id": { "$ref": "#/$defs/id" },
    "completed_at": { "$ref": "#/$defs/utc" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "intent": { "$ref": "#/$defs/intentReference" },
    "event_completion": { "$ref": "#/$defs/eventCompletionReference" },
    "state_projection": { "$ref": "#/$defs/projection" },
    "unit_projection": { "$ref": "#/$defs/projection" },
    "event_tail": { "$ref": "#/$defs/eventTail" },
    "status": { "const": "committed" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,191}$" },
    "dottedId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,191}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "intentReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "const": "state-transition-intent" }, "path": { "type": "string", "minLength": 1 }, "schema": { "const": "rusty.morphospace.workflow.state_transition_intent.v1" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "eventCompletionReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "const": "event-transaction-completion" }, "path": { "type": "string", "minLength": 1 }, "schema": { "const": "rusty.morphospace.workflow.event_transaction_completion.v1" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "projection": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "schema", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "schema": { "$ref": "#/$defs/dottedId" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "eventTail": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "sequence", "sha256"],
      "properties": { "event_id": { "$ref": "#/$defs/id" }, "sequence": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/hash" } }
    }
  }
}
