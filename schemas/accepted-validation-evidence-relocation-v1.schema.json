{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/accepted-validation-evidence-relocation-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "relocation_id", "project_id", "unit_id", "created_at", "acceptance", "artifacts", "preservation"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.accepted_validation_evidence_relocation.v1" },
    "relocation_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time" },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "intent_sha256", "completion_sha256", "receipt_path", "receipt_sha256"],
      "properties": {
        "event_id": { "$ref": "#/$defs/id" },
        "intent_sha256": { "$ref": "#/$defs/hash" },
        "completion_sha256": { "$ref": "#/$defs/hash" },
        "receipt_path": { "$ref": "#/$defs/path" },
        "receipt_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "original_path", "local_path", "sha256"],
        "properties": {
          "artifact_id": { "$ref": "#/$defs/id" },
          "original_path": { "$ref": "#/$defs/path" },
          "local_path": { "type": "string", "pattern": "^local/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "preservation": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted_receipt_unchanged", "accepted_event_prefix_unchanged", "validation_reexecuted", "source_published"],
      "properties": {
        "accepted_receipt_unchanged": { "const": true },
        "accepted_event_prefix_unchanged": { "const": true },
        "validation_reexecuted": { "const": false },
        "source_published": { "const": false }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" }
  }
}
