{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/development-envelope-source-composition-v1.schema.json",
  "title": "Preparation-owned source composition lock",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "lock_id", "preparation_id", "project_id", "fingerprint", "repositories", "status", "does_not_prove"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.development_envelope_source_composition.v1" },
    "lock_id": { "$ref": "#/$defs/id" }, "preparation_id": { "$ref": "#/$defs/id" }, "project_id": { "$ref": "#/$defs/id" }, "fingerprint": { "$ref": "#/$defs/hash" },
    "repositories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["repo_id", "role", "commit", "tree", "branch", "materialization_path", "tracked_worktree_clean"], "properties": { "repo_id": { "$ref": "#/$defs/id" }, "role": { "enum": ["source", "planning"] }, "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "branch": { "type": ["string", "null"] }, "materialization_path": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }, "tracked_worktree_clean": { "const": true } } } },
    "status": { "const": "locked" }, "does_not_prove": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" }, "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
