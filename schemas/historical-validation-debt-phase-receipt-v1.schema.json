{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/historical-validation-debt-phase-receipt-v1.schema.json",
  "title": "Historical validation-debt phase receipt v1",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/start" },
    { "$ref": "#/$defs/terminal" }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$" },
    "leaf": { "type": "string", "pattern": "^[0-9]{3}-[a-z0-9][a-z0-9-]{1,95}\\.(?:start\\.json|terminal\\.json|stdout\\.log|stderr\\.log)$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "length"],
      "properties": {
        "path": { "$ref": "#/$defs/leaf" },
        "sha256": { "$ref": "#/$defs/hash" },
        "length": { "type": "integer", "minimum": 0, "maximum": 33554432 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "length", "arguments", "arguments_sha256", "working_directory"],
      "properties": {
        "kind": { "enum": ["child", "in-process"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sha256": { "$ref": "#/$defs/hash" },
        "length": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "arguments": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "maxLength": 4096 }
        },
        "arguments_sha256": { "$ref": "#/$defs/hash" },
        "working_directory": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "succeeded"],
      "properties": {
        "attempted": { "type": "boolean" },
        "succeeded": { "type": "boolean" }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streamed_bytes", "suppressed_bytes"],
      "properties": {
        "streamed_bytes": { "type": "integer", "minimum": 0, "maximum": 33554432 },
        "suppressed_bytes": { "type": "integer", "minimum": 0, "maximum": 33554432 }
      }
    },
    "common": {
      "type": "object",
      "required": ["schema", "record_kind", "phase_id", "sequence", "evidence_root_sha256"],
      "properties": {
        "schema": { "const": "rusty.morphospace.workflow.historical_validation_debt_phase_receipt.v1" },
        "record_kind": { "enum": ["start", "terminal"] },
        "phase_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 999 },
        "evidence_root_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "start": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema", "record_kind", "phase_id", "sequence", "evidence_root_sha256",
            "started_at", "timeout_seconds", "command", "stdout_path", "stderr_path",
            "git_environment_removed"
          ],
          "properties": {
            "schema": { "const": "rusty.morphospace.workflow.historical_validation_debt_phase_receipt.v1" },
            "record_kind": { "const": "start" },
            "phase_id": { "$ref": "#/$defs/id" },
            "sequence": { "type": "integer", "minimum": 1, "maximum": 999 },
            "evidence_root_sha256": { "$ref": "#/$defs/hash" },
            "started_at": { "$ref": "#/$defs/utc" },
            "timeout_seconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
            "command": { "$ref": "#/$defs/command" },
            "stdout_path": { "$ref": "#/$defs/leaf" },
            "stderr_path": { "$ref": "#/$defs/leaf" },
            "git_environment_removed": {
              "type": "array",
              "maxItems": 64,
              "items": { "type": "string", "pattern": "^GIT_[A-Za-z0-9_]+$" }
            }
          }
        }
      ]
    },
    "terminal": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema", "record_kind", "phase_id", "sequence", "evidence_root_sha256",
            "command", "started_at", "ended_at", "elapsed_ms", "start_receipt",
            "result", "category", "exit_code", "timed_out", "child_tree_cleanup",
            "stdout", "stderr", "diagnostics"
          ],
          "properties": {
            "schema": { "const": "rusty.morphospace.workflow.historical_validation_debt_phase_receipt.v1" },
            "record_kind": { "const": "terminal" },
            "phase_id": { "$ref": "#/$defs/id" },
            "sequence": { "type": "integer", "minimum": 1, "maximum": 999 },
            "evidence_root_sha256": { "$ref": "#/$defs/hash" },
            "command": { "$ref": "#/$defs/command" },
            "started_at": { "$ref": "#/$defs/utc" },
            "ended_at": { "$ref": "#/$defs/utc" },
            "elapsed_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
            "start_receipt": { "$ref": "#/$defs/file" },
            "result": { "enum": ["pass", "fail"] },
            "category": {
              "enum": [
                "completed", "code-fail", "timeout", "process-start-fail",
                "output-limit", "child-cleanup-fail", "cache-miss",
                "evidence-reuse-rejection", "fixture-cleanup",
                "evidence-collision", "evidence-reused",
                "handshake-missing", "handshake-invalid", "handshake-stale"
              ]
            },
            "exit_code": { "type": ["integer", "null"] },
            "timed_out": { "type": "boolean" },
            "child_tree_cleanup": { "$ref": "#/$defs/cleanup" },
            "stdout": { "$ref": "#/$defs/file" },
            "stderr": { "$ref": "#/$defs/file" },
            "diagnostics": { "$ref": "#/$defs/diagnostics" }
          }
        }
      ]
    }
  }
}
