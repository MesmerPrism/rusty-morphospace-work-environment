{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/validation-execution.schema.json",
  "title": "Non-replayable authority validation execution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "execution_id", "completed_at", "execution_nonce", "project_id", "unit_id", "attempt_id", "action", "evidence", "expected_receipt", "output_contract_sha256", "observations", "executor", "status"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.validation_execution.v1" },
    "execution_id": { "$ref": "#/$defs/id" },
    "completed_at": { "$ref": "#/$defs/utc" },
    "execution_nonce": { "$ref": "#/$defs/hash" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "attempt_id": { "$ref": "#/$defs/id" },
    "action": { "$ref": "#/$defs/actionReference" },
    "evidence": { "$ref": "#/$defs/evidenceReference" },
    "expected_receipt": { "$ref": "#/$defs/expectedReceipt" },
    "output_contract_sha256": { "$ref": "#/$defs/hash" },
    "observations": { "$ref": "#/$defs/observations" },
    "executor": { "$ref": "#/$defs/executor" },
    "status": { "const": "completed" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,191}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "typedReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 1 }, "schema": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "actionReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "const": "validation-action" }, "path": { "type": "string", "minLength": 1 }, "schema": { "const": "rusty.morphospace.workflow.validation_action.v2" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "evidenceReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "const": "validation-evidence" }, "path": { "type": "string", "minLength": 1 }, "schema": { "const": "rusty.morphospace.workflow.validation_evidence.v2" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "expectedReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema"],
      "properties": { "role": { "const": "validation-receipt" }, "path": { "type": "string", "minLength": 1 }, "schema": { "const": "rusty.morphospace.workflow.validation_receipt.v2" } }
    },
    "observations": {
      "type": "object", "additionalProperties": false,
      "required": ["before_sha256", "after_sha256"],
      "properties": { "before_sha256": { "$ref": "#/$defs/hash" }, "after_sha256": { "$ref": "#/$defs/hash" } }
    },
    "executor": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "command_sha256"],
      "properties": { "command": { "const": "Invoke-MorphospaceValidationAuthority.ps1" }, "command_sha256": { "$ref": "#/$defs/hash" } }
    }
  }
}
