{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/active-development-envelope-extension-v1.schema.json",
  "title": "Owner-reviewed additive active development-envelope extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "extension_id", "project_id", "unit_id", "rationale",
    "ownership_proof", "additions", "before", "target", "source_composition",
    "effective_repository_map", "expected", "does_not_prove"
  ],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.active_development_envelope_extension.v1" },
    "extension_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "rationale": { "type": "string", "minLength": 8, "maxLength": 2048 },
    "ownership_proof": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repo_id", "source_roots", "owner", "evidence"],
        "properties": {
          "repo_id": { "$ref": "#/$defs/id" },
          "source_roots": { "$ref": "#/$defs/paths" },
          "owner": { "$ref": "#/$defs/id" },
          "evidence": { "type": "string", "minLength": 8, "maxLength": 2048 }
        }
      }
    },
    "additions": {
      "type": "object", "additionalProperties": false,
      "required": [
        "repository_ids", "owner_roots", "feature_ids", "module_ids",
        "authority_parameters", "effects", "permissions", "validation_profile_ids",
        "acceptance_profile_ids", "build_profile_ids", "device_kinds"
      ],
      "properties": {
        "repository_ids": { "$ref": "#/$defs/ids" },
        "owner_roots": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["repo_id", "source_roots"],
            "properties": { "repo_id": { "$ref": "#/$defs/id" }, "source_roots": { "$ref": "#/$defs/paths" } }
          }
        },
        "feature_ids": { "$ref": "#/$defs/ids" },
        "module_ids": { "$ref": "#/$defs/ids" },
        "authority_parameters": { "$ref": "#/$defs/strings" },
        "effects": { "$ref": "#/$defs/effects" },
        "permissions": { "$ref": "#/$defs/strings" },
        "validation_profile_ids": { "$ref": "#/$defs/ids" },
        "acceptance_profile_ids": { "$ref": "#/$defs/ids" },
        "build_profile_ids": { "$ref": "#/$defs/ids" },
        "device_kinds": { "$ref": "#/$defs/strings" }
      }
    },
    "before": { "$ref": "#/$defs/envelopeEndpoint" },
    "target": { "$ref": "#/$defs/envelopeEndpoint" },
    "source_composition": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "repository_ids"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "repository_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "effective_repository_map": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "raw_sha256"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "raw_sha256": { "$ref": "#/$defs/hash" } }
    },
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": [
        "status", "current_unit", "project_revision", "feature_lock_revision", "plan_revision",
        "project_sha256", "project_raw_sha256", "feature_lock_sha256", "feature_lock_raw_sha256",
        "state_sha256", "state_raw_sha256", "unit_sha256", "unit_raw_sha256",
        "events_sha256", "events_length", "event_tail_id",
        "source_composition_path", "source_composition_raw_sha256", "source_composition_canonical_sha256",
        "repository_map_path", "repository_map_raw_sha256",
        "original_source_composition_path", "original_source_composition_raw_sha256",
        "original_repository_map_path", "original_repository_map_raw_sha256"
      ],
      "properties": {
        "status": { "const": "active" },
        "current_unit": { "$ref": "#/$defs/id" },
        "project_revision": { "type": "integer", "minimum": 1 },
        "feature_lock_revision": { "type": "integer", "minimum": 1 },
        "plan_revision": { "type": "integer", "minimum": 1 },
        "project_sha256": { "$ref": "#/$defs/hash" },
        "project_raw_sha256": { "$ref": "#/$defs/hash" },
        "feature_lock_sha256": { "$ref": "#/$defs/hash" },
        "feature_lock_raw_sha256": { "$ref": "#/$defs/hash" },
        "state_sha256": { "$ref": "#/$defs/hash" },
        "state_raw_sha256": { "$ref": "#/$defs/hash" },
        "unit_sha256": { "$ref": "#/$defs/hash" },
        "unit_raw_sha256": { "$ref": "#/$defs/hash" },
        "events_sha256": { "$ref": "#/$defs/hash" },
        "events_length": { "type": "integer", "minimum": 1 },
        "event_tail_id": { "$ref": "#/$defs/id" },
        "source_composition_path": { "$ref": "#/$defs/path" },
        "source_composition_raw_sha256": { "$ref": "#/$defs/hash" },
        "source_composition_canonical_sha256": { "$ref": "#/$defs/hash" },
        "repository_map_path": { "$ref": "#/$defs/path" },
        "repository_map_raw_sha256": { "$ref": "#/$defs/hash" },
        "original_source_composition_path": { "$ref": "#/$defs/path" },
        "original_source_composition_raw_sha256": { "$ref": "#/$defs/hash" },
        "original_repository_map_path": { "$ref": "#/$defs/path" },
        "original_repository_map_raw_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "does_not_prove": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
    "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*/?$" } },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "envelopeEndpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["project", "feature_lock", "state", "agent_scope_assessment", "allowed_repositories", "read_only_dependencies"],
      "properties": {
        "project": { "type": "object" },
        "feature_lock": { "type": "object" },
        "state": { "type": "object" },
        "agent_scope_assessment": { "type": "object" },
        "allowed_repositories": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "read_only_dependencies": { "type": "array", "items": { "type": "object" } }
      }
    },
    "effects": {
      "type": "object", "additionalProperties": false,
      "required": ["permissions", "services", "activities", "queries", "tools", "assets", "shaders", "native_libraries", "commands", "routes", "streams", "inputs", "scenes", "markers"],
      "properties": {
        "permissions": { "$ref": "#/$defs/strings" }, "services": { "$ref": "#/$defs/strings" },
        "activities": { "$ref": "#/$defs/strings" }, "queries": { "$ref": "#/$defs/strings" },
        "tools": { "$ref": "#/$defs/strings" }, "assets": { "$ref": "#/$defs/strings" },
        "shaders": { "$ref": "#/$defs/strings" }, "native_libraries": { "$ref": "#/$defs/strings" },
        "commands": { "$ref": "#/$defs/strings" }, "routes": { "$ref": "#/$defs/strings" },
        "streams": { "$ref": "#/$defs/strings" }, "inputs": { "$ref": "#/$defs/strings" },
        "scenes": { "$ref": "#/$defs/strings" }, "markers": { "$ref": "#/$defs/strings" }
      }
    }
  }
}
