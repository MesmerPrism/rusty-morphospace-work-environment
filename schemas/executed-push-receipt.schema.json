{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/executed-push-receipt.schema.json",
  "title": "Validated externally executed coordinated push receipt",
  "description": "Evidence recorded after an authorized external push. This contract does not authorize or execute Git operations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "bundle_id",
    "project_id",
    "unit_ids",
    "prepared_plan_id",
    "started_at",
    "finished_at",
    "status",
    "execution",
    "dependency_order",
    "execution_order",
    "repositories",
    "validation",
    "rollback",
    "source_first",
    "planning_last",
    "force_push_used",
    "remote_readback_complete",
    "failure"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema": { "const": "rusty.morphospace.workflow.executed_push_receipt.v1" },
    "receipt_id": { "$ref": "#/$defs/id" },
    "bundle_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "prepared_plan_id": { "$ref": "#/$defs/id" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "status": { "const": "validated-pushed" },
    "execution": { "const": "externally-performed" },
    "dependency_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "execution_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repository-ref" }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/validation-gate" }
    },
    "rollback": { "$ref": "#/$defs/rollback" },
    "source_first": { "const": true },
    "planning_last": { "const": true },
    "force_push_used": { "const": false },
    "remote_readback_complete": { "const": true },
    "failure": { "type": "null" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "repository-ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "repo_id",
        "role",
        "branch",
        "remote",
        "upstream",
        "action",
        "old_revision",
        "new_revision",
        "observed_remote_revision",
        "push_status",
        "ancestry_verified",
        "remote_match",
        "force_push_used",
        "validation_refs",
        "rollback_revision"
      ],
      "properties": {
        "ref_id": { "$ref": "#/$defs/id" },
        "repo_id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["source-owner", "planning"] },
        "branch": { "type": "string", "minLength": 1 },
        "remote": { "type": "string", "minLength": 1 },
        "upstream": { "type": "string", "minLength": 1 },
        "action": { "enum": ["pushed", "readback-only"] },
        "old_revision": { "$ref": "#/$defs/revision" },
        "new_revision": { "$ref": "#/$defs/revision" },
        "observed_remote_revision": { "$ref": "#/$defs/revision" },
        "push_status": { "const": "pass" },
        "ancestry_verified": { "const": true },
        "remote_match": { "const": true },
        "force_push_used": { "const": false },
        "validation_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "rollback_revision": { "$ref": "#/$defs/revision" }
      }
    },
    "validation-gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "status", "evidence"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/id" },
        "status": { "const": "pass" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "reverse_dependency_order", "points"],
      "properties": {
        "strategy": { "const": "revert-in-reverse-dependency-order" },
        "reverse_dependency_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref_id", "rollback_revision", "acceptance"],
            "properties": {
              "ref_id": { "$ref": "#/$defs/id" },
              "rollback_revision": { "$ref": "#/$defs/revision" },
              "acceptance": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
