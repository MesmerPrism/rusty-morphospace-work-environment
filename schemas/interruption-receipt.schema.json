{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/interruption-receipt.schema.json",
  "title": "Rusty Morphospace interrupted-work recovery receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "receipt_id", "project_id", "unit_id", "captured_at",
    "interruption_kind", "safe_to_resume", "cleanup_complete", "repositories",
    "build_cleanup", "device_cleanup", "artifacts"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "rusty.morphospace.workflow.interruption_receipt.v1" },
    "receipt_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "captured_at": { "type": "string", "format": "date-time" },
    "interruption_kind": { "enum": ["partial-cross-repo-commit", "interrupted-build", "interrupted-device"] },
    "safe_to_resume": { "type": "boolean" },
    "cleanup_complete": { "type": "boolean" },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repo_id", "observed_revision", "state"],
        "properties": {
          "repo_id": { "$ref": "#/$defs/id" },
          "observed_revision": { "$ref": "#/$defs/sha" },
          "state": { "enum": ["committed", "pending", "preserved"] }
        }
      }
    },
    "build_cleanup": {
      "oneOf": [{ "type": "null" }, {
        "type": "object", "additionalProperties": false,
        "required": ["active_process_count", "outputs_quarantined", "cleanup_actions"],
        "properties": {
          "active_process_count": { "type": "integer", "minimum": 0 },
          "outputs_quarantined": { "type": "boolean" },
          "cleanup_actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }]
    },
    "device_cleanup": {
      "oneOf": [{ "type": "null" }, {
        "type": "object", "additionalProperties": false,
        "required": ["serials", "packages_remaining", "routes_inactive", "package_fatal_count", "system_fatal_count"],
        "properties": {
          "serials": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "packages_remaining": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "routes_inactive": { "type": "boolean" },
          "package_fatal_count": { "type": "integer", "minimum": 0 },
          "system_fatal_count": { "type": "integer", "minimum": 0 }
        }
      }]
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "path", "sha256"],
        "properties": {
          "artifact_id": { "$ref": "#/$defs/id" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
  }
}
