{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/workspace-state.schema.json",
  "title": "Rusty Morphospace compact workspace state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_id",
    "plan_revision",
    "current_unit",
    "next_ready_unit",
    "last_event_id",
    "dirty_repositories",
    "blockers",
    "validation_checkpoint",
    "pending_push_bundle"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "rusty.morphospace.workflow.workspace_state.v1" },
    "project_id": { "$ref": "#/$defs/id" },
    "plan_revision": { "type": "integer", "minimum": 1 },
    "current_unit": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "next_ready_unit": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "last_event_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "dirty_repositories": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blocker_id", "condition", "resume_when"],
        "properties": {
          "blocker_id": { "$ref": "#/$defs/id" },
          "condition": { "type": "string", "minLength": 1 },
          "resume_when": { "type": "string", "minLength": 1 }
        }
      }
    },
    "normal_validation_selection": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/normalValidationSelection" }
      ]
    },
    "validation_checkpoint": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "receipt", "result"],
          "properties": {
            "tier": { "enum": ["quick", "standard", "deep"] },
            "receipt": { "type": "string", "minLength": 1 },
            "result": { "enum": ["pass", "partial", "fail", "blocked"] }
          }
        }
      ]
    },
    "pending_push_bundle": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["bundle_id", "unit_ids", "repo_ids", "ready"],
          "properties": {
            "bundle_id": { "$ref": "#/$defs/id" },
            "unit_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            },
            "repo_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            },
            "ready": { "type": "boolean" }
          }
        }
      ]
    },
    "historical_unit_adoption_receipts": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^receipts/[a-z0-9][a-z0-9-]{1,127}\\.json$" },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "historical_unit_adoption_reconstructions": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^receipts/[a-z0-9][a-z0-9-]{1,127}\\.json$" },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
    },
    "hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "normalValidationSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "unit_raw_sha256", "unit_contract_sha256", "tier", "selector_id", "selector_path", "selector_sha256", "evidence_path_sha256"],
      "properties": {
        "unit_id": { "$ref": "#/$defs/id" },
        "unit_raw_sha256": { "$ref": "#/$defs/hash" },
        "unit_contract_sha256": { "$ref": "#/$defs/hash" },
        "tier": { "const": "quick" },
        "selector_id": { "$ref": "#/$defs/id" },
        "selector_path": { "type": "string", "pattern": "^validation-authority/selectors/[a-z0-9][a-z0-9-]{1,127}\\.json$" },
        "selector_sha256": { "$ref": "#/$defs/hash" },
        "evidence_path_sha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
