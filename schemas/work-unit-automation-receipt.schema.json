{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/work-unit-automation-receipt.schema.json",
  "title": "Work-unit automation action receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "unit_id", "action", "timestamp", "executed", "transition", "status_before", "status_after", "current_unit_before", "current_unit_after", "preservation", "validation_matrix", "graph_scope", "claim_preflight", "adoption_receipt", "publication_closure", "published_planning_authority_adoption", "planned_publication", "planning_suffix_rewrite_recovery", "published_prerequisite_suffix_reconciliation", "executed_prepared_publication_reconciliation", "push_plan", "event_id"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.work_unit_automation_receipt.v1" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "action": { "enum": ["Inspect", "Claim", "Resume", "Ready", "WithdrawReady", "CompleteInstructionSurfaces", "BeginValidation", "ReturnToActive", "PreflightValidation", "RecordValidation", "Accept", "PreparePush", "RecordPublication", "Recover", "ReconcilePublication", "AdoptPublishedPlanningAuthority", "ReconcilePlanningSuffixRewrite", "ReconcilePublishedPrerequisiteSuffix", "ReconcileExecutedPreparedPublication"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "executed": { "type": "boolean" },
    "transition": { "type": "string", "minLength": 1 },
    "status_before": { "$ref": "#/$defs/id" },
    "status_after": { "$ref": "#/$defs/id" },
    "current_unit_before": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "current_unit_after": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_mutation_performed", "device_mutation_performed", "force_push_allowed", "repository_states"],
      "properties": {
        "git_mutation_performed": { "const": false },
        "device_mutation_performed": { "const": false },
        "force_push_allowed": { "const": false },
        "repository_states": { "type": "array", "items": { "type": "object" } }
      }
    },
    "validation_matrix": { "type": "array", "items": { "type": "object" } },
    "graph_scope": { "type": "object" },
    "claim_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "ready_to_claim", "validation_tier", "requirements_declared", "disk", "tools", "product_inputs", "writable_repositories", "read_only_dependencies", "instruction_surfaces", "resources", "validation_matrix", "issues"],
      "properties": {
        "version": { "enum": ["v1", "v2"] },
        "ready_to_claim": { "type": "boolean" },
        "advisory_status": { "enum": ["pass", "fail", "incomplete"] },
        "candidate_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "state_mutation_performed": { "const": false },
        "reason_codes": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" }
        },
        "contract_bindings": {
          "type": "object", "additionalProperties": false,
          "required": ["project_revision", "workflow_lifecycle_sha256", "iteration_unit_schema_sha256", "automation_receipt_schema_sha256", "execution_preflight_observation_schema_sha256", "owner_validator_registry_sha256", "instruction_router_sha256"],
          "properties": {
            "project_revision": { "type": "integer", "minimum": 1 },
            "workflow_lifecycle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "iteration_unit_schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "automation_receipt_schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "execution_preflight_observation_schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "owner_validator_registry_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "instruction_router_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "coverage": {
          "type": "object", "additionalProperties": false,
          "required": ["expected", "completed", "skipped", "missing", "checks"],
          "properties": {
            "expected": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" } },
            "completed": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" } },
            "skipped": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" } },
            "missing": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" } },
            "checks": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["check_id", "outcome", "coverage_state", "reason_codes"],
                "properties": {
                  "check_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
                  "outcome": { "enum": ["pass", "fail", "incomplete"] },
                  "coverage_state": { "enum": ["completed", "skipped", "missing"] },
                  "reason_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" } }
                }
              }
            }
          }
        },
        "validation_tier": { "enum": ["quick", "standard", "deep"] },
        "guard_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "explicit", "source", "status", "reason_codes"],
          "properties": {
            "id": { "enum": ["fast", "labs", "locked"] },
            "explicit": { "type": "boolean" },
            "source": { "enum": ["unit", "legacy-risk-inference"] },
            "status": { "enum": ["pass", "fail", "legacy-compatible"] },
            "reason_codes": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" }
            }
          }
        },
        "execution_preflight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["declared", "status", "observation", "assertions", "issues"],
          "properties": {
            "declared": { "type": "boolean" },
            "status": { "enum": ["pass", "fail", "incomplete", "not-declared"] },
            "observation": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["repo_id", "path", "expected_sha256", "sha256", "hash_matches", "schema", "observation_id"],
                  "properties": {
                    "repo_id": { "$ref": "#/$defs/id" },
                    "path": { "type": "string", "minLength": 1 },
                    "expected_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "sha256": { "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }] },
                    "hash_matches": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] },
                    "schema": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
                    "observation_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
                  }
                },
                { "type": "null" }
              ]
            },
            "assertions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["assertion_id", "kind", "key", "expected", "observed", "passed"],
                "properties": {
                  "assertion_id": { "$ref": "#/$defs/id" },
                  "kind": { "enum": ["value-equals", "capability-present"] },
                  "key": { "type": "string", "minLength": 1 },
                  "expected": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
                  "observed": { "oneOf": [{ "type": "string" }, { "type": "boolean" }, { "type": "null" }] },
                  "passed": { "type": "boolean" }
                }
              }
            },
            "issues": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "requirements_declared": { "type": "boolean" },
        "disk": { "type": "array", "items": { "type": "object" } },
        "tools": { "type": "array", "items": { "type": "object" } },
        "product_inputs": { "type": "array", "items": { "type": "object" } },
        "writable_repositories": { "type": "array", "items": { "type": "object" } },
        "read_only_dependencies": { "type": "array", "items": { "type": "object" } },
        "instruction_surfaces": { "type": "array", "items": { "type": "object" } },
        "resources": { "type": "array", "items": { "type": "object" } },
        "validation_matrix": { "type": "array", "items": { "type": "object" } },
        "issues": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        {
          "if": { "properties": { "version": { "const": "v2" } }, "required": ["version"] },
          "then": { "required": ["advisory_status", "candidate_fingerprint", "state_mutation_performed", "reason_codes", "contract_bindings", "coverage", "guard_profile", "execution_preflight"] }
        },
        {
          "if": { "properties": { "version": { "const": "v1" } }, "required": ["version"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["advisory_status"] },
                { "required": ["candidate_fingerprint"] },
                { "required": ["state_mutation_performed"] },
                { "required": ["reason_codes"] },
                { "required": ["contract_bindings"] },
                { "required": ["coverage"] },
                { "required": ["guard_profile"] },
                { "required": ["execution_preflight"] }
              ]
            }
          }
        }
      ]
    },
    "adoption_receipt": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "publication_closure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["closure_id", "sha256"],
          "properties": {
            "closure_id": { "$ref": "#/$defs/id" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        { "type": "null" }
      ]
    },
    "published_planning_authority_adoption": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["adoption_id", "path", "sha256"],
          "properties": {
            "adoption_id": { "$ref": "#/$defs/id" },
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        { "type": "null" }
      ]
    },
    "planned_publication": {
      "oneOf": [
        { "type":"object", "additionalProperties":false, "required":["accounting_id","path","sha256","executed_push_receipt"], "properties": {
          "accounting_id":{"$ref":"#/$defs/id"}, "path":{"type":"string","minLength":1}, "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "executed_push_receipt":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
        }},
        { "type":"null" }
      ]
    },
    "planning_suffix_rewrite_recovery": { "oneOf": [ { "type": "object", "additionalProperties": false, "required": ["recovery_id","path","sha256"], "properties": { "recovery_id": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } }, { "type": "null" } ] },
    "published_prerequisite_suffix_reconciliation": { "oneOf": [ { "type": "object", "additionalProperties": false, "required": ["reconciliation_id","path","sha256"], "properties": { "reconciliation_id": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } }, { "type": "null" } ] },
    "executed_prepared_publication_reconciliation": { "oneOf": [ { "type": "object", "additionalProperties": false, "required": ["reconciliation_id","path","sha256","executed_push_receipt"], "properties": { "reconciliation_id": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "executed_push_receipt": { "type": "object", "additionalProperties": false, "required": ["path","sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } } }, { "type": "null" } ] },
    "instruction_surface_completion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["completion_id", "expected_unit_sha256", "resulting_unit_sha256", "observation_sha256", "all_planned_surfaces_completed", "surface_files_observed_stable", "validation_commands_executed", "surfaces"],
          "properties": {
            "completion_id": { "$ref": "#/$defs/id" },
            "expected_unit_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "resulting_unit_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "observation_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "all_planned_surfaces_completed": { "const": true },
            "surface_files_observed_stable": { "const": true },
            "validation_commands_executed": { "const": false },
            "surfaces": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["surface_id", "surface_kind", "declared_path", "repo_id", "relative_path", "owner", "action", "validation", "skill_id", "previous_status", "resulting_status", "sha256"],
                "properties": {
                  "surface_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "surface_kind": { "enum": ["agents", "readme", "router-doc", "validation-doc", "compatibility-doc", "roadmap-doc", "skill"] },
                  "declared_path": { "type": "string", "minLength": 1 },
                  "repo_id": { "$ref": "#/$defs/id" },
                  "relative_path": { "type": "string", "minLength": 1 },
                  "owner": { "type": "string", "minLength": 1 },
                  "action": { "enum": ["update", "review-no-change"] },
                  "validation": { "type": "string", "minLength": 1 },
                  "skill_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
                  "previous_status": { "const": "planned" },
                  "resulting_status": { "const": "complete" },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "ready_withdrawal": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["original_ready_event", "original_ready_transaction", "authenticated_preimage", "next_ready_unit_before", "next_ready_unit_after", "ready_queue_before", "ready_queue_after", "original_ready_event_preserved"],
          "properties": {
            "original_ready_event": {
              "type": "object", "additionalProperties": false,
              "required": ["event_id", "sequence", "sha256"],
              "properties": {
                "event_id": { "$ref": "#/$defs/id" },
                "sequence": { "type": "integer", "minimum": 1 },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            },
            "original_ready_transaction": {
              "type": "object", "additionalProperties": false,
              "required": ["transaction_id", "intent", "completion", "target_state_sha256", "target_unit_sha256"],
              "properties": {
                "transaction_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,191}$" },
                "intent": { "$ref": "#/$defs/path_hash" },
                "completion": { "$ref": "#/$defs/path_hash" },
                "target_state_sha256": { "$ref": "#/$defs/sha256" },
                "target_unit_sha256": { "$ref": "#/$defs/sha256" }
              }
            },
            "authenticated_preimage": {
              "type": "object", "additionalProperties": false,
              "required": ["state_sha256", "unit_sha256", "events_sha256", "events_length", "event_tail_id"],
              "properties": {
                "state_sha256": { "$ref": "#/$defs/sha256" },
                "unit_sha256": { "$ref": "#/$defs/sha256" },
                "events_sha256": { "$ref": "#/$defs/sha256" },
                "events_length": { "type": "integer", "minimum": 0, "maximum": 67108864 },
                "event_tail_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
              }
            },
            "next_ready_unit_before": { "$ref": "#/$defs/id" },
            "next_ready_unit_after": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "ready_queue_before": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "ready_queue_after": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "original_ready_event_preserved": { "const": true }
          }
        },
        { "type": "null" }
      ]
    },
    "push_plan": { "oneOf": [{ "type": "object" }, { "type": "null" }] },
    "event_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "action": { "const": "WithdrawReady" } },
        "required": ["action"]
      },
      "then": {
        "required": ["ready_withdrawal"],
        "properties": { "ready_withdrawal": { "type": "object" } }
      },
      "else": {
        "properties": { "ready_withdrawal": { "type": "null" } }
      }
    },
    {
      "if": {
        "properties": {
          "action": { "const": "CompleteInstructionSurfaces" }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["instruction_surface_completion"],
        "properties": {
          "instruction_surface_completion": { "type": "object" }
        }
      },
      "else": {
        "properties": {
          "instruction_surface_completion": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": { "const": "AdoptPublishedPlanningAuthority" }
        },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "published_planning_authority_adoption": { "type": "object" }
        }
      },
      "else": {
        "properties": {
          "published_planning_authority_adoption": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "action": { "const": "ReconcileExecutedPreparedPublication" } },
        "required": ["action"]
      },
      "then": {
        "properties": { "executed_prepared_publication_reconciliation": { "type": "object" } }
      },
      "else": {
        "properties": { "executed_prepared_publication_reconciliation": { "type": "null" } }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path_hash": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
