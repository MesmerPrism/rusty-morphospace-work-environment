{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/quest-build-terminal-result-v1.schema.json",
  "title": "Rusty Morphospace Quest build terminal result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation", "terminal_status", "profile", "invocation", "observation", "reason_codes", "streams", "owner_payload"],
  "properties": {
    "schema": { "const": "rusty.morphospace.quest_build_terminal_result.v1" },
    "operation": { "enum": ["preflight", "build"] },
    "terminal_status": { "enum": ["passed", "contradiction", "incomplete", "failed", "timed_out", "cancelled"] },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_sha256"],
      "properties": {
        "profile_id": { "type": ["string", "null"], "maxLength": 96 },
        "profile_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_sha256", "executable", "arguments"],
      "properties": {
        "binding_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "executable": { "type": ["string", "null"] },
        "arguments": { "type": "array", "items": { "type": "string" } }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "sha256"],
      "properties": {
        "observation_id": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "reason_codes": { "type": "array", "uniqueItems": true, "items": { "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$" } },
    "streams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured", "stdout", "stderr"],
      "properties": {
        "captured": { "type": "boolean" },
        "stdout": { "$ref": "#/$defs/stream" },
        "stderr": { "$ref": "#/$defs/stream" }
      }
    },
    "owner_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "source", "lockfiles", "toolchain", "environment", "identity", "output", "execution_preflight_observation"],
      "properties": {
        "artifact": { "type": ["object", "null"] },
        "source": { "type": ["object", "null"] },
        "lockfiles": { "type": "array" },
        "toolchain": { "type": "array" },
        "environment": { "type": "array" },
        "identity": { "type": "object" },
        "output": { "type": "object" },
        "execution_preflight_observation": { "type": ["object", "null"] }
      }
    }
  },
  "$defs": {
    "stream": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "size_bytes"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "size_bytes": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "preflight" } } },
      "then": { "properties": { "terminal_status": { "enum": ["passed", "contradiction", "incomplete"] } } }
    }
  ]
}
