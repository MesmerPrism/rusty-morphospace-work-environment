{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/tooling-context-protocol-receipt-v1.schema.json","type":"object","additionalProperties":false,
  "required":["schema","receipt_id","executor","protocol","validation","status","does_not_prove"],
  "properties":{"schema":{"const":"rusty.morphospace.workflow.tooling_context_protocol_receipt.v1"},"receipt_id":{"$ref":"#/$defs/id"},"executor":{"type":"object","additionalProperties":false,"required":["repo_id","commit","tree"],"properties":{"repo_id":{"$ref":"#/$defs/id"},"commit":{"$ref":"#/$defs/oid"},"tree":{"$ref":"#/$defs/oid"}}},"protocol":{"type":"object","additionalProperties":false,"required":["protocol_id","product_lock_schema","repository_map_schema","allowed_actions"],"properties":{"protocol_id":{"const":"tooling-context-v1"},"product_lock_schema":{"const":"rusty.morphospace.workflow.development_envelope_source_composition.v3"},"repository_map_schema":{"const":"rusty.morphospace.workflow.repository_map.v1"},"allowed_actions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}}},"validation":{"$ref":"#/$defs/file"},"status":{"const":"compatible"},"does_not_prove":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}},
  "$defs":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{1,127}$"},"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"oid":{"type":"string","pattern":"^[0-9a-f]{40}$"},"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},"file":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"$ref":"#/$defs/path"},"sha256":{"$ref":"#/$defs/hash"}}}}
}
