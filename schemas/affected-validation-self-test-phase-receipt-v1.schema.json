{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/affected-validation-self-test-phase-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "phase_id", "binding", "binding_sha256", "started_at", "ended_at", "budget_seconds", "elapsed_ms", "result", "child", "outputs", "claims"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.affected_validation_self_test_phase_receipt.v1" },
    "phase_id": { "enum": ["graph-import-closure", "dependency-closure", "executor-pass-schema", "executor-damage", "selection-scenarios", "trust-self-executor", "trust-routing-contracts", "trust-proportional-mappings", "trust-damage-final"] },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "base_commit", "head_commit", "head_tree", "plan_sha256", "platform", "check_id", "phase_id", "runner", "dependency_manifest"],
      "properties": {
        "repository": { "const": "MesmerPrism/rusty-morphospace-work-environment" },
        "base_commit": { "$ref": "#/$defs/sha1" },
        "head_commit": { "$ref": "#/$defs/sha1" },
        "head_tree": { "$ref": "#/$defs/sha1" },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "platform": { "enum": ["windows", "linux"] },
        "check_id": { "$ref": "#/$defs/id" },
        "phase_id": { "enum": ["graph-import-closure", "dependency-closure", "executor-pass-schema", "executor-damage", "selection-scenarios", "trust-self-executor", "trust-routing-contracts", "trust-proportional-mappings", "trust-damage-final"] },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os_description", "process_architecture", "powershell_version", "powershell_executable_sha256", "git_version", "git_executable_sha256"],
          "properties": {
            "os_description": { "type": "string", "minLength": 1, "maxLength": 512 },
            "process_architecture": { "enum": ["x64", "x86", "arm64", "arm"] },
            "powershell_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
            "powershell_executable_sha256": { "$ref": "#/$defs/sha256" },
            "git_version": { "type": "string", "pattern": "^git version [0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:\\.[A-Za-z0-9.-]+)?$" },
            "git_executable_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "dependency_manifest": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mode", "blob"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "mode": { "enum": ["100644", "100755"] },
              "blob": { "$ref": "#/$defs/sha1" }
            }
          }
        }
      }
    },
    "binding_sha256": { "$ref": "#/$defs/sha256" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "ended_at": { "$ref": "#/$defs/timestamp" },
    "budget_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "result": { "enum": ["pass", "code-fail", "infra-fail"] },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started", "exit_code", "timed_out", "post_kill_drain_timed_out", "stdout", "stderr"],
      "properties": {
        "started": { "type": "boolean" },
        "exit_code": { "type": ["integer", "null"] },
        "timed_out": { "type": "boolean" },
        "post_kill_drain_timed_out": { "type": "boolean" },
        "stdout": { "$ref": "#/$defs/stream" },
        "stderr": { "$ref": "#/$defs/stream" }
      }
    },
    "outputs": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/stream" }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_only", "candidate_admission", "acceptance_authority", "publication_authority", "device_used"],
      "properties": {
        "phase_only": { "const": true },
        "candidate_admission": { "const": false },
        "acceptance_authority": { "const": false },
        "publication_authority": { "const": false },
        "device_used": { "const": false }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*\\\\)(?!.*:)[^\\\\\u0000-\u001f\u007f]+$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "result": { "const": "pass" } } },
      "then": {
        "properties": {
          "child": {
            "properties": {
              "started": { "const": true },
              "exit_code": { "const": 0 },
              "timed_out": { "const": false },
              "post_kill_drain_timed_out": { "const": false }
            }
          }
        }
      }
    }
  ]
}
