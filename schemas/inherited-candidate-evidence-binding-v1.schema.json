{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/inherited-candidate-evidence-binding-v1.schema.json",
  "title": "Claim-time binding for sealed inherited-candidate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "binding_id", "project_id", "unit_id", "manifest", "archive", "patch", "file_inventory", "source", "materialization", "does_not_prove"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.inherited_candidate_evidence_binding.v1" },
    "binding_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "manifest": { "$ref": "#/$defs/evidence" },
    "archive": { "$ref": "#/$defs/evidence" },
    "patch": { "$ref": "#/$defs/evidence" },
    "file_inventory": { "$ref": "#/$defs/evidence" },
    "source": { "$ref": "#/$defs/source" },
    "materialization": {
      "type": "object", "additionalProperties": false,
      "required": ["destination_leaf", "archive_applied", "raw_patch_applied", "product_inputs_used"],
      "properties": {
        "destination_leaf": { "$ref": "#/$defs/id" },
        "archive_applied": { "const": true },
        "raw_patch_applied": { "const": false },
        "product_inputs_used": { "const": false }
      }
    },
    "does_not_prove": { "$ref": "#/$defs/nonClaims" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "taskPath": { "type": "string", "pattern": "^inherited-candidates/[a-z0-9][a-z0-9-]{1,127}/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "length"],
      "properties": { "path": { "$ref": "#/$defs/taskPath" }, "sha256": { "$ref": "#/$defs/hash" }, "length": { "type": "integer", "minimum": 1, "maximum": 67108864 } }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["base", "head", "cleanliness"],
      "properties": { "base": { "$ref": "#/$defs/revision" }, "head": { "$ref": "#/$defs/revision" }, "cleanliness": { "const": "clean" } }
    },
    "revision": {
      "type": "object", "additionalProperties": false, "required": ["commit", "tree"],
      "properties": { "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
    },
    "nonClaims": {
      "const": [
        "Does not make inherited bytes live product inputs.",
        "Does not authorize validation.",
        "Does not authorize acceptance."
      ]
    }
  }
}
