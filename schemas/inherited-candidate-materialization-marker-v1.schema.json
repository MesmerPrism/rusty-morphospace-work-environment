{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/inherited-candidate-materialization-marker-v1.schema.json",
  "title": "Post-Claim inherited-candidate reference-materialization marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "materialization_id", "project_id", "unit_id", "claim_event_id", "binding", "destination", "verification", "does_not_prove"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.inherited_candidate_materialization_marker.v1" },
    "materialization_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "claim_event_id": { "$ref": "#/$defs/id" },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["binding_id", "path", "sha256"],
      "properties": { "binding_id": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/taskPath" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "destination": {
      "type": "object", "additionalProperties": false,
      "required": ["root_kind", "leaf", "archive_applied", "raw_patch_applied", "product_inputs_used"],
      "properties": {
        "root_kind": { "const": "caller-provided-task-local" }, "leaf": { "$ref": "#/$defs/id" },
        "archive_applied": { "const": true }, "raw_patch_applied": { "const": false }, "product_inputs_used": { "const": false }
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_sha256", "archive_sha256", "patch_sha256", "inventory_sha256", "inventory_fingerprint_sha256", "file_count", "archive_file_modes_verified"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/hash" }, "archive_sha256": { "$ref": "#/$defs/hash" }, "patch_sha256": { "$ref": "#/$defs/hash" }, "inventory_sha256": { "$ref": "#/$defs/hash" }, "inventory_fingerprint_sha256": { "$ref": "#/$defs/hash" },
        "file_count": { "type": "integer", "minimum": 1, "maximum": 512 }, "archive_file_modes_verified": { "const": true }
      }
    },
    "does_not_prove": {
      "const": [
        "Does not make inherited bytes live product inputs.",
        "Does not authorize validation.",
        "Does not authorize acceptance."
      ]
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "taskPath": { "type": "string", "pattern": "^inherited-candidates/[a-z0-9][a-z0-9-]{1,127}/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" }
  }
}
