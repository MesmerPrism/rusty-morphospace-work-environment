{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/work-unit-automation-receipt-v2.schema.json",
  "title": "Additive work-unit automation action receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","project_id","unit_id","action","timestamp","executed","transition","status_before","status_after","current_unit_before","current_unit_after","preservation","audit_receipt","event_id"],
  "properties": {
    "schema": {"const":"rusty.morphospace.workflow.work_unit_automation_receipt.v2"},
    "project_id":{"$ref":"#/$defs/id"},"unit_id":{"$ref":"#/$defs/id"},
    "action":{"enum":["RetirePreparedPush","ReconcilePreparedPublication","ReconcilePreparedPushTransactionSuffix","ResolveBlocker","CorrectResolvedBlockerEvidence","CorrectHistoricalBlockerResolutionIntentBinding","CorrectCompletedTransitionSemantics","CorrectActiveReadOnlyDependencies","CorrectActiveProjectRepositoryScope","CorrectActiveUnitContract","AmendActiveWriteScope","NarrowValidationOnlyWriteScope","RecordHistoricalUnitCompatibilityProjection","RecordHistoricalSupersessionCompatibility","PrepareDevelopmentEnvelope","ReprepareRetiredDevelopmentEnvelope","PrepareBlockedSuccessor","SupersedeActive","AdmitDevelopmentUnit","RecoverAdmissionCompletionTimestamp","FreezeCandidate","RematerializeValidatingCandidate","MaterializeInheritedCandidate","ArchiveHistoryCheckpoint"]},
    "timestamp":{"type":"string","format":"date-time"},"executed":{"type":"boolean"},
    "transition":{"enum":["prepared-push-retired","prepared-publication-reconstructed","prepared-push-transaction-suffix-reconciled","blocker-resolved","blocker-resolution-corrected","historical-blocker-resolution-intent-binding-corrected","completed-transition-semantics-corrected","active-read-only-dependencies-corrected","active-project-repository-scope-corrected","active-unit-contract-corrected","active-write-scope-amended","validation-only-write-scope-narrowed","historical-unit-compatibility-projected","historical-supersession-compatibility-recorded","idle-project-envelope-prepared","retired-envelope-reprepared","blocked-successor-prepared","active-superseded-by-proposed-to-active","development-unit-admitted","development-unit-already-admitted","admission-completion-timestamp-recovered","candidate-frozen","candidate-already-frozen","validating-candidate-rematerialized","validating-candidate-already-rematerialized","inherited-candidate-materialized","inherited-candidate-already-materialized","history-archive-checkpointed"]},
    "status_before":{"oneOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"status_after":{"$ref":"#/$defs/id"},
    "current_unit_before":{"oneOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},
    "current_unit_after":{"oneOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},
    "preservation":{"type":"object","additionalProperties":false,"required":["git_mutation_performed","device_mutation_performed","remote_mutation_performed"],"properties":{"git_mutation_performed":{"const":false},"device_mutation_performed":{"const":false},"remote_mutation_performed":{"const":false}}},
    "audit_receipt":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"$ref":"#/$defs/path"},"sha256":{"$ref":"#/$defs/hash"}}},
    "event_id":{"oneOf":[{"$ref":"#/$defs/id"},{"type":"null"}]}
  },
  "allOf": [
    {
      "oneOf": [
      {"x-workflow-owner":{"producer":"scripts/PreparedPushRetirement.psm1","owner_test":"scripts/Test-WorkUnitAutomation.ps1"},"properties":{"action":{"const":"RetirePreparedPush"},"transition":{"const":"prepared-push-retired"},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/PreparedPublicationReconstruction.psm1","owner_test":"scripts/Test-PreparedPublicationReconstruction.ps1"},"properties":{"action":{"const":"ReconcilePreparedPublication"},"transition":{"const":"prepared-publication-reconstructed"},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/ReconcilePreparedPushTransactionSuffix.psm1","owner_test":"scripts/Test-PreparedPushTransactionSuffixReconciliation.ps1"},"properties":{"action":{"const":"ReconcilePreparedPushTransactionSuffix"},"transition":{"const":"prepared-push-transaction-suffix-reconciled"},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/ResolveBlocker.psm1","owner_test":"scripts/Test-ResolveBlocker.ps1"},"properties":{"action":{"const":"ResolveBlocker"},"transition":{"const":"blocker-resolved"},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/CorrectResolvedBlockerEvidence.psm1","owner_test":"scripts/Test-CorrectResolvedBlockerEvidence.ps1"},"properties":{"action":{"const":"CorrectResolvedBlockerEvidence"},"transition":{"const":"blocker-resolution-corrected"},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/CorrectHistoricalBlockerResolutionIntentBinding.psm1","owner_test":"scripts/Test-HistoricalBlockerResolutionIntentBindingCorrection.ps1"},"properties":{"action":{"const":"CorrectHistoricalBlockerResolutionIntentBinding"},"transition":{"const":"historical-blocker-resolution-intent-binding-corrected"},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/CompletedTransitionSemanticCorrection.psm1","owner_test":"scripts/Test-CompletedTransitionSemanticCorrection.ps1"},"properties":{"action":{"const":"CorrectCompletedTransitionSemantics"},"transition":{"const":"completed-transition-semantics-corrected"},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/CorrectActiveReadOnlyDependencies.psm1","owner_test":"scripts/Test-CorrectActiveReadOnlyDependencies.ps1"},"properties":{"action":{"const":"CorrectActiveReadOnlyDependencies"},"transition":{"const":"active-read-only-dependencies-corrected"},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/CorrectActiveProjectRepositoryScope.psm1","owner_test":"scripts/Test-CorrectActiveProjectRepositoryScope.ps1"},"properties":{"action":{"const":"CorrectActiveProjectRepositoryScope"},"transition":{"const":"active-project-repository-scope-corrected"},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/CorrectActiveUnitContract.psm1","owner_test":"scripts/Test-CorrectActiveUnitContract.ps1"},"properties":{"action":{"const":"CorrectActiveUnitContract"},"transition":{"const":"active-unit-contract-corrected"},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/ActiveWriteScopeAmendment.psm1","owner_test":"scripts/Test-ActiveWriteScopeAmendment.ps1"},"properties":{"action":{"const":"AmendActiveWriteScope"},"transition":{"const":"active-write-scope-amended"},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/ValidationOnlyWriteScopeNarrowing.psm1","owner_test":"scripts/Test-ValidationOnlyWriteScopeNarrowing.ps1"},"properties":{"action":{"const":"NarrowValidationOnlyWriteScope"},"transition":{"const":"validation-only-write-scope-narrowed"},"status_before":{"enum":["active","validating"]},"status_after":{"enum":["active","validating"]}}},
      {"x-workflow-owner":{"producer":"scripts/HistoricalUnitCompatibilityProjection.psm1","owner_test":"scripts/Test-HistoricalUnitCompatibilityProjection.ps1"},"properties":{"action":{"const":"RecordHistoricalUnitCompatibilityProjection"},"transition":{"const":"historical-unit-compatibility-projected"},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/HistoricalSupersessionCompatibility.psm1","owner_test":"scripts/Test-HistoricalSupersessionCompatibility.ps1"},"properties":{"action":{"const":"RecordHistoricalSupersessionCompatibility"},"transition":{"const":"historical-supersession-compatibility-recorded"},"status_before":{"enum":["active","validating"]},"status_after":{"enum":["active","validating"]},"current_unit_before":{"type":"null"},"current_unit_after":{"type":"null"}}},
      {"x-workflow-owner":{"producer":"scripts/DevelopmentEnvelopePreparation.psm1","owner_test":"scripts/Test-DevelopmentEnvelopePreparation.ps1"},"properties":{"action":{"const":"PrepareDevelopmentEnvelope"},"transition":{"const":"idle-project-envelope-prepared"},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/DevelopmentEnvelopeRepreparation.psm1","owner_test":"scripts/Test-DevelopmentUnitAdmission.ps1"},"properties":{"action":{"const":"ReprepareRetiredDevelopmentEnvelope"},"transition":{"const":"retired-envelope-reprepared"},"status_before":{"const":"superseded"},"status_after":{"const":"superseded"}}},
      {"x-workflow-owner":{"producer":"scripts/BlockedSuccessorPreparation.psm1","owner_test":"scripts/Test-BlockedSuccessorPreparation.ps1"},"properties":{"action":{"const":"PrepareBlockedSuccessor"},"transition":{"const":"blocked-successor-prepared"},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/ActiveUnitSupersession.psm1","owner_test":"scripts/Test-ActiveUnitSupersession.ps1"},"properties":{"action":{"const":"SupersedeActive"},"transition":{"const":"active-superseded-by-proposed-to-active"},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/DevelopmentUnitAdmission.psm1","owner_test":"scripts/Test-DevelopmentUnitAdmission.ps1"},"properties":{"action":{"const":"AdmitDevelopmentUnit"},"transition":{"enum":["development-unit-admitted","development-unit-already-admitted"]},"status_before":{"type":"null"}}},
      {"x-workflow-owner":{"producer":"scripts/AdmissionCompletionTimestampRecovery.psm1","owner_test":"scripts/Test-AdmissionCompletionTimestampRecovery.ps1"},"properties":{"action":{"const":"RecoverAdmissionCompletionTimestamp"},"transition":{"const":"admission-completion-timestamp-recovered"},"status_before":{"const":"proposed"},"status_after":{"const":"proposed"},"current_unit_before":{"type":"null"},"current_unit_after":{"type":"null"}}},
      {"x-workflow-owner":{"producer":"scripts/CandidateFreeze.psm1","owner_test":"scripts/Test-WorkUnitAutomation.ps1"},"properties":{"action":{"const":"FreezeCandidate"},"transition":{"enum":["candidate-frozen","candidate-already-frozen"]},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/ValidatingCandidateRematerialization.psm1","owner_test":"scripts/Test-ValidatingCandidateRematerialization.ps1"},"properties":{"action":{"const":"RematerializeValidatingCandidate"},"transition":{"enum":["validating-candidate-rematerialized","validating-candidate-already-rematerialized"]},"status_before":{"const":"validating"},"status_after":{"const":"validating"}}},
      {"x-workflow-owner":{"producer":"scripts/InheritedCandidateMaterialization.psm1","owner_test":"scripts/Test-WorkUnitAutomation.ps1"},"properties":{"action":{"const":"MaterializeInheritedCandidate"},"transition":{"enum":["inherited-candidate-materialized","inherited-candidate-already-materialized"]},"status_before":{"$ref":"#/$defs/id"}}},
      {"x-workflow-owner":{"producer":"scripts/lib/MorphospaceHistoryArchive.psm1","owner_test":"scripts/Test-HistoryArchiveCheckpoint.ps1"},"properties":{"action":{"const":"ArchiveHistoryCheckpoint"},"transition":{"const":"history-archive-checkpointed"},"status_before":{"$ref":"#/$defs/id"}}}
      ]
    },
    {
      "if": {"properties":{"executed":{"const":false}},"required":["executed"]},
      "then": {"properties":{"event_id":{"type":"null"}}}
    }
  ],
  "$defs":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{1,127}$"},"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"path":{"type":"string","pattern":"^(?:receipts/[a-z0-9][a-z0-9-]{1,127}\\.json|history-archive/checkpoints/[a-z0-9][a-z0-9-]{1,109}\\.json)$"}}
}
