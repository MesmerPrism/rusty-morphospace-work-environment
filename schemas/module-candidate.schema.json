{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/module-candidate.schema.json",
  "title": "Rusty Morphospace module candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "module_id",
    "source_project",
    "proposed_lane",
    "maturity",
    "problem",
    "neutral_contract",
    "owns",
    "does_not_own",
    "app_specific_exclusions",
    "dependencies",
    "provenance",
    "consumers",
    "evidence",
    "rollback",
    "promotion_target"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "rusty.morphospace.workflow.module_candidate.v1" },
    "candidate_id": { "$ref": "#/$defs/id" },
    "module_id": { "$ref": "#/$defs/id" },
    "source_project": { "type": "string", "minLength": 1 },
    "proposed_lane": { "$ref": "#/$defs/id" },
    "maturity": { "$ref": "#/$defs/id" },
    "problem": { "type": "string", "minLength": 1 },
    "neutral_contract": { "$ref": "#/$defs/dottedId" },
    "owns": { "$ref": "#/$defs/nonEmptyStrings" },
    "does_not_own": { "$ref": "#/$defs/nonEmptyStrings" },
    "app_specific_exclusions": { "$ref": "#/$defs/nonEmptyStrings" },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "license", "lesson", "rejected_overreach"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "lesson": { "type": "string", "minLength": 1 },
          "rejected_overreach": { "type": "string", "minLength": 1 }
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consumer_id", "kind", "contract_only", "evidence"],
        "properties": {
          "consumer_id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["originating-app", "independent-app", "conformance-harness"] },
          "contract_only": { "type": "boolean" },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": { "$ref": "#/$defs/nonEmptyStrings" },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "acceptance"],
      "properties": {
        "strategy": { "type": "string", "minLength": 1 },
        "acceptance": { "type": "string", "minLength": 1 }
      }
    },
    "promotion_target": { "$ref": "#/$defs/id" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
    },
    "dottedId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{2,127}$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
