{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/event-transaction-intent.schema.json",
  "title": "Durable event append intent",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "transaction_id", "created_at", "timestamp", "project_id", "unit_id", "run_id", "session_id", "anchor", "pre_event_log_sha256", "pre_event_log_length", "event_line_sha256", "event", "status"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.event_transaction_intent.v1" }, "transaction_id": { "$ref": "#/$defs/id" },
    "created_at": { "$ref": "#/$defs/utc" }, "timestamp": { "$ref": "#/$defs/utc" }, "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" }, "run_id": { "$ref": "#/$defs/id" }, "session_id": { "oneOf": [{ "$ref": "#/$defs/session" }, { "type": "null" }] },
    "anchor": { "allOf": [{ "$ref": "#/$defs/reference" }, { "properties": { "role": { "const": "legacy-prefix-anchor" }, "schema": { "const": "rusty.morphospace.workflow.legacy_event_prefix_anchor.v1" } } }] }, "pre_event_log_sha256": { "$ref": "#/$defs/hash" }, "pre_event_log_length": { "type": "integer", "minimum": 1 },
    "event_line_sha256": { "$ref": "#/$defs/hash" }, "event": { "$ref": "iteration-event-v2.schema.json" }, "status": { "const": "prepared" }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,191}$" }, "session": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,95}$" }, "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" }, "reference": { "type": "object", "additionalProperties": false, "required": ["role", "path", "schema", "sha256"], "properties": { "role": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 1 }, "schema": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,191}$" }, "sha256": { "$ref": "#/$defs/hash" } } } }
}
