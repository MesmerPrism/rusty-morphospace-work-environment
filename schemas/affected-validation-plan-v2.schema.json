{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/affected-validation-plan-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "base", "head", "base_registry", "head_registry", "registry_delta", "changed_paths", "changed_paths_sha256", "requested_tier", "effective_tier", "selection_mode", "execution_permitted", "mapping_diagnostics", "reason_codes", "selected_checks", "skipped_checks", "budget", "plan_sha256", "claims"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.affected_validation_plan.v2" },
    "repository": { "type": "string", "minLength": 1 },
    "base": { "$ref": "#/$defs/gitIdentity" },
    "head": { "$ref": "#/$defs/gitIdentity" },
    "base_registry": { "$ref": "#/$defs/fileIdentity" },
    "head_registry": { "$ref": "#/$defs/fileIdentity" },
    "registry_delta": { "$ref": "#/$defs/registryDelta" },
    "changed_paths": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/change" } },
    "changed_paths_sha256": { "$ref": "#/$defs/hash" },
    "requested_tier": { "$ref": "#/$defs/tier" },
    "effective_tier": { "$ref": "#/$defs/tier" },
    "selection_mode": { "enum": ["affected", "full-deep", "mapping-incomplete"] },
    "execution_permitted": { "type": "boolean" },
    "mapping_diagnostics": { "type": "array", "maxItems": 8192, "uniqueItems": true, "items": { "$ref": "#/$defs/mappingDiagnostic" } },
    "reason_codes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "selected_checks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/checkSelection" } },
    "skipped_checks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/checkSelection" } },
    "budget": { "type": "object", "additionalProperties": false, "required": ["actual"], "properties": { "actual": { "type": "integer", "minimum": 0 } } },
    "plan_sha256": { "$ref": "#/$defs/hash" },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["selection_only", "checks_executed", "acceptance_authority", "publication_authority"],
      "properties": {
        "selection_only": { "const": true },
        "checks_executed": { "const": false },
        "acceptance_authority": { "const": false },
        "publication_authority": { "const": false }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "selection_mode": { "const": "mapping-incomplete" } }, "required": ["selection_mode"] }, "then": { "properties": { "execution_permitted": { "const": false }, "selected_checks": { "maxItems": 0 }, "mapping_diagnostics": { "minItems": 1 }, "budget": { "properties": { "actual": { "const": 0 } } } } } },
    { "if": { "properties": { "selection_mode": { "enum": ["affected", "full-deep"] } }, "required": ["selection_mode"] }, "then": { "properties": { "execution_permitted": { "const": true }, "mapping_diagnostics": { "maxItems": 0 } } } },
    { "if": { "properties": { "registry_delta": { "properties": { "classification": { "const": "unchanged" } }, "required": ["classification"] } }, "required": ["registry_delta"] }, "then": { "properties": { "registry_delta": { "properties": { "candidate_ownership_audited": { "const": false } } } } } },
    { "if": { "properties": { "registry_delta": { "properties": { "classification": { "enum": ["revision-only", "coverage-expanding", "structural"] } }, "required": ["classification"] } }, "required": ["registry_delta"] }, "then": { "properties": { "registry_delta": { "properties": { "candidate_ownership_audited": { "const": true } } } } } }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$" },
    "tier": { "enum": ["quick", "standard", "deep"] },
    "gitIdentity": { "type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": { "commit": { "$ref": "#/$defs/commit" }, "tree": { "$ref": "#/$defs/commit" } } },
    "fileIdentity": { "type": "object", "additionalProperties": false, "required": ["schema", "registry_id", "revision", "blob", "sha256"], "properties": { "schema": { "const": "rusty.morphospace.workflow.affected_validation_registry.v1" }, "registry_id": { "$ref": "#/$defs/id" }, "revision": { "type": "integer", "minimum": 1 }, "blob": { "$ref": "#/$defs/commit" }, "sha256": { "$ref": "#/$defs/hash" } } },
    "registryDelta": { "type": "object", "additionalProperties": false, "required": ["schema", "classification", "candidate_ownership_audited", "added_patterns", "added_trigger_references", "added_consume_references"], "properties": { "schema": { "const": "rusty.morphospace.workflow.affected_validation_registry_delta.v1" }, "classification": { "enum": ["unchanged", "revision-only", "coverage-expanding", "structural"] }, "candidate_ownership_audited": { "type": "boolean" }, "added_patterns": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/pathSetPattern" } }, "added_trigger_references": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/checkPathSetReference" } }, "added_consume_references": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/checkPathSetReference" } } } },
    "pathSetPattern": { "type": "object", "additionalProperties": false, "required": ["path_set_id", "pattern"], "properties": { "path_set_id": { "$ref": "#/$defs/id" }, "pattern": { "$ref": "#/$defs/path" } } },
    "checkPathSetReference": { "type": "object", "additionalProperties": false, "required": ["check_id", "path_set_id"], "properties": { "check_id": { "$ref": "#/$defs/id" }, "path_set_id": { "$ref": "#/$defs/id" } } },
    "mappingDiagnostic": { "type": "object", "additionalProperties": false, "required": ["path", "side", "issue_kind", "matching_path_set_ids"], "properties": { "path": { "$ref": "#/$defs/path" }, "side": { "enum": ["old", "new"] }, "issue_kind": { "enum": ["unmapped", "ambiguous", "missing-base-check-obligation"] }, "matching_path_set_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } },
    "change": { "type": "object", "additionalProperties": false, "required": ["status", "old_path", "new_path", "old_mode", "new_mode", "old_blob", "new_blob"], "properties": { "status": { "type": "string", "pattern": "^(?:[ADMT]|[RC](?:[0-9]{1,2}|100))$" }, "old_path": { "anyOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] }, "new_path": { "anyOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] }, "old_mode": { "anyOf": [{ "$ref": "#/$defs/mode" }, { "type": "null" }] }, "new_mode": { "anyOf": [{ "$ref": "#/$defs/mode" }, { "type": "null" }] }, "old_blob": { "anyOf": [{ "$ref": "#/$defs/commit" }, { "type": "null" }] }, "new_blob": { "anyOf": [{ "$ref": "#/$defs/commit" }, { "type": "null" }] } }, "allOf": [{ "if": { "properties": { "status": { "pattern": "^A" } } }, "then": { "properties": { "old_path": { "type": "null" }, "old_mode": { "type": "null" }, "old_blob": { "type": "null" }, "new_path": { "$ref": "#/$defs/path" }, "new_mode": { "$ref": "#/$defs/mode" }, "new_blob": { "$ref": "#/$defs/commit" } } } }, { "if": { "properties": { "status": { "pattern": "^D" } } }, "then": { "properties": { "new_path": { "type": "null" }, "new_mode": { "type": "null" }, "new_blob": { "type": "null" }, "old_path": { "$ref": "#/$defs/path" }, "old_mode": { "$ref": "#/$defs/mode" }, "old_blob": { "$ref": "#/$defs/commit" } } } }, { "if": { "properties": { "status": { "pattern": "^[CMRT]" } } }, "then": { "properties": { "old_path": { "$ref": "#/$defs/path" }, "old_mode": { "$ref": "#/$defs/mode" }, "old_blob": { "$ref": "#/$defs/commit" }, "new_path": { "$ref": "#/$defs/path" }, "new_mode": { "$ref": "#/$defs/mode" }, "new_blob": { "$ref": "#/$defs/commit" } } } }] },
    "checkSelection": { "type": "object", "additionalProperties": false, "required": ["check_id", "platforms", "minimum_tier", "reasons", "budget_seconds", "cache_policy"], "properties": { "check_id": { "$ref": "#/$defs/id" }, "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["windows", "linux"] } }, "minimum_tier": { "$ref": "#/$defs/tier" }, "reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "budget_seconds": { "type": "integer", "minimum": 1 }, "cache_policy": { "enum": ["disabled", "exact-host", "portable"] } } },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!\\s*$)(?!/)(?!.*\\/$)(?!.*//)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^\\\\:\\u0000-\\u001f\\u007f]+$" },
    "mode": { "enum": ["100644", "100755", "120000", "160000"] }
  }
}
