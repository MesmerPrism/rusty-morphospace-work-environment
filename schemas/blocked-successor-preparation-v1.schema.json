{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/blocked-successor-preparation-v1.schema.json",
  "title": "Preparation of one bounded successor to a terminal blocked unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "preparation_id", "project_id", "successor_unit_id", "terminal", "repair", "source_repository_ids", "expected", "does_not_prove"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.blocked_successor_preparation.v1" },
    "preparation_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "successor_unit_id": { "$ref": "#/$defs/id" },
    "terminal": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_id", "unit_path", "unit_raw_sha256", "unit_canonical_sha256", "candidate_freeze", "selector_binding_sha256", "checkpoint", "blocker_sha256", "event_id", "event_sha256", "transaction"],
      "properties": {
        "unit_id": { "$ref": "#/$defs/id" }, "unit_path": { "$ref": "#/$defs/path" },
        "unit_raw_sha256": { "$ref": "#/$defs/hash" }, "unit_canonical_sha256": { "$ref": "#/$defs/hash" },
        "candidate_freeze": { "type": "object", "additionalProperties": false, "required": ["freeze_id", "receipt_path", "receipt_sha256"], "properties": { "freeze_id": { "$ref": "#/$defs/id" }, "receipt_path": { "$ref": "#/$defs/path" }, "receipt_sha256": { "$ref": "#/$defs/hash" } } },
        "selector_binding_sha256": { "$ref": "#/$defs/hash" },
        "checkpoint": { "type": "object", "additionalProperties": false, "required": ["tier", "result", "receipt_path", "receipt_sha256"], "properties": { "tier": { "const": "standard" }, "result": { "enum": ["partial", "fail", "blocked"] }, "receipt_path": { "$ref": "#/$defs/path" }, "receipt_sha256": { "$ref": "#/$defs/hash" } } },
        "blocker_sha256": { "$ref": "#/$defs/hash" }, "event_id": { "$ref": "#/$defs/id" }, "event_sha256": { "$ref": "#/$defs/hash" },
        "transaction": { "type": "object", "additionalProperties": false, "required": ["transaction_id", "intent_path", "intent_sha256", "completion_path", "completion_sha256"], "properties": { "transaction_id": { "$ref": "#/$defs/id" }, "intent_path": { "$ref": "#/$defs/path" }, "intent_sha256": { "$ref": "#/$defs/hash" }, "completion_path": { "$ref": "#/$defs/path" }, "completion_sha256": { "$ref": "#/$defs/hash" } } }
      }
    },
    "repair": { "type": "object", "additionalProperties": false, "required": ["repo_id", "path", "evidence_artifact_id"], "properties": { "repo_id": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/path" }, "evidence_artifact_id": { "$ref": "#/$defs/id" } } },
    "source_repository_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": ["project_sha256", "state_sha256", "feature_lock_sha256", "repository_map_path", "repository_map_sha256", "events_sha256", "events_length", "event_tail_id"],
      "properties": {
        "project_sha256": { "$ref": "#/$defs/hash" }, "state_sha256": { "$ref": "#/$defs/hash" }, "feature_lock_sha256": { "$ref": "#/$defs/hash" },
        "repository_map_path": { "$ref": "#/$defs/path" }, "repository_map_sha256": { "$ref": "#/$defs/hash" },
        "events_sha256": { "$ref": "#/$defs/hash" }, "events_length": { "type": "integer", "minimum": 1 }, "event_tail_id": { "$ref": "#/$defs/id" }
      }
    },
    "does_not_prove": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" }
  }
}
