{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/state-transition-intent.schema.json",
  "title": "Deterministic current-unit state transition intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "transaction_id", "created_at", "project_id", "unit_id", "action",
    "validation_receipt", "current_protocol", "event_anchor", "pre", "target",
    "allowed_outputs", "status"
  ],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.state_transition_intent.v1" },
    "transaction_id": { "$ref": "#/$defs/id" },
    "created_at": { "$ref": "#/$defs/utc" },
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "$ref": "#/$defs/id" },
    "action": { "enum": ["Validate", "Accept"] },
    "validation_receipt": { "$ref": "#/$defs/validationReceiptReference" },
    "current_protocol": { "$ref": "#/$defs/currentProtocolReference" },
    "event_anchor": { "$ref": "#/$defs/eventAnchorReference" },
    "pre": { "$ref": "#/$defs/preState" },
    "target": { "$ref": "#/$defs/targetState" },
    "allowed_outputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "status": { "const": "prepared" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,191}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "validationReceiptReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "const": "validation-receipt" }, "path": { "type": "string", "minLength": 1 }, "schema": { "const": "rusty.morphospace.workflow.validation_receipt.v2" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "currentProtocolReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "const": "current-unit-protocol" }, "path": { "type": "string", "minLength": 1 }, "schema": { "const": "rusty.morphospace.workflow.current_unit_protocol.v1" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "eventAnchorReference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "schema", "sha256"],
      "properties": { "role": { "const": "legacy-prefix-anchor" }, "path": { "type": "string", "minLength": 1 }, "schema": { "const": "rusty.morphospace.workflow.legacy_event_prefix_anchor.v1" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "eventTail": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "sequence", "sha256"],
      "properties": { "event_id": { "$ref": "#/$defs/id" }, "sequence": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "preState": {
      "type": "object", "additionalProperties": false,
      "required": ["state_path", "state_sha256", "unit_path", "unit_sha256", "event_tail"],
      "properties": {
        "state_path": { "type": "string", "minLength": 1 },
        "state_sha256": { "$ref": "#/$defs/hash" },
        "unit_path": { "type": "string", "minLength": 1 },
        "unit_sha256": { "$ref": "#/$defs/hash" },
        "event_tail": { "$ref": "#/$defs/eventTail" }
      }
    },
    "targetState": {
      "type": "object", "additionalProperties": false,
      "required": ["state_sha256", "unit_sha256", "event"],
      "properties": {
        "state_sha256": { "$ref": "#/$defs/hash" },
        "unit_sha256": { "$ref": "#/$defs/hash" },
        "event": { "$ref": "iteration-event-v2.schema.json" }
      }
    }
  }
}
