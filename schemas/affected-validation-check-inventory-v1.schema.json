{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/affected-validation-check-inventory-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "producer", "source", "plan_sha256", "platform", "entries", "claims"],
  "properties": {
    "schema": { "const": "rusty.morphospace.workflow.affected_validation_check_inventory.v1" },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["context", "execution_id", "repository", "event_name", "pull_request_number", "run_id", "run_attempt", "workflow_path", "job"],
      "properties": {
        "context": { "enum": ["github-actions", "local"] },
        "execution_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "repository": { "const": "MesmerPrism/rusty-morphospace-work-environment" },
        "event_name": { "enum": ["pull_request", "push", "schedule", "workflow_dispatch", "local"] },
        "pull_request_number": { "type": "integer", "minimum": 0 },
        "run_id": { "type": "string", "pattern": "^(?:local|[1-9][0-9]*)$" },
        "run_attempt": { "type": "integer", "minimum": 0 },
        "workflow_path": { "enum": [".github/workflows/validate.yml", "local"] },
        "job": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "source": { "type": "object", "additionalProperties": false, "required": ["base", "head"], "properties": { "base": { "$ref": "#/$defs/gitIdentity" }, "head": { "$ref": "#/$defs/gitIdentity" } } },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "platform": { "enum": ["windows", "linux"] },
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["check_id", "binding_sha256", "mode", "result", "receipt", "stdout", "stderr", "artifacts"],
        "properties": {
          "check_id": { "$ref": "#/$defs/id" }, "binding_sha256": { "$ref": "#/$defs/sha256" },
          "mode": { "enum": ["executed", "reused", "blocked"] }, "result": { "enum": ["pass", "code-fail", "infra-fail", "blocked"] },
          "receipt": { "$ref": "#/$defs/file" }, "stdout": { "$ref": "#/$defs/file" }, "stderr": { "$ref": "#/$defs/file" },
          "artifacts": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/artifactFile" } }
        }
      }
    },
    "claims": { "type": "object", "additionalProperties": false, "required": ["cache_transport_only", "candidate_admission", "acceptance_authority", "publication_authority"], "properties": { "cache_transport_only": { "const": true }, "candidate_admission": { "const": false }, "acceptance_authority": { "const": false }, "publication_authority": { "const": false } } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*\\\\)(?!.*:)[^\\\\\u0000-\u001f\u007f]+$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitIdentity": { "type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": { "commit": { "$ref": "#/$defs/sha1" }, "tree": { "$ref": "#/$defs/sha1" } } },
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "bytes": { "type": "integer", "minimum": 0, "maximum": 10485760 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "artifactFile": {
      "type": "object", "additionalProperties": false,
      "required": ["phase_path", "path", "bytes", "sha256"],
      "properties": {
        "phase_path": { "$ref": "#/$defs/path" }, "path": { "$ref": "#/$defs/path" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 134217728 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "phase_path": { "pattern": "^[a-z0-9][a-z0-9-]{1,95}\\.(?:start|terminal)\\.json$" } }, "required": ["phase_path"] },
          "else": { "properties": { "bytes": { "maximum": 10485760 } } }
        }
      ]
    }
  }
}
