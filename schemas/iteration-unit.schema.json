{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/iteration-unit.schema.json",
  "title": "Rusty Morphospace iteration unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "unit_id",
    "project_id",
    "status",
    "objective",
    "change_categories",
    "instruction_impact",
    "instruction_surfaces",
    "instruction_none_justification",
    "prerequisites",
    "allowed_repositories",
    "non_scope",
    "acceptance",
    "risk_tier",
    "device_requirement",
    "validation",
    "outputs",
    "commit_policy",
    "push_checkpoint"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "rusty.morphospace.workflow.iteration_unit.v1" },
    "unit_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "status": { "$ref": "#/$defs/id" },
    "objective": { "type": "string", "minLength": 1 },
    "work_mode": { "enum": ["feature", "validation-only"] },
    "guard_profile": { "enum": ["fast", "labs", "locked"] },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "change_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "implementation",
          "authority",
          "module-layout",
          "feature-activation",
          "validation",
          "device-policy",
          "repo-routing",
          "public-private-boundary",
          "workflow-automation",
          "state-machine",
          "validation-routing",
          "recovery",
          "documentation-only"
        ]
      }
    },
    "instruction_impact": { "enum": ["none", "review", "update"] },
    "instruction_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface_kind",
          "path",
          "owner",
          "change_reason",
          "action",
          "status",
          "validation",
          "skill_id"
        ],
        "properties": {
          "surface_kind": { "enum": ["agents", "readme", "router-doc", "validation-doc", "skill"] },
          "path": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "change_reason": { "type": "string", "minLength": 1 },
          "action": { "enum": ["update", "review-no-change"] },
          "status": { "enum": ["planned", "complete"] },
          "validation": { "type": "string", "minLength": 1 },
          "skill_id": {
            "oneOf": [
              { "$ref": "#/$defs/id" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "instruction_none_justification": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "allowed_repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo_id", "allowed_paths"],
        "properties": {
          "repo_id": { "$ref": "#/$defs/id" },
          "allowed_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "read_only_dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo_id", "paths", "purpose", "verification"],
        "properties": {
          "repo_id": { "$ref": "#/$defs/id" },
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "purpose": { "type": "string", "minLength": 1 },
          "verification": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "lock_path", "materialization_receipt"],
      "properties": {
        "mode": {
          "enum": ["observed-working-copies", "exact-lock", "exact-materialization"]
        },
        "lock_path": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "materialization_receipt": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "observed-working-copies" } } },
          "then": {
            "properties": {
              "lock_path": { "type": "null" },
              "materialization_receipt": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "exact-lock" } } },
          "then": {
            "properties": {
              "lock_path": { "type": "string", "minLength": 1 },
              "materialization_receipt": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "exact-materialization" } } },
          "then": {
            "properties": {
              "lock_path": { "type": "string", "minLength": 1 },
              "materialization_receipt": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "resource_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_kind", "resource_id", "mode", "claim_timing"],
        "properties": {
          "resource_kind": {
            "enum": ["repo-path", "build-output", "android-package", "headset", "property-namespace", "staging-namespace", "bridge-port"]
          },
          "resource_id": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["exclusive", "shared-read"] },
          "claim_timing": { "enum": ["none", "before-write", "before-run"] }
        }
      }
    },
    "claim_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_free_disk_mib", "required_tools", "product_inputs"],
      "properties": {
        "minimum_free_disk_mib": { "type": "integer", "minimum": 0 },
        "required_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool_id", "executable", "purpose"],
            "properties": {
              "tool_id": { "$ref": "#/$defs/id" },
              "executable": { "type": "string", "pattern": "^[A-Za-z0-9_.+-]{1,128}$" },
              "purpose": { "type": "string", "minLength": 1 }
            }
          }
        },
        "product_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_id", "repo_id", "path", "kind", "expected_sha256"],
            "properties": {
              "input_id": { "$ref": "#/$defs/id" },
              "repo_id": { "$ref": "#/$defs/id" },
              "path": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["file", "directory"] },
              "expected_sha256": {
                "oneOf": [
                  { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        "execution_preflight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observation", "assertions"],
          "properties": {
            "observation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repo_id", "path", "expected_sha256"],
              "properties": {
                "repo_id": { "$ref": "#/$defs/id" },
                "path": { "type": "string", "minLength": 1 },
                "expected_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            },
            "assertions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["assertion_id", "kind", "key", "expected"],
                "properties": {
                  "assertion_id": { "$ref": "#/$defs/id" },
                  "kind": { "enum": ["value-equals", "capability-present"] },
                  "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{1,127}$" },
                  "expected": {
                    "oneOf": [
                      { "type": "string", "minLength": 1 },
                      { "type": "null" }
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": { "properties": { "kind": { "const": "value-equals" } }, "required": ["kind"] },
                    "then": { "properties": { "expected": { "type": "string", "minLength": 1 } } },
                    "else": { "properties": { "expected": { "type": "null" } } }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "non_scope": { "$ref": "#/$defs/nonEmptyStrings" },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptance_id", "proof", "command"],
        "properties": {
          "acceptance_id": { "$ref": "#/$defs/id" },
          "proof": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 }
        }
      }
    },
    "risk_tier": { "enum": ["quick", "standard", "deep"] },
    "device_requirement": { "enum": ["forbidden", "none", "optional", "required"] },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "command"],
        "properties": {
          "profile_id": { "$ref": "#/$defs/id" },
          "command": { "type": "string", "minLength": 1 }
        }
      }
    },
    "outputs": { "$ref": "#/$defs/nonEmptyStrings" },
    "commit_policy": { "type": "string", "minLength": 1 },
    "push_checkpoint": { "enum": ["none", "local-only", "integration-batch", "release"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "instruction_impact": { "const": "none" } },
        "required": ["instruction_impact"]
      },
      "then": {
        "properties": {
          "instruction_surfaces": { "maxItems": 0 },
          "instruction_none_justification": { "type": "string", "minLength": 1 }
        }
      },
      "else": {
        "properties": {
          "instruction_surfaces": { "minItems": 1 },
          "instruction_none_justification": { "type": "null" }
        }
      }
    },
    {
      "if": { "required": ["work_mode"] },
      "then": { "required": ["claim_requirements"] }
    },
    {
      "if": {
        "properties": { "work_mode": { "const": "validation-only" } },
        "required": ["work_mode"]
      },
      "then": {
        "properties": {
          "change_categories": {
            "minItems": 1,
            "maxItems": 1,
            "items": { "const": "validation" }
          },
          "instruction_impact": { "const": "review" },
          "instruction_surfaces": {
            "minItems": 1,
            "items": {
              "properties": { "action": { "const": "review-no-change" } }
            }
          },
          "allowed_repositories": {
            "items": {
              "properties": {
                "allowed_paths": {
                  "items": { "type": "string", "pattern": "^morphospace(?:/|$)" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
