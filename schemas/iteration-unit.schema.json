{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-morphospace-work-environment/schemas/iteration-unit.schema.json",
  "title": "Rusty Morphospace iteration unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "unit_id",
    "project_id",
    "status",
    "objective",
    "change_categories",
    "instruction_impact",
    "instruction_surfaces",
    "instruction_none_justification",
    "prerequisites",
    "allowed_repositories",
    "non_scope",
    "acceptance",
    "risk_tier",
    "device_requirement",
    "validation",
    "outputs",
    "commit_policy",
    "push_checkpoint"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "rusty.morphospace.workflow.iteration_unit.v1" },
    "unit_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "status": { "$ref": "#/$defs/id" },
    "objective": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "change_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "implementation",
          "authority",
          "module-layout",
          "feature-activation",
          "validation",
          "device-policy",
          "repo-routing",
          "public-private-boundary",
          "workflow-automation",
          "state-machine",
          "validation-routing",
          "recovery",
          "documentation-only"
        ]
      }
    },
    "instruction_impact": { "enum": ["none", "review", "update"] },
    "instruction_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface_kind",
          "path",
          "owner",
          "change_reason",
          "action",
          "status",
          "validation",
          "skill_id"
        ],
        "properties": {
          "surface_kind": { "enum": ["agents", "readme", "router-doc", "skill"] },
          "path": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "change_reason": { "type": "string", "minLength": 1 },
          "action": { "enum": ["update", "review-no-change"] },
          "status": { "enum": ["planned", "complete"] },
          "validation": { "type": "string", "minLength": 1 },
          "skill_id": {
            "oneOf": [
              { "$ref": "#/$defs/id" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "instruction_none_justification": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "allowed_repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo_id", "allowed_paths"],
        "properties": {
          "repo_id": { "$ref": "#/$defs/id" },
          "allowed_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "non_scope": { "$ref": "#/$defs/nonEmptyStrings" },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptance_id", "proof", "command"],
        "properties": {
          "acceptance_id": { "$ref": "#/$defs/id" },
          "proof": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 }
        }
      }
    },
    "risk_tier": { "enum": ["quick", "standard", "deep"] },
    "device_requirement": { "enum": ["forbidden", "none", "optional", "required"] },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "command"],
        "properties": {
          "profile_id": { "$ref": "#/$defs/id" },
          "command": { "type": "string", "minLength": 1 }
        }
      }
    },
    "outputs": { "$ref": "#/$defs/nonEmptyStrings" },
    "commit_policy": { "type": "string", "minLength": 1 },
    "push_checkpoint": { "enum": ["none", "local-only", "integration-batch", "release"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "instruction_impact": { "const": "none" } },
        "required": ["instruction_impact"]
      },
      "then": {
        "properties": {
          "instruction_surfaces": { "maxItems": 0 },
          "instruction_none_justification": { "type": "string", "minLength": 1 }
        }
      },
      "else": {
        "properties": {
          "instruction_surfaces": { "minItems": 1 },
          "instruction_none_justification": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
