        if(-not$Map.ContainsKey([string]$id)){throw "Repreparation source repository '$id' is unmapped."};$entry=$Map[[string]$id];$root=[IO.Path]::GetFullPath([string]$entry.path);if(-not[IO.Directory]::Exists($root)){throw "Repreparation mapped repository '$id' is unavailable."}
        $commit=(Get-RepreparationGitScalar $root @('rev-parse','HEAD') 'commit' '^[0-9a-fA-F]{40}$').ToLowerInvariant();$tree=(Get-RepreparationGitScalar $root @('rev-parse','HEAD^{tree}') 'tree' '^[0-9a-fA-F]{40}$').ToLowerInvariant();$branch=Get-RepreparationGitScalar $root @('rev-parse','--abbrev-ref','HEAD') 'branch' '^(?!HEAD$)[^\x00-\x20~^:?*\\]+(?:/[^\x00-\x20~^:?*\\]+)*$'
