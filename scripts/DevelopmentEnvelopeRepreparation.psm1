        $leaf=Split-Path -Leaf $root;if(-not$leaves.Add($leaf)){throw 'Repreparation source composition repeats a materialization leaf.'};$records.Add([pscustomobject][ordered]@{repo_id=[string]$id;role=[string]$entry.role;commit=$commit;tree=$tree;branch=$branch;materialization_path=$leaf;worktree_state=$(if($dirt.Count){'workflow-owned-dirt'}else{'clean'});workflow_owned_dirt=@($dirt.ToArray())})|Out-Null
    }
