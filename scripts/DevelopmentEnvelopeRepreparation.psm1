function Get-RepreparationLedgerObservation {
    param([string]$Path,[object]$Expected)
    [byte[]]$all=[IO.File]::ReadAllBytes($Path);$length=[int64]$Expected.events_length
    if($all.LongLength-lt$length){throw 'Repreparation event ledger truncated its authenticated prefix.'}
    [byte[]]$prefix=[byte[]]::new([int]$length);if($length){[Array]::Copy($all,0,$prefix,0,[int]$length)}
    if((Get-RepreparationBytesHash $prefix)-cne[string]$Expected.events_sha256){throw 'Repreparation event ledger replaced its authenticated prefix.'}
    [byte[]]$suffix=[byte[]]::new([int]($all.LongLength-$length));if($suffix.Length){[Array]::Copy($all,[int]$length,$suffix,0,$suffix.Length)}
    try{$text=[Text.UTF8Encoding]::new($false,$true).GetString($prefix)}catch{throw 'Repreparation event ledger prefix is not strict UTF-8.'}
    if(-not$text.EndsWith("`n",[StringComparison]::Ordinal)){throw 'Repreparation event ledger prefix does not end at a record boundary.'}
    $events=@($text.Split("`n",[StringSplitOptions]::None)|Select-Object -SkipLast 1|ForEach-Object{if(-not$_){throw 'Repreparation event ledger prefix contains a blank record.'};ConvertFrom-MorphospaceProtocolJsonBytes ([Text.UTF8Encoding]::new($false,$true).GetBytes($_)) 'repreparation ledger prefix'})
    if($events.Count-lt1-or[string]$events[-1].event_id-cne[string]$Expected.event_tail_id){throw 'Repreparation event ledger prefix tail differs from its authenticated identity.'}
    [pscustomobject]@{all=$all;prefix=$prefix;suffix=$suffix;events=$events}
}
function Assert-RepreparationLedgerObservation {
    param([object]$Observation,[object]$Event)
    [byte[]]$eventBytes=[Text.UTF8Encoding]::new($false,$true).GetBytes((ConvertTo-MorphospaceCanonicalJson $Event)+"`n")
    if($Observation.suffix.Length-ne0-and((Get-RepreparationBytesHash $Observation.suffix)-cne(Get-RepreparationBytesHash $eventBytes)-or$Observation.suffix.Length-ne$eventBytes.Length)){throw 'Repreparation ledger suffix is not the exact intended event bytes.'}
    [pscustomobject]@{event_bytes=$eventBytes;appended=($Observation.suffix.Length-ne0)}
