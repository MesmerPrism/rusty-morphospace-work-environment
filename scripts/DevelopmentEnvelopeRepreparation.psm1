Set-StrictMode -Version 2.0
$ErrorActionPreference='Stop'
$script:RepreparationProtocolModule=Import-Module (Join-Path $PSScriptRoot 'lib\MorphospaceProtocolCommon.psm1') -PassThru
$script:RepreparationTransitionLedgerModule=Import-Module (Join-Path $PSScriptRoot 'lib\MorphospaceTransitionLedger.psm1') -PassThru
$script:RepreparationPreparationModule=Import-Module (Join-Path $PSScriptRoot 'DevelopmentEnvelopePreparation.psm1') -PassThru
$script:RepreparationGitInvoker={param([string]$Root,[string[]]$Arguments)$output=@(& git -C $Root @Arguments 2>&1);[pscustomobject]@{exit_code=$LASTEXITCODE;output=$output}}

function Get-RepreparationHash { param([object]$Value) Get-MorphospaceCanonicalJsonSha256 $Value }
function Get-RepreparationFileHash { param([string]$Path) Get-MorphospaceFileSha256 $Path }
function Copy-RepreparationValue { param([object]$Value) $Value|ConvertTo-Json -Depth 64|ConvertFrom-Json -DateKind String }
function Get-RepreparationPath { param([string]$Root,[string]$Relative) Resolve-MorphospaceWorkspacePath $Root $Relative }
function Get-RepreparationLocalSchema {
    param([string]$Root,[string]$Name)
    $path=[IO.Path]::GetFullPath((Join-Path $Root "schemas\$Name"));$schema=Get-Content -Raw -LiteralPath $path|ConvertFrom-Json -Depth 100
    if($schema.PSObject.Properties.Name-contains'$id'){$schema.'$id'=([Uri]$path).AbsoluteUri}
    $schema|ConvertTo-Json -Depth 100
}
function Assert-RepreparationSchema { param([string]$Root,[string]$Path,[string]$Name,[string]$Message) if(-not(Test-Json -Json (Get-Content -Raw -LiteralPath $Path) -Schema (Get-RepreparationLocalSchema $Root $Name))){throw $Message} }
function Assert-RepreparationObjectSchema { param([string]$Root,[object]$Value,[string]$Name,[string]$Message) if(-not(Test-Json -Json ($Value|ConvertTo-Json -Depth 64) -Schema (Get-RepreparationLocalSchema $Root $Name))){throw $Message} }
function Assert-RepreparationTransitionLedgerEvidence {
    param([string]$Workspace,[string]$IntentRelative,[string]$IntentAbsolute,[string]$CompletionRelative,[string]$CompletionAbsolute)
    $intent=Read-MorphospaceProtocolJson $IntentAbsolute;$transactionId=[string]$intent.transaction_id
    &$script:RepreparationTransitionLedgerModule {param($workspaceValue,$transactionValue,$intentRelativeValue,$intentAbsoluteValue,$intentValue,$completionAbsoluteValue)Assert-MorphospaceLedgerIntent $intentValue $transactionValue;Assert-MorphospaceLedgerCommittedCompletion $workspaceValue $transactionValue $intentRelativeValue $intentAbsoluteValue $intentValue $completionAbsoluteValue} $Workspace $transactionId $IntentRelative $IntentAbsolute $intent $CompletionAbsolute
}
function Get-RepreparationArtifact { param([string]$Path,[object]$Value) [pscustomobject][ordered]@{path=$Path;sha256=(Get-RepreparationHash $Value);bytes_base64=[Convert]::ToBase64String([Text.UTF8Encoding]::new($false).GetBytes(($Value|ConvertTo-Json -Depth 64)))} }
function Assert-RepreparationFileBinding { param([string]$Workspace,[object]$Binding,[string]$Name) $path=Get-RepreparationPath $Workspace ([string]$Binding.path);if(-not[IO.File]::Exists($path)-or(Get-RepreparationFileHash $path)-cne[string]$Binding.sha256){throw "Repreparation $Name bytes do not match the supplied evidence."};$path }
function Get-RepreparationEventProjection {
    param([object]$Event)
    [pscustomobject][ordered]@{schema=[string]$Event.schema;event_id=[string]$Event.event_id;sequence=[int]$Event.sequence;timestamp=[string]$Event.timestamp;project_id=[string]$Event.project_id;unit_id=$(if($null-eq$Event.unit_id){$null}else{[string]$Event.unit_id});event_type=[string]$Event.event_type;summary=[string]$Event.summary;receipts=@($Event.receipts|ForEach-Object{[string]$_})}
}
function Test-RepreparationOwnedDirtPath {
    param([string]$Path)
    $p=$Path.Replace('\','/')
    return $p-cmatch '^(project\.spec\.json|feature\.lock\.json|workspace\.state\.json|iteration-events\.jsonl|repository-map\.json)$' -or
        $p-cmatch '^iteration-units/[a-z0-9][a-z0-9-]{1,127}\.json$' -or
        $p-cmatch '^receipts/(?:transactions/)?[a-z0-9][a-z0-9.-]{1,191}\.json$' -or
        $p-cmatch '^source-composition/[A-Za-z0-9._-]+\.json$'
}
function Invoke-RepreparationGitRead {
    param([string]$Root,[string[]]$Arguments,[string]$Name)
    $result=&$script:RepreparationGitInvoker $Root $Arguments
    if($null-eq$result-or[int]$result.exit_code-ne0){throw "Repreparation repository Git $Name readback failed."}
    @($result.output|ForEach-Object{[string]$_})
}
function Get-RepreparationGitScalar {
    param([string]$Root,[string[]]$Arguments,[string]$Name,[string]$Pattern)
    $rows=@(Invoke-RepreparationGitRead $Root $Arguments $Name)
    if($rows.Count-ne1){throw "Repreparation repository Git $Name readback has an invalid stdout shape."}
    $value=$rows[0].Trim();if(-not$value-or($Pattern-and$value-cnotmatch$Pattern)){throw "Repreparation repository Git $Name readback has an invalid value."};$value
}
function Get-RepreparationSourceComposition {
    param([object]$Recovery,[hashtable]$Map,[AllowNull()][object]$OriginalSource)
    $allowed=@{};foreach($row in @($Recovery.allowed_workflow_dirt)){$key=([string]$row.repo_id)+'|'+([string]$row.path);if($allowed.ContainsKey($key)){throw 'Repreparation repeats an allowed workflow-dirt identity.'};if(-not(Test-RepreparationOwnedDirtPath ([string]$row.path))){throw "Repreparation workflow dirt '$([string]$row.path)' is outside the closed workflow-owned surface."};$allowed[$key]=$row}
