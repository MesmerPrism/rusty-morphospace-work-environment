    $allowed=@{};foreach($row in @($Recovery.allowed_workflow_dirt)){$key=([string]$row.repo_id)+'|'+([string]$row.path);if($allowed.ContainsKey($key)){throw 'Repreparation repeats an allowed workflow-dirt identity.'};if(-not(Test-RepreparationOwnedDirtPath ([string]$row.path))){throw "Repreparation workflow dirt '$([string]$row.path)' is outside the closed workflow-owned surface."};$allowed[$key]=$row}
    $transactionSet=[Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal);foreach($path in @($TransactionPaths)){[void]$transactionSet.Add([string]$path)}
    $observed=@{};$records=[Collections.Generic.List[object]]::new();$leaves=[Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
    foreach($id in @($Recovery.envelope.source_composition.repository_ids|Sort-Object -Unique)){
        if(-not$Map.ContainsKey([string]$id)){throw "Repreparation source repository '$id' is unmapped."};$entry=$Map[[string]$id];$root=[IO.Path]::GetFullPath([string]$entry.path);if(-not[IO.Directory]::Exists($root)){throw "Repreparation mapped repository '$id' is unavailable."}
        $workspacePrefix=if([string]$entry.role-ceq'planning'){Get-RepreparationWorkspacePrefix $Workspace $root}else{$null}
        $commit=(Get-RepreparationGitScalar $root @('rev-parse','HEAD') 'commit' '^[0-9a-fA-F]{40}$').ToLowerInvariant();$tree=(Get-RepreparationGitScalar $root @('rev-parse','HEAD^{tree}') 'tree' '^[0-9a-fA-F]{40}$').ToLowerInvariant();$branchValue=Get-RepreparationGitScalar $root @('rev-parse','--abbrev-ref','HEAD') 'branch' '^(?:HEAD|[^\x00-\x20~^:?*\\]+(?:/[^\x00-\x20~^:?*\\]+)*)$';$branch=if($branchValue-ceq'HEAD'){$null}else{$branchValue}
        $dirt=[Collections.Generic.List[object]]::new();$statusRows=@(Invoke-RepreparationGitRead $root @('status','--porcelain=v1','--untracked-files=all') 'status');foreach($lineValue in $statusRows){$line=[string]$lineValue;if($line.Length-lt4-or$line.Contains(' -> ') -or $line.Substring(3).StartsWith('"')){throw "Repreparation repository '$id' has unsupported dirt."};$status=$line.Substring(0,2);$gitPath=$line.Substring(3).Replace('\','/');if([string]$entry.role-cne'planning'){throw "Repreparation repository '$id' has unenumerated dirt '$gitPath'."};if($workspacePrefix-and-not$gitPath.StartsWith($workspacePrefix,[StringComparison]::Ordinal)){throw "Repreparation planning dirt '$gitPath' is outside exact workspace prefix '$workspacePrefix'."};$path=if($workspacePrefix){$gitPath.Substring($workspacePrefix.Length)}else{$gitPath};if(-not$path-or-not(Test-RepreparationOwnedDirtPath $path)){throw "Repreparation planning dirt '$gitPath' is outside the closed workspace-owned surface."};$key="$id|$path";$isTransaction=$transactionSet.Contains($path);if($Resume-and$isTransaction){if($allowed.ContainsKey($key)-and-not$observed.ContainsKey($key)){$expected=$allowed[$key];$observed[$key]=$true;$dirt.Add([pscustomobject][ordered]@{path=$path;status=[string]$expected.status;sha256=[string]$expected.sha256})|Out-Null};continue};if(-not$allowed.ContainsKey($key)){throw "Repreparation repository '$id' has unenumerated dirt '$gitPath'."};$full=[IO.Path]::GetFullPath((Join-Path $root $gitPath));if(-not[IO.File]::Exists($full)){throw "Repreparation workflow dirt '$id/$gitPath' is not a present regular file."};$hash=Get-RepreparationFileHash $full;$expected=$allowed[$key];if([string]$expected.status-cne$status-or[string]$expected.sha256-cne$hash){throw "Repreparation workflow dirt '$id/$gitPath' differs from its exact status/hash allowance."};$observed[$key]=$true;$dirt.Add([pscustomobject][ordered]@{path=$path;status=$status;sha256=$hash})|Out-Null}
        if($Resume){foreach($key in @($allowed.Keys|Where-Object{$_ -clike "$id|*"})){$relative=$key.Substring($id.Length+1);if($transactionSet.Contains($relative)-and-not$observed.ContainsKey($key)){$expected=$allowed[$key];$observed[$key]=$true;$dirt.Add([pscustomobject][ordered]@{path=$relative;status=[string]$expected.status;sha256=[string]$expected.sha256})|Out-Null}}}
        $leaf=Split-Path -Leaf $root;if(-not$leaves.Add($leaf)){throw 'Repreparation source composition repeats a materialization leaf.'};$records.Add([pscustomobject][ordered]@{repo_id=[string]$id;role=[string]$entry.role;commit=$commit;tree=$tree;branch=$branch;materialization_path=$leaf;workspace_prefix=$workspacePrefix;worktree_state=$(if($dirt.Count){'workflow-owned-dirt'}else{'clean'});workflow_owned_dirt=@($dirt.ToArray())})|Out-Null
    }
    foreach($key in $allowed.Keys){if(-not$observed.ContainsKey($key)){throw "Repreparation allowed workflow dirt '$key' is not present exactly."}}
    if($null-ne$OriginalSource){$old=@{};foreach($row in @($OriginalSource.repositories)){$id=[string]$row.repo_id;if($old.ContainsKey($id)){throw "Repreparation original source lock repeats '$id'."};$old[$id]=$row};if($old.Count-ne$records.Count){throw 'Repreparation repository set drifted from the original source lock.'};foreach($row in @($records.ToArray())){$id=[string]$row.repo_id;if(-not$old.ContainsKey($id)){throw "Repreparation repository '$id' is absent from the original source lock."};$prior=$old[$id];foreach($field in @('role','commit','tree','branch','materialization_path')){if([string]$row.$field-cne[string]$prior.$field){throw "Repreparation repository '$id' $field drifted from the original source lock."}}}}
    $identity=[pscustomobject][ordered]@{project_id=$Recovery.project_id;preparation_id=$Recovery.preparation_id;repositories=@($records.ToArray())};$fingerprint=Get-RepreparationHash $identity
    [pscustomobject][ordered]@{schema='rusty.morphospace.workflow.development_envelope_source_composition.v2';lock_id="$($Recovery.preparation_id)-source-$($fingerprint.Substring(0,12))";preparation_id=$Recovery.preparation_id;project_id=$Recovery.project_id;fingerprint=$fingerprint;repositories=@($records.ToArray());status='locked';does_not_prove=@('Does not grant Ready, Claim, source mutation, device, remote, or publication authority.')}
