function Invoke-MorphospaceUpgradeToolingContext {
 [CmdletBinding()]param([Parameter(Mandatory)][string]$WorkspaceRoot,[Parameter(Mandatory)][string]$UnitId,[Parameter(Mandatory)][string]$ToolingContextUpgrade,[Parameter(Mandatory)][string]$OutPath,[string]$ExpectedToolingContextUpgradeSha256='',[string]$Timestamp='',[ValidateSet('none','after-intent','after-artifact','after-projection','after-event')][string]$FaultAfter='none',[switch]$Execute)
 $workspace=[IO.Path]::GetFullPath((Resolve-Path -LiteralPath $WorkspaceRoot -ErrorAction Stop).Path);$input=[IO.Path]::GetFullPath((Resolve-Path -LiteralPath $ToolingContextUpgrade -ErrorAction Stop).Path);$request=Read-MorphospaceProtocolJson $input;Test-ToolingUpgradeJson $request 'tooling-context-upgrade-v1.schema.json' 'Tooling-context upgrade request violates its owner schema.';$requestHash=Get-MorphospaceFileSha256 $input
 if([string]$request.unit_id-cne$UnitId){throw 'Tooling-context upgrade request unit differs from UnitId.'};if($ExpectedToolingContextUpgradeSha256-and$ExpectedToolingContextUpgradeSha256-cne$requestHash){throw 'ExpectedToolingContextUpgradeSha256 differs from the request bytes.'};if($Execute-and-not$ExpectedToolingContextUpgradeSha256){throw 'Executed UpgradeToolingContext requires its reviewed request SHA-256.'}
 $out=[IO.Path]::GetFullPath($OutPath);$prefix=$workspace+[IO.Path]::DirectorySeparatorChar;if(-not$out.StartsWith($prefix,[StringComparison]::OrdinalIgnoreCase)){throw 'Tooling-context upgrade output must stay inside the workspace.'};$outRelative=$out.Substring($prefix.Length).Replace('\','/');$expectedOut="receipts/$([string]$request.upgrade_id)-tooling-context-upgrade-request.json";if($outRelative-cne$expectedOut-or$out-ceq$input){throw "Tooling-context upgrade output must be '$expectedOut'."}
 $eventId="$([string]$request.upgrade_id)-tooling-context-upgraded";$transactionId="$eventId-transition";$intentPath=Resolve-MorphospaceWorkspacePath $workspace "receipts/transactions/$transactionId.intent.json";$completionPath=Resolve-MorphospaceWorkspacePath $workspace "receipts/transactions/$transactionId.completion.json"
 if([IO.File]::Exists($completionPath)-and-not[IO.File]::Exists($intentPath)){throw 'Tooling-context upgrade completion exists without intent.'}
