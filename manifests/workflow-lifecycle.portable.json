{
  "schema": "rusty.morphospace.work_environment.workflow_lifecycle.v1",
  "module_maturity": [
    {
      "id": "app-local",
      "next": ["candidate", "deprecated"],
      "required_evidence": ["app tests", "non-reuse statement"]
    },
    {
      "id": "candidate",
      "next": ["contract-ready", "deprecated"],
      "required_evidence": ["candidate record", "proposed lane", "provenance"]
    },
    {
      "id": "contract-ready",
      "next": ["adapter-ready", "deprecated"],
      "required_evidence": ["versioned contract", "valid fixture", "damaged fixture"]
    },
    {
      "id": "adapter-ready",
      "next": ["cross-consumer-validated", "deprecated"],
      "required_evidence": ["adapter boundary", "dependency check", "effective receipt"]
    },
    {
      "id": "cross-consumer-validated",
      "next": ["stable", "deprecated"],
      "required_evidence": ["independent consumer or conformance harness"]
    },
    {
      "id": "stable",
      "next": ["deprecated"],
      "required_evidence": ["accepted promotion review"]
    },
    {
      "id": "deprecated",
      "next": [],
      "required_evidence": ["migration or retirement path"]
    }
  ],
  "iteration_states": [
    { "id": "proposed", "next": ["ready", "superseded"] },
    { "id": "ready", "next": ["active", "blocked", "superseded"] },
    { "id": "active", "next": ["validating", "blocked", "superseded"] },
    { "id": "validating", "next": ["accepted", "active", "blocked", "superseded"] },
    { "id": "accepted", "next": [] },
    { "id": "blocked", "next": ["ready", "active", "superseded"] },
    { "id": "superseded", "next": [] }
  ],
  "promotion_gates": [
    "authority",
    "contract",
    "dependency",
    "public-boundary",
    "conformance",
    "negative-fixture",
    "second-consumer",
    "instruction-sync",
    "rollback"
  ],
  "risk_tiers": ["quick", "standard", "deep"],
  "guard_profiles": [
    {
      "id": "fast",
      "purpose": "Bounded product iteration, including declared cross-repository and device stages, with local or integration checkpoints and independently selected validation depth.",
      "minimum_for": ["implementation", "validation", "documentation-only"]
    },
    {
      "id": "labs",
      "purpose": "Cross-repository, device, composition, and product-authority work that is not a release or workflow trust-root change.",
      "minimum_for": ["authority", "module-layout", "feature-activation", "device-policy", "repo-routing"]
    },
    {
      "id": "locked",
      "purpose": "Release preparation and workflow, recovery, publication-boundary, or validation-authority changes.",
      "minimum_for": ["public-private-boundary", "workflow-automation", "state-machine", "validation-routing", "recovery", "release"]
    }
  ],
  "work_modes": ["feature", "validation-only"],
  "workflow_stability": {
    "feature_units_before_protocol_change": 3,
    "target_feature_work_percent": 70,
    "validation_only_instruction_action": "review-no-change",
    "unit_captain_through_acceptance": true
  },
  "device_requirements": ["forbidden", "none", "optional", "required"],
  "push_checkpoints": ["none", "local-only", "integration-batch", "release"],
  "change_categories": [
    "implementation",
    "authority",
    "module-layout",
    "feature-activation",
    "validation",
    "device-policy",
    "repo-routing",
    "public-private-boundary",
    "workflow-automation",
    "state-machine",
    "validation-routing",
    "recovery",
    "documentation-only"
  ],
  "change_category_aliases": [
    {"alias":"production-runtime","canonical":"implementation"},
    {"alias":"public-api","canonical":"implementation"},
    {"alias":"module-composition","canonical":"module-layout"},
    {"alias":"instruction-synchronization","canonical":"workflow-automation"},
    {"alias":"reliability","canonical":"validation"}
  ],
  "instruction_sync": {
    "impact_values": ["none", "review", "update"],
    "surface_kinds": ["agents", "readme", "router-doc", "validation-doc", "skill"],
    "trigger_categories": [
      "authority",
      "module-layout",
      "feature-activation",
      "validation",
      "device-policy",
      "repo-routing",
      "public-private-boundary",
      "workflow-automation",
      "state-machine",
      "validation-routing",
      "recovery"
    ],
    "required_surface_groups": ["agents", "readme-or-router", "skill"],
    "skill_routing": [
      {
        "change_category": "authority",
        "skill_ids": ["rusty-morphospace", "system-engineering"]
      },
      {
        "change_category": "module-layout",
        "skill_ids": ["rusty-morphospace", "system-engineering", "rust-work-graph"]
      },
      {
        "change_category": "feature-activation",
        "skill_ids": ["rusty-morphospace", "system-engineering"]
      },
      {
        "change_category": "validation",
        "skill_ids": ["rusty-morphospace", "system-engineering"]
      },
      {
        "change_category": "device-policy",
        "skill_ids": ["rusty-morphospace", "meta-quest-workflow"]
      },
      {
        "change_category": "repo-routing",
        "skill_ids": ["rusty-morphospace", "rust-work-graph"]
      },
      {
        "change_category": "public-private-boundary",
        "skill_ids": ["rusty-morphospace", "system-engineering"]
      },
      {
        "change_category": "workflow-automation",
        "skill_ids": ["rusty-morphospace", "system-engineering", "rust-work-graph"]
      },
      {
        "change_category": "state-machine",
        "skill_ids": ["rusty-morphospace", "system-engineering"]
      },
      {
        "change_category": "validation-routing",
        "skill_ids": ["rusty-morphospace", "system-engineering"]
      },
      {
        "change_category": "recovery",
        "skill_ids": ["rusty-morphospace", "system-engineering"]
      }
    ],
    "acceptance_invariant": "Triggered units require complete updates to the nearest AGENTS, a README or router document, and every routed skill before acceptance."
  },
  "feature_activation": {
    "default": "disabled",
    "unlisted_modules": "inert",
    "protocol_v2_rule": "selected-lock-and-runtime-input",
    "descriptor_effects": [
      "permissions", "services", "activities", "queries", "tools", "assets",
      "shaders", "native libraries", "commands", "routes", "streams", "inputs",
      "scenes", "markers"
    ],
    "enabled_requires": [
      "requester",
      "descriptor",
      "dependencies",
      "conflicts",
      "permissions",
      "routes",
      "assets",
      "parameter authorities",
      "effective-runtime receipt"
    ]
  },
  "invariants": [
    "At most one iteration unit is active or validating.",
    "Guard profile and validation risk tier are independent: guard profile controls change authority while risk tier controls evidence depth.",
    "Explicit fast units may span their declared repositories and device stages; product-authority changes require labs or locked guard, while releases and workflow trust-root changes require locked guard.",
    "A validating feature unit may return directly to active only through a typed action that validates and retains the non-passing attempt receipt.",
    "Every mutable parameter has one authority owner.",
    "Unlisted modules and features are inert.",
    "Stable modules pass every promotion gate.",
    "Stable modules have an independent consumer or conformance harness.",
    "Iteration units cannot expand project repository or path authority; an active feature unit may add only already project-authorized write paths through the typed additive amendment transaction.",
    "Instruction-triggering units cannot be accepted with incomplete AGENTS, README or router, or relevant skill updates.",
    "Workflow automation inspects or prepares by default, requires explicit execution for state mutation, and never owns Git push or device mutation.",
    "Validation recording and acceptance require a typed, hashed, exact-scope receipt that is revalidated against current state.",
    "Feature selection never activates a run without the current lock fingerprint and a descriptor-approved runtime input.",
    "A prepared push plan never proves external execution; executed pushes require remote readback, ancestry, validation, and rollback evidence."
  ]
}
